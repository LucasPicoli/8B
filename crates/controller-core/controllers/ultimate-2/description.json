  "settings": [
    {
      "id": "sticks",
      "label": "Sticks",
      "lead": "Inside the low end of the dead zone the stick reads as centred. Past the high end it reads as pushed all the way.",
      "frames": [
        {
          "title": "Left stick",
          "sliders": [
            {
              "label": "Dead zone",
              "unit": "%",
              "macro_stick": "left_stick",
              "low": {
                "field": "/sticks/left_min_pct",
                "min": 0,
                "max": 90
              },
              "high": {
                "field": "/sticks/left_max_pct",
                "min": 10,
                "max": 100
              }
            }
          ],
          "flags": [
            {
              "label": "Invert X",
              "field": "/sticks/invert_left_x"
            },
            {
              "label": "Invert Y",
              "field": "/sticks/invert_left_y"
            }
          ]
        },
        {
          "title": "Right stick",
          "sliders": [
            {
              "label": "Dead zone",
              "unit": "%",
              "macro_stick": "right_stick",
              "low": {
                "field": "/sticks/right_min_pct",
                "min": 0,
                "max": 90
              },
              "high": {
                "field": "/sticks/right_max_pct",
                "min": 10,
                "max": 100
              }
            }
          ],
          "flags": [
            {
              "label": "Invert X",
              "field": "/sticks/invert_right_x"
            },
            {
              "label": "Invert Y",
              "field": "/sticks/invert_right_y"
            }
          ]
        },
        {
          "title": "Swaps",
          "flags": [
            {
              "label": "Swap the left and right sticks",
              "field": "/sticks/swap_sticks"
            },
            {
              "label": "Swap the D-pad and the left stick",
              "field": "/sticks/swap_dpad_with_left_stick",
              "excludes": [
                "/sticks/swap_sticks",
                "/sticks/invert_left_x",
                "/sticks/invert_left_y"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "triggers",
      "label": "Triggers",
      "modes": [
        "xinput",
        "dinput"
      ],
      "lead": "Below the range the trigger reads as released. Above it, as pulled all the way.",
