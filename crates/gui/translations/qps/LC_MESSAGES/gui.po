#: ../../packaging/linux/io.github.LucasPicoli._8B.desktop
#: ../../packaging/linux/io.github.LucasPicoli._8B.metainfo.xml
msgid "8B"
msgstr "⟦~8B⟧"

#: ../../packaging/linux/io.github.LucasPicoli._8B.desktop
#: ../../packaging/linux/io.github.LucasPicoli._8B.metainfo.xml
msgid "Read and edit your 8BitDo controller profiles"
msgstr "⟦~~~~~~~~~~~~~~~~~~Read and edit your 8BitDo controller profiles⟧"

#: ../../packaging/linux/io.github.LucasPicoli._8B.metainfo.xml
msgid ""
"8B reads and edits the profiles stored on your 8BitDo controller, over USB. "
"On the Pro 3 it edits button mappings, sticks, triggers and vibration "
"settings in every slot of the XInput, Switch and DInput modes, creates and "
"edits macros, and imports and exports profiles as JSON."
msgstr ""
"⟦~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~8B "
"reads and edits the profiles stored on your 8BitDo controller, over USB. On "
"the Pro 3 it edits button mappings, sticks, triggers and vibration settings "
"in every slot of the XInput, Switch and DInput modes, creates and edits "
"macros, and imports and exports profiles as JSON.⟧"

#: ../../packaging/linux/io.github.LucasPicoli._8B.metainfo.xml
msgid "8B is an independent project, not made or endorsed by 8BitDo."
msgstr ""
"⟦~~~~~~~~~~~~~~~~~~~~~~~~~8B is an independent project, not made or endorsed "
"by 8BitDo.⟧"

#: ../../packaging/linux/io.github.LucasPicoli._8B.metainfo.xml
msgid "Editing a DInput profile: saved remaps in blue, unsaved edits in orange"
msgstr ""
"⟦~~~~~~~~~~~~~~~~~~~~~~~~~~~~~Editing a DInput profile: saved remaps in "
"blue, unsaved edits in orange⟧"

#: ../../packaging/linux/io.github.LucasPicoli._8B.metainfo.xml
msgid ""
"Editing a macro: the step table, with a step's stick and trigger values below"
msgstr ""
"⟦~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~Editing a macro: the step table, with a "
"step's stick and trigger values below⟧"

#: ../../packaging/linux/io.github.LucasPicoli._8B.metainfo.xml
msgid ""
"8B now runs in Brazilian Portuguese. It follows the system language, and the "
"Language menu picks another one."
msgstr ""
"⟦~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~8B now runs in Brazilian "
"Portuguese. It follows the system language, and the Language menu picks "
"another one.⟧"

