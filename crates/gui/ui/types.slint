// The data the markup gets from Rust. Every model-specific fact (modes, slots,
// buttons, outputs, art) arrives here, so the markup names no controller model.

export struct Slot {
    mode: int,
    number: int,
    name: string,
    empty: bool,
    macros: int,
    unsaved: bool,
}

export struct ModeGroup {
    name: string,
    current: bool,
    slots: [Slot],
}

export struct Section {
    name: string,
    unsaved: bool,
    // The controller would refuse something in it: the error icon stands for the dot.
    error: bool,
    // Shown as a count badge when above zero (Macros).
    count: int,
}

// One button's row in the mapping table.
export struct MapRow {
    label: string,
    // What a screen reader says for the label.
    spoken: string,
    // The outputs the picker offers, and the one in use.
    outputs: [string],
    // What a screen reader says for each output.
    spoken-outputs: [string],
    output: int,
    // Cannot be remapped: no picker.
    fixed: bool,
    // Its output differs from the default profile's, as the tint on the drawing.
    remapped: bool,
    // The controller holds an output 8B does not recognise.
    unknown: bool,
    // How to use the output on the pad, or a warning about leaving the one the
    // controller holds. Empty for none.
    hint: string,
    // Differs from what the controller holds: not written yet.
    changed: bool,
}

// One drawing of the controller, recoloured for the theme.
export struct PadView {
    image: image,
    // The caption over the view, such as "Front".
    label: string,
    // The viewBox size.
    width: float,
    height: float,
}

// One button's shape in a view, in the view's viewBox units.
export struct Spot {
    // Index of the button's row in the mapping table.
    row: int,
    // Index of its view.
    view: int,
    commands: string,
    // Its output differs from the default profile's: the shape is tinted.
    mapped: bool,
    // Its output differs from what the controller holds: the tint is orange.
    pending: bool,
    fixed: bool,
    // The output's label, shown beside the shape on hover or selection.
    output: string,
    // The shape's bounding box.
    x0: float,
    y0: float,
    x1: float,
    y1: float,
}

export struct Change {
    what: string,
    from: string,
    to: string,
}

// One slider on the Sticks, Triggers or Vibration tab.
export struct Setting {
    label: string,
    // JSON pointers into the profile: the value, or the low end of a range.
    low-field: string,
    // The high end of a range, "" for a single value.
    high-field: string,
    low: float,
    high: float,
    // The ends of the groove.
    minimum: float,
    maximum: float,
    // The value as shown, such as "10 to 100%".
    text: string,
    // What the controller holds, such as "0 to 100%". "" when the same.
    was: string,
}

// One check box on a settings tab.
export struct Toggle {
    label: string,
    // JSON pointer into the profile.
    field: string,
    on: bool,
    // Differs from what the controller holds: not written yet.
    changed: bool,
}

export struct SettingFrame {
    title: string,
    settings: [Setting],
    toggles: [Toggle],
}

// The Sticks, Triggers or Vibration tab.
export struct SettingsPage {
    lead: string,
    frames: [SettingFrame],
    // What the controller's firmware hides of the tab. Empty for nothing.
    note: string,
}

// The warning before importing a file made for another mode.
// A macro file picked for a macro slot, shown before it joins the edits.
export struct MacroImportInfo {
    shown: bool,
    // Each reason the file cannot be imported, or none when it can.
    errors: [string],
    file-name: string,
    // The macro slot, 1-based.
    number: int,
    name: string,
    from-mode: string,
    to-mode: string,
    steps: int,
    // The buttons that start it here, such as "PR and PL", or "" for none.
    buttons: string,
    // The sentence that names the macro it replaces, such as "It replaces “Dash”.", or "".
    replaces: string,
    // The macro it replaces has edits not yet written.
    replaces-unsaved: bool,
    // Letters that name another button in the slot's mode, or "".
    letters: string,
    // Steps whose trigger press becomes full.
    full-presses: int,
    // Trigger glides the slot's mode cannot play, such as "ZL in step 3", or "".
    glides: string,
    // Each button the macro is imported without, with why, as a sentence.
    dropped: [string],
}

export struct ImportWarning {
    shown: bool,
    slot-title: string,
    file-name: string,
    from-mode: string,
    to-mode: string,
    // Buttons whose output the target mode lacks: they become Disabled.
    lost: [Change],
    // The settings groups the target mode sets another way, such as "triggers", so
    // they start from its defaults. "" when none.
    reset: string,
    // Letters that name another button in the target mode, or empty.
    letters: string,
    // Which macros the file's replace, each named, or "" for a file with no `macros`.
    macro-lead: string,
    // One sentence each about the file's macros: what they lose here, or that the
    // macro files it names are skipped.
    macro-notes: [string],
    // What Import without macros keeps, and each button it takes off a macro, or "".
    keep-note: string,
    // One sentence per kind of unwritten edit the import discards.
    edit-notes: [string],
}

// The review before a write.
export struct ReviewInfo {
    shown: bool,
    slot-title: string,
    // The name of the edits, and of the profile they replace.
    name: string,
    replaces: string,
    // The controller holds nothing in the slot.
    is-new: bool,
    // Only the macros change: the profile the controller holds stays.
    keeps-profile: bool,
    // The changes plus the macros the edits add, change or remove.
    total: int,
    changes: [Change],
    // Macros that stay, "<name> (Macro 1) changed: starts with A to B" lines, and
    // macros an empty slot still holds that the write replaces.
    macros-stay: int,
    macro-changes: [string],
    leftover: int,
    // The profile and macro sections show their lines.
    profile-open: bool,
    macros-open: bool,
    // Why the profile cannot be written as it is, empty when nothing stops it.
    problem: string,
}

// The question before clearing a slot.
export struct ClearInfo {
    shown: bool,
    slot-title: string,
    name: string,
    macros: int,
    // The slot holds edits that clearing throws away.
    has-edits: bool,
}

// A write that failed.
export struct FailedInfo {
    shown: bool,
    slot-title: string,
    detail: string,
    // The file the old profile was saved in, or empty.
    backup-path: string,
    // The files the old macros were saved in.
    macro-backups: [string],
    is-clear: bool,
}

// One slot of a batch write: its row in the review, or in the progress list.
export struct BatchSlot {
    title: string,
    // The name of the edits.
    name: string,
    changes: [Change],
    // The controller holds nothing in the slot.
    is-new: bool,
    // "<name> (Macro 1) changed: starts with A to B" lines, and macros an empty slot
    // still holds that the write replaces.
    macro-changes: [string],
    leftover: int,
    // The review shows the row's changes.
    open: bool,
}

// The write of every edited slot: which dialog shows, and what is in it.
export struct BatchInfo {
    // 0 none, 1 review, 2 writing, 3 failed.
    stage: int,
    slots: [BatchSlot],
    // The slot being written, or the one that failed (0-based).
    at: int,
    total-changes: int,
    any-new: bool,
    // Why the write failed, the file the old profile was saved in, or empty, and the
    // files the old macros were saved in.
    detail: string,
    backup-path: string,
    macro-backups: [string],
}

// One edited slot in the close question.
export struct CloseSlot {
    // Such as "XInput slot 2".
    title: string,
    // The name of the edits.
    name: string,
}

// One controller's edited slots in the close question.
export struct CloseGroup {
    // The header label, such as "Pro 3 · XInput".
    label: string,
    slots: [CloseSlot],
}

// The question before closing the window over unsaved edits.
export struct CloseInfo {
    shown: bool,
    // Edited slots on every controller.
    total: int,
    // The slots "Write n slots…" writes, or 0 when it is hidden.
    write: int,
    groups: [CloseGroup],
}

// One macro slot of the selected slot on the Macros tab: its row in the list, and
// the header of its macro.
export struct MacroRow {
    // 1-based.
    number: int,
    // A macro is in the macro slot.
    filled: bool,
    name: string,
    steps: int,
    // The labels of the buttons that start it, the first of them for the list row,
    // and how many more the row leaves out.
    buttons: [string],
    first-buttons: [string],
    more: int,
    // Differs from what the controller holds: not written yet.
    unsaved: bool,
    // 0 once, 1 a number of times, 2 until pressed again.
    plays: int,
    count: int,
    // Interval between plays in milliseconds.
    pause: int,
    // "Add a button…", then each button that can join the macro.
    addable: [string],
    // The validator's reasons, one line each, when the controller would refuse the macro, and
    // whether it is the step count.
    error: string,
    steps-invalid: bool,
    // A stick it moves sits under the dead zone floor, so the move may not play.
    warned: bool,
}

// A macro the controller would refuse, which turns a write button off: what to say, and
// where "Show" leads. Empty text when nothing is refused.
export struct Blocked {
    text: string,
    // The sidebar's mode and slot indexes, and the macro slot (0-based).
    mode: int,
    slot: int,
    macro-slot: int,
}

// One button's shape on the Macros tab's controller views, in viewBox units.
export struct MacroSpot {
    // Index of the button in the description.
    row: int,
    view: int,
    commands: string,
    // Its chip in the step panel's "Buttons held", or -1 for a button a step cannot hold.
    chip: int,
    // Its label in the mode, for the tips.
    label: string,
    // What a screen reader says for it.
    spoken: string,
    x0: float,
    y0: float,
    x1: float,
    y1: float,
}

// One button's cell in a step row: a bar while the button is held. A bar that meets a
// held cell above or below runs into it, so a hold reads as one bar.
export struct LaneInfo {
    held: bool,
    joins-up: bool,
    joins-down: bool,
    // The bar's width at its top and bottom: a trigger's pressure, tapering as it glides.
    top: length,
    bottom: length,
    // What the bar holds, such as "LT 128 to 255".
    tip: string,
}

// A stick in a step row, on a disc of radius 1: where it is, and where it glides to.
export struct StickInfo {
    // At rest and not gliding: the cell is blank.
    shown: bool,
    x: float,
    y: float,
    glide: bool,
    to-x: float,
    to-y: float,
    // Words for a screen reader, such as "x 255, y 127".
    text: string,
}

// One step of the selected macro in the step table.
// The numbers of the line under the step table.
export struct StepCount {
    steps: int,
    // The steps on the controller, where each glide is several.
    pad-steps: int,
    // The most steps the controller holds.
    max: int,
    total-ms: int,
}

export struct StepInfo {
    // 1-based.
    number: int,
    // Such as "300 ms".
    starts-at: string,
    duration: string,
    duration-ms: int,
    // No button, no trigger, both sticks at rest.
    pause: bool,
    // What a screen reader says the step holds, such as "A, LT 128 to 255", or "".
    held: string,
    lanes: [LaneInfo],
    left: StickInfo,
    right: StickInfo,
}

// A stick pad of the step panel: where the selected step holds the stick; the Glide
// box's label, whether it can glide, and its tip (what a glide does, or why it cannot);
// and the step that glides this stick in, 1-based, or 0.
export struct PadStick {
    label: string,
    value-x: int,
    value-y: int,
    // The direction the step holds, as the direction picker lists it: 0 the centre,
    // 1 to 8 up clockwise. -1 for a position between them.
    direction: int,
    at: StickInfo,
    glide-label: string,
    can-glide: bool,
    glide-tip: string,
    glides-in-from: int,
}

// A trigger value of the step panel's selected step: its label, its pressure (0 to 255)
// and its glide, as `PadStick` has them. `to-value` is the next step's pressure, where a
// glide ends.
export struct PadTrigger {
    label: string,
    value: int,
    glide: bool,
    to-value: int,
    glide-label: string,
    can-glide: bool,
    glide-tip: string,
    glides-in-from: int,
}

// One button in the step panel's "Buttons held": its label, and whether the step holds it.
export struct ChipInfo {
    label: string,
    // What a screen reader says for the label.
    spoken: string,
    on: bool,
}
