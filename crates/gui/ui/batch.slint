// Write every edited slot: the review, the progress and the failure.
import { Theme, Spinner } from "look/breeze/widgets.slint";
import { Icons, DialogShell, ChangeRow, Disclosure, Frame, NoteRow } from "parts.slint";
import { BatchInfo, BatchSlot } from "types.slint";
import { BackupFile } from "dialogs.slint";

// One slot in the review. The header opens and closes the slot's changes.
component BatchSlotRow inherits Disclosure {
    in property <BatchSlot> slot;
    title: slot.title;
    detail: slot.name;
    note: slot.is-new
        ? @tr("New profile")
        : @tr("{n} change" | "{n} changes" % slot.changes.length);
    open: slot.open;
    has-body: slot.changes.length > 0 || slot.macro-changes.length > 0 || slot.leftover > 0;
    for c[i] in root.slot.changes: ChangeRow {
        change: c;
        rule: i < root.slot.changes.length - 1 || root.slot.macro-changes.length > 0 || root.slot.leftover > 0;
    }
    for r[i] in root.slot.macro-changes: NoteRow {
        text: r;
    }
    if root.slot.leftover > 0: NoteRow {
        text: @tr("The empty slot still holds {n} macro. Writing a profile removes it."
            | "The empty slot still holds {n} macros. Writing a profile removes them." % root.slot.leftover);
    }
}

// One slot of the run, in the writing and failure dialogs.
component RunRow inherits Rectangle {
    in property <string> title;
    // 0 waiting, 1 writing, 2 written, 3 failed.
    in property <int> kind;
    // The run stopped, so a slot not reached reads "Not written".
    in property <bool> stopped;
    in property <bool> last;
    min-height: 32px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        if root.kind == 2: Image {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            source: Icons.check;
            colorize: Theme.positive;
        }
        if root.kind == 3: Image {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            source: Icons.close;
            colorize: Theme.negative;
        }
        if root.kind == 1: Spinner {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
        }
        // Slint draws no dashed border, so the empty circle is solid.
        if root.kind == 0: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            border-width: 1.5px;
            border-color: Theme.line;
        }
        Text {
            horizontal-stretch: 1;
            text: root.title;
            font-weight: root.kind == 1 || root.kind == 3 ? 600 : 400;
            color: root.kind == 0 ? Theme.fg-muted : Theme.fg;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.kind == 2 ? @tr("Written")
                : root.kind == 1 ? @tr("Writing")
                : root.kind == 3 ? @tr("Failed")
                : root.stopped ? @tr("Not written") : @tr("Waiting");
            color: Theme.fg-muted;
            vertical-alignment: center;
        }
    }
    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

export component BatchReviewDialog inherits DialogShell {
    in property <BatchInfo> info;
    callback toggled(int);
    property <int> n: info.slots.length;
    property <int> c: info.total-changes;
    icon: Icons.stack;
    title: @tr("Write {n} slot to the controller?" | "Write {n} slots to the controller?" % n);
    subtitle: (info.any-new ? "" : @tr("{n} change." | "{n} changes." % c) + " ") + @tr("Slots without edits stay as they are.");
    accept-text: @tr("Write {n} slot" | "Write {n} slots" % n);
    Frame {
        VerticalLayout {
            for s[i] in root.info.slots: BatchSlotRow {
                slot: s;
                last: i == root.n - 1;
                toggled => { root.toggled(i); }
            }
        }
    }
}

// Shown while the batch runs. Blocks the window: nothing may change under a write.
export component BatchWritingDialog inherits DialogShell {
    in property <BatchInfo> info;
    icon: Icons.pad;
    // The slots from `at` on go in one run, so they all show as writing.
    property <int> m: info.slots.length - info.at;
    title: @tr("Writing {n} slot" | "Writing {n} slots" % m);
    subtitle: @tr("Keep the controller plugged in.");
    cancel-text: "";
    accept-text: "";
    Frame {
        VerticalLayout {
            for s[i] in root.info.slots: RunRow {
                title: s.title;
                kind: i < root.info.at ? 2 : 1;
                last: i == root.info.slots.length - 1;
            }
        }
    }
}

export component BatchFailedDialog inherits DialogShell {
    in property <BatchInfo> info;
    // The slots the retry writes: the failed one and those after it.
    property <int> m: info.slots.length - info.at;
    property <string> failed: info.slots[info.at].title;
    icon: Icons.error;
    alarm: true;
    card-width: 560px;
    title: @tr("Writing {} failed", failed);
    subtitle: info.detail;
    cancel-text: @tr("Close");
    accept-text: m == 1 ? @tr("Write {} again", failed) : @tr("Write the {n} slot again" | "Write the {n} slots again" % m);
    extra-text: info.backup-path != "" || info.macro-backups.length > 0 ? @tr("Open folder") : "";
    extra-icon: Icons.folder;
    diagnostics: true;
    Frame {
        VerticalLayout {
            for s[i] in root.info.slots: RunRow {
                title: s.title;
                kind: i < root.info.at ? 2 : i == root.info.at ? 3 : 0;
                stopped: true;
                last: i == root.info.slots.length - 1;
            }
        }
    }
    if root.info.backup-path != "": BackupFile {
        path: root.info.backup-path;
    }
    for p in root.info.macro-backups: BackupFile {
        path: p;
        text: @tr("The old macro is saved in this file:");
    }
    Text {
        text: root.m == 1
            ? @tr("Your edits to this slot are still here.")
            : @tr("Your edits to the {n} slot are still here." | "Your edits to the {n} slots are still here." % root.m);
        color: Theme.fg-muted;
        wrap: word-wrap;
    }
}
