// The step table of the Macros tab: the toolbar, then one row per step of the selected
// macro, with a lane per button it holds and its two sticks.
import { Theme, Button, ScrollView, Spinner } from "look/breeze/widgets.slint";
import { Frame, Icons, NumberEdit, SmallHead } from "parts.slint";
import { LaneInfo, StepInfo, StickInfo } from "types.slint";

// Column widths: step number, start time, each stick, duration. The lanes share the
// rest, at most `lane-max` each.
global Columns {
    out property <length> number: 44px;
    out property <length> start: 80px;
    out property <length> stick: 64px;
    // Wide enough for the selected row's number field and its arrows.
    out property <length> duration: 124px;
    out property <length> lane-max: 36px;
    out property <length> lane-min: 22px;
    out property <length> row: 40px;
    // The scroll area shows this many rows, then scrolls.
    out property <int> shown-rows: 6;
}

// A button's cell in one step: a bar while it is held. The bar runs into the cell above
// or below that also holds it, and a trigger's bar is as wide as its pressure.
component LaneCell inherits Rectangle {
    in property <LaneInfo> cell;
    property <length> inset: 9px;
    // Deep enough on `view` for a graphic (3:1) in both themes.
    property <brush> ink: Theme.dark ? Theme.accent : Theme.accent-strong;
    // No wider than the lane, less a 2px gap on each side, in whole physical pixels.
    property <length> top: round(min(root.cell.top, root.width - 4px) / 1phx) * 1phx;
    property <length> bottom: round(min(root.cell.bottom, root.width - 4px) / 1phx) * 1phx;
    property <length> y0: root.cell.joins-up ? 0 : self.inset;
    property <length> y1: root.cell.joins-down ? self.height : self.height - self.inset;
    // Where a bar `w` wide starts, centred on a whole physical pixel. A bar of the same
    // pressure starts at the same x in every row, so the rows meet edge to edge.
    pure function left(w: length) -> length {
        round((root.width - w) / 2 / 1phx) * 1phx
    }
    // A glide's end that meets the next or the last row's bar is drawn as that bar is, so
    // the slanted edge's smoothing never makes it wider or narrower at the join.
    property <length> cap: 2px;
    // A pill when it stands alone, square where it joins.
    if root.cell.held && root.cell.top == root.cell.bottom: Rectangle {
        x: root.left(root.top);
        y: root.y0;
        width: root.top;
        height: root.y1 - root.y0;
        background: root.ink;
        border-top-left-radius: root.cell.joins-up ? 0 : self.width / 2;
        border-top-right-radius: root.cell.joins-up ? 0 : self.width / 2;
        border-bottom-left-radius: root.cell.joins-down ? 0 : self.width / 2;
        border-bottom-right-radius: root.cell.joins-down ? 0 : self.width / 2;
    }
    // A glide: a trapezoid from this pressure to the next, with a square cap at each end
    // that joins a bar. The app's renderer smooths a slanted edge by spreading it about
    // one physical pixel outward, so the trapezoid is drawn that much in from each side
    // and from each cap, and its smoothing lands on the true width.
    property <length> spread: 1phx;
    if root.cell.held && root.cell.top != root.cell.bottom: Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        property <float> ya: (root.cell.joins-up ? root.y0 + root.cap : root.y0 + root.spread) / 1px;
        property <float> yb: (root.cell.joins-down ? root.y1 - root.cap : root.y1 - root.spread) / 1px;
        property <float> tl: (root.left(root.top) + root.spread) / 1px;
        property <float> bl: (root.left(root.bottom) + root.spread) / 1px;
        property <float> tw: max(0, (root.top - 2 * root.spread) / 1px);
        property <float> bw: max(0, (root.bottom - 2 * root.spread) / 1px);
        commands: "M " + self.tl + " " + self.ya + " L " + (self.tl + self.tw) + " " + self.ya + " L " + (self.bl + self.bw) + " " + self.yb + " L " + self.bl + " " + self.yb + " Z";
        fill: root.ink;
    }
    if root.cell.held && root.cell.top != root.cell.bottom && root.cell.joins-up: Rectangle {
        x: root.left(root.top);
        y: root.y0;
        width: root.top;
        height: root.cap;
        background: root.ink;
    }
    if root.cell.held && root.cell.top != root.cell.bottom && root.cell.joins-down: Rectangle {
        x: root.left(root.bottom);
        y: root.y1 - root.cap;
        width: root.bottom;
        height: root.cap;
        background: root.ink;
    }
    if root.cell.held: Tooltip {
        text: @markdown("\{root.cell.tip}");
    }
}

// A stick on its gate: a dot where it is, and a line to where it glides.
component StickGlyph inherits Rectangle {
    in property <StickInfo> stick;
    // The gate's centre and the reach of a full deflection, in pixels.
    property <float> c: 12;
    property <float> r: 9;
    width: 24px;
    height: 24px;
    accessible-role: image;
    accessible-label: root.stick.text;
    Rectangle {
        border-width: 1px;
        border-color: Theme.line;
        border-radius: self.width / 2;
        background: Theme.view;
    }
    // The start, then the path over it, then where the glide ends.
    Rectangle {
        x: (root.c + root.stick.x * root.r) * 1px - 3px;
        y: (root.c + root.stick.y * root.r) * 1px - 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.accent-strong;
    }
    if root.stick.glide: Path {
        width: root.width;
        height: root.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M " + (root.c + root.stick.x * root.r) + " " + (root.c + root.stick.y * root.r) + " L " + (root.c + root.stick.to-x * root.r) + " " + (root.c + root.stick.to-y * root.r);
        stroke: Theme.accent;
        stroke-width: 1.5px;
    }
    if root.stick.glide: Rectangle {
        x: (root.c + root.stick.to-x * root.r) * 1px - 3px;
        y: (root.c + root.stick.to-y * root.r) * 1px - 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.view;
        border-width: 1.5px;
        border-color: Theme.accent;
    }
}

// The lane cells of a row or the lane heads, left to right in the space they share. A
// lane is at least `lane-min` wide: lanes past the space scroll sideways by `offset`, the
// same for the heads and every row.
component Lanes inherits Rectangle {
    in property <int> count;
    // How far the lanes are scrolled: 0 or less, in whole physical pixels.
    in property <length> offset;
    // Rounded down, so lanes that fit never add up to more than the space.
    out property <length> lane: self.count > 0 ? floor(clamp(self.width / self.count, Columns.lane-min, Columns.lane-max) / 1phx) * 1phx : 0;
    // How far the lanes reach past the space, which is as far as they can scroll.
    out property <length> range: max(0px, self.count * self.lane - self.width);
    horizontal-stretch: 1;
    min-width: 0;
    clip: true;
    Rectangle {
        x: round(root.offset / 1phx) * 1phx;
        width: root.count * root.lane;
        @children
    }
}

// One step: number, start time, lanes, sticks (or "Pause"), duration. The selected
// row edits its duration in place.
component StepRow inherits Rectangle {
    in property <StepInfo> step;
    in property <bool> selected;
    in property <bool> focused;
    in property <bool> editable;
    in property <int> duration-min;
    in property <int> duration-max;
    in property <length> lane-x;
    // The Step column's width, which the table sets from its head.
    in property <length> number-w: Columns.number;
    callback picked;
    callback duration-changed(int);
    // A scroll over the row: true when the lanes took it.
    callback scrolled(PointerScrollEvent) -> bool;
    height: Columns.row;
    background: root.selected ? Theme.accent-wash : ta.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: "Step " + root.step.number + ", starts at " + root.step.starts-at + (root.step.pause ? ", pause" : root.step.held != "" ? ", holds " + root.step.held : "") + ", lasts " + root.step.duration;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.picked(); }
    // Under the lanes, so a held bar runs through it.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
    ta := TouchArea {
        clicked => { root.picked(); }
        scroll-event(e) => { root.scrolled(e) ? accept : reject }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            width: root.number-w;
            text: root.step.number;
            font-size: Theme.text-small;
            color: Theme.fg-muted;
            vertical-alignment: center;
        }
        Text {
            width: Columns.start;
            text: root.step.starts-at;
            font-size: Theme.text-small;
            color: Theme.fg-muted;
            vertical-alignment: center;
        }
        lanes := Lanes {
            count: root.step.lanes.length;
            offset: root.lane-x;
            for cell[i] in root.step.lanes: LaneCell {
                x: i * lanes.lane;
                width: lanes.lane;
                height: parent.height;
                cell: cell;
            }
        }
        if root.step.pause: Text {
            width: Columns.stick * 2;
            text: "Pause";
            font-size: Theme.text-small;
            font-italic: true;
            color: Theme.fg-muted;
            vertical-alignment: center;
        }
        if !root.step.pause: Rectangle {
            width: Columns.stick;
            if root.step.left.shown: StickGlyph {
                x: 0;
                y: round((parent.height - self.height) / 2 / 1phx) * 1phx;
                stick: root.step.left;
            }
        }
        if !root.step.pause: Rectangle {
            width: Columns.stick;
            if root.step.right.shown: StickGlyph {
                x: 0;
                y: round((parent.height - self.height) / 2 / 1phx) * 1phx;
                stick: root.step.right;
            }
        }
        if !root.selected: Text {
            width: Columns.duration;
            text: root.step.duration;
            color: Theme.fg;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        if root.selected: HorizontalLayout {
            width: Columns.duration;
            alignment: end;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                NumberEdit {
                    value: root.step.duration-ms;
                    minimum: root.duration-min;
                    maximum: root.duration-max;
                    enabled: root.editable;
                    step: 5;
                    accessible-name: "Step " + root.step.number + " duration in milliseconds";
                    committed(v) => { root.duration-changed(v); }
                }
            }
            Text {
                text: "ms";
                color: Theme.fg;
                vertical-alignment: center;
            }
        }
    }
    if root.selected && root.focused: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: Theme.radius;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// The toolbar and the table. Each toolbar edit acts on the selected step.
export component StepTable inherits Frame {
    in property <[StepInfo]> rows;
    in property <[string]> lanes;
    // Such as "12/408 steps".
    in property <string> count;
    // The steps fill the controller: no edit may add one.
    in property <bool> full;
    // The steps are more than the controller holds: the count is in red.
    in property <bool> over;
    // The steps are read from the controller.
    in property <bool> ready;
    in property <bool> editable;
    in-out property <int> selected: 0;
    // The last step edit can be taken back.
    in property <bool> can-undo;
    // The range of a step's duration, in milliseconds.
    in property <int> duration-min;
    in property <int> duration-max;
    // An edit of the selected step: 0 add, 1 duplicate, 2 split, 3 up, 4 down, 5 delete.
    callback edited(int);
    // Ctrl+Z: take back the last step edit.
    callback undone;
    // The selected step's new duration.
    callback duration-changed(int);
    // The Step column grows to its head at a larger desktop font; a stick head that no
    // longer fits its column is shortened to "L stick" and "R stick".
    property <length> number-w: max(Columns.number, step-head.preferred-width + 12px);
    property <bool> short-heads: stick-head.preferred-width > Columns.stick;
    property <bool> can: root.ready && root.editable;
    property <int> last: root.rows.length - 1;
    // The lanes' sideways scroll, 0 or less. The heads and every row share it. Picking a
    // step leaves it alone.
    in-out property <length> lane-x: 0;
    // How far the lanes can scroll: 0 while they fit.
    property <length> range: heads.range;
    property <length> shown-x: max(root.lane-x, -root.range);
    // A window that widens again must not bring back a scroll it had to cut short.
    changed range => { root.lane-x = max(root.lane-x, -root.range); }

    function scroll-by(dx: length) {
        root.lane-x = clamp(root.shown-x + dx, -root.range, 0);
    }

    // A scroll over the table: the lanes take a sideways swipe, and a wheel turn with
    // Shift. Anything else goes on to the page.
    function scrolled(e: PointerScrollEvent) -> bool {
        if (root.range <= 0) {
            return false;
        }
        if (e.delta-x != 0 && abs(e.delta-x) >= abs(e.delta-y)) {
            root.scroll-by(e.delta-x);
            return true;
        }
        if (e.delta-x == 0 && e.delta-y != 0 && e.modifiers.shift) {
            root.scroll-by(e.delta-y);
            return true;
        }
        return false;
    }

    // Scrolls the selected row into view.
    function reveal() {
        let top = root.selected * Columns.row;
        if (top < -sv.content-y) {
            sv.content-y = -top;
        } else if (top + Columns.row > -sv.content-y + sv.visible-height) {
            sv.content-y = -(top + Columns.row - sv.visible-height);
        }
    }
    changed selected => { root.reveal(); }

    // Unseen: the width each head needs.
    step-head := SmallHead {
        visible: false;
        text: "Step";
    }
    stick-head := SmallHead {
        visible: false;
        text: "Right stick";
    }

    VerticalLayout {
        Rectangle {
            height: 44px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 12px;
                spacing: 4px;
                alignment: start;
                // A tooltip cannot sit in a layout, so each button gets a frame. Focus
                // goes back to the rows after a click, so the keys keep working.
                Rectangle {
                    horizontal-stretch: 0;
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Add step";
                            icon: Icons.plus;
                            enabled: root.can && !root.full;
                            clicked => {
                                root.edited(0);
                                cursor.focus();
                            }
                        }
                    }
                    Tooltip {
                        text: @markdown("Add an empty step after this one (Insert)");
                    }
                }
                for tool in [
                    { text: "Duplicate step", icon: Icons.copy, edit: 1, on: !root.full },
                    { text: "Split step in two halves", icon: Icons.split, edit: 2, on: !root.full && root.rows[root.selected].duration-ms >= 2 },
                    { text: "Move step up (Alt+Up)", icon: Icons.up, edit: 3, on: root.selected > 0 },
                    { text: "Move step down (Alt+Down)", icon: Icons.down, edit: 4, on: root.selected < root.last },
                    { text: "Delete step (Delete)", icon: Icons.clear, edit: 5, on: root.rows.length > 1 },
                    { text: "Undo the last step edit (Ctrl+Z)", icon: Icons.discard, edit: 6, on: root.can-undo },
                ]: Rectangle {
                    horizontal-stretch: 0;
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: tool.text;
                            icon: tool.icon;
                            icon-only: true;
                            enabled: root.can && tool.on;
                            clicked => {
                                if (tool.edit == 6) {
                                    root.undone();
                                } else {
                                    root.edited(tool.edit);
                                }
                                cursor.focus();
                            }
                        }
                    }
                    Tooltip {
                        text: @markdown("\{tool.text}");
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line-soft;
            }
        }
        Rectangle {
            height: 30px;
            background: Theme.window;
            TouchArea {
                scroll-event(e) => { root.scrolled(e) ? accept : reject }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                SmallHead {
                    width: root.number-w;
                    text: "Step";
                    vertical-alignment: center;
                }
                SmallHead {
                    width: Columns.start;
                    text: "Starts at";
                    vertical-alignment: center;
                }
                heads := Lanes {
                    count: root.lanes.length;
                    offset: root.shown-x;
                    for name[i] in root.lanes: SmallHead {
                        x: i * heads.lane;
                        width: heads.lane;
                        height: parent.height;
                        text: name;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                SmallHead {
                    width: Columns.stick;
                    text: root.short-heads ? "L stick" : "Left stick";
                    accessible-label: "Left stick";
                    vertical-alignment: center;
                    overflow: elide;
                }
                SmallHead {
                    width: Columns.stick;
                    text: root.short-heads ? "R stick" : "Right stick";
                    accessible-label: "Right stick";
                    vertical-alignment: center;
                    overflow: elide;
                }
                SmallHead {
                    width: Columns.duration;
                    text: "Duration";
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line-soft;
            }
        }
        if !root.ready: HorizontalLayout {
            padding: 16px;
            spacing: 8px;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Spinner { }
            }
            Text {
                text: "Reading the steps from the controller…";
                color: Theme.fg-muted;
                vertical-alignment: center;
            }
        }
        // Takes the keys that the focused row passes up. Tab reaches the row, not this.
        // It is the "Steps" list too: the focus scope inside it is its nearest accessible
        // node, so a screen reader hears the list and the selected row it delegates to.
        fs := FocusScope {
            visible: root.ready;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            accessible-role: list;
            accessible-label: "Steps";
            accessible-item-count: root.rows.length;
            accessible-delegate-focus: root.selected;
            height: root.ready ? min(root.rows.length, Columns.shown-rows) * Columns.row : 0;
            key-pressed(e) => {
                if (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                    let down = e.text == Key.DownArrow;
                    if (e.modifiers.alt) {
                        if (root.can && (down ? root.selected < root.last : root.selected > 0)) {
                            root.edited(down ? 4 : 3);
                        }
                    } else {
                        root.selected = max(0, min(root.last, root.selected + (down ? 1 : -1)));
                    }
                    return accept;
                }
                if ((e.text == Key.LeftArrow || e.text == Key.RightArrow) && root.range > 0) {
                    root.scroll-by((e.text == Key.LeftArrow ? 1 : -1) * Columns.lane-max);
                    return accept;
                }
                if (e.text == Key.Home || e.text == Key.End) {
                    root.selected = e.text == Key.Home ? 0 : root.last;
                    return accept;
                }
                if (e.text == Key.PageUp || e.text == Key.PageDown) {
                    let page = Columns.shown-rows - 1;
                    root.selected = max(0, min(root.last, root.selected + (e.text == Key.PageDown ? page : -page)));
                    return accept;
                }
                if (e.modifiers.control && (e.text == "z" || e.text == "Z")) {
                    if (root.can && root.can-undo) {
                        root.undone();
                    }
                    return accept;
                }
                if (e.text == Key.Insert && root.can && !root.full) {
                    root.edited(0);
                    return accept;
                }
                if (e.text == Key.Delete && root.can && root.rows.length > 1) {
                    root.edited(5);
                    return accept;
                }
                reject
            }
            sv := ScrollView {
                width: parent.width;
                height: parent.height;
                // The focus sits on the selected row, not on the table: Slint scrolls
                // the page to show a newly focused item, and the row is on screen.
                cursor := FocusScope {
                    y: root.selected * Columns.row;
                    height: Columns.row;
                    focus-on-click: false;
                }
                VerticalLayout {
                    for r[i] in root.rows: StepRow {
                        step: r;
                        selected: i == root.selected;
                        focused: cursor.has-focus;
                        editable: root.editable;
                        duration-min: root.duration-min;
                        duration-max: root.duration-max;
                        lane-x: root.shown-x;
                        number-w: root.number-w;
                        scrolled(e) => { root.scrolled(e) }
                        duration-changed(v) => { root.duration-changed(v); }
                        picked => {
                            root.selected = i;
                            cursor.focus();
                        }
                    }
                }
            }
        }
        // The bar of the lanes, under their column, only while they do not fit.
        Rectangle {
            visible: root.ready && root.range > 0;
            height: self.visible ? 12px : 0;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Rectangle {
                    width: root.number-w + Columns.start;
                }
                bar := Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0;
                    property <length> thumb: max(28px, self.width * self.width / (self.width + root.range));
                    // The track, so the thumb reads as a bar and not a stray mark.
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 2px;
                        background: Theme.line-soft;
                    }
                    Rectangle {
                        height: bar-ta.has-hover || bar-ta.pressed ? 8px : 4px;
                        y: (parent.height - self.height) / 2;
                        x: round(-root.shown-x / root.range * (parent.width - parent.thumb) / 1phx) * 1phx;
                        width: parent.thumb;
                        border-radius: self.height / 2;
                        background: bar-ta.pressed ? Theme.accent : Theme.fg-muted.with-alpha(bar-ta.has-hover ? 0.7 : 0.45);
                        animate height { duration: 120ms; }
                    }
                    bar-ta := TouchArea {
                        moved => {
                            if (self.pressed) {
                                root.lane-x = -clamp((self.mouse-x - bar.thumb / 2) / (bar.width - bar.thumb), 0, 1) * root.range;
                            }
                        }
                        scroll-event(e) => { root.scrolled(e) ? accept : reject }
                    }
                }
                Rectangle {
                    width: Columns.stick * 2 + Columns.duration;
                }
            }
        }
        // The count, under the table, where its whole line fits at any font size.
        Rectangle {
            visible: root.ready;
            height: self.visible ? 28px : 0;
            count-line := Text {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text: root.count + (root.over ? ", too many" : root.full ? ", full" : "");
                font-size: Theme.text-small;
                color: root.over ? Theme.negative-ink : root.full ? Theme.fg : Theme.fg-muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
