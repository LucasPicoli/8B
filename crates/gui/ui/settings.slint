// The settings tabs after Buttons, such as Sticks: frames of sliders, check boxes,
// drop-down lists, colours and rings of coloured segments. Rust sends the frames, so the
// markup names no profile field.
import { Theme, Slider, CheckBox, ComboBox, LineEdit, Button } from "look/breeze/widgets.slint";
import { Frame, Dot, Icons, SmallHead, RangeSlider, NumberEdit } from "parts.slint";
import { SettingsPage, SettingFrame, RingRow } from "types.slint";

// Rust answers whether a typed colour is one a hex field takes, such as "#7E3200".
export global ColourCheck {
    pure callback valid(string) -> bool;
}

// The colour picker in a swatch button's popup: a saturation and brightness square, a
// hue strip, its red, green and blue numbers, then the colour before and now with its
// hex code, Cancel and OK. Each move hands the parent the colour; the hue is kept here,
// so a grey keeps it.
component ColourPicker {
    in property <color> colour;
    in property <color> before;
    in property <string> hex;
    in property <int> red;
    in property <int> green;
    in property <int> blue;
    // Says what the colour belongs to, such as "Fire Ring, Colour".
    in property <string> context;
    in-out property <float> hue;
    in-out property <float> sat;
    in-out property <float> val;
    callback picked(color);
    callback typed(string);
    // Cancel: the colours go back to what they were when the picker opened.
    callback cancelled();
    // OK: the picked colour stays, as with a click outside.
    callback accepted();
    property <bool> bad: hex-field.has-focus && hex-field.text != "" && !ColourCheck.valid(hex-field.text);
    width: 300px;

    function pick() {
        root.picked(hsv(root.hue, root.sat, root.val));
    }

    VerticalLayout {
        padding: 12px;
        spacing: 12px;
        square := Rectangle {
            height: 164px;
            border-radius: 3px;
            clip: true;
            background: hsv(root.hue, 1, 1);
            accessible-role: slider;
            accessible-label: @tr("{}, saturation and brightness", root.context);
            accessible-value: @tr("saturation {}%, brightness {}%", round(root.sat * 100), round(root.val * 100));
            Rectangle {
                background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%);
            }
            Rectangle {
                background: @linear-gradient(0deg, #000000 0%, #00000000 100%);
            }
            Rectangle {
                x: root.sat * parent.width - self.width / 2;
                y: (1 - root.val) * parent.height - self.height / 2;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: 2px;
                border-color: #ffffff;
                drop-shadow-blur: 2px;
                drop-shadow-color: Theme.shadow;
            }
            sq-focus := FocusScope {
                key-pressed(e) => {
                    if (e.text == Key.LeftArrow || e.text == Key.RightArrow) {
                        root.sat = clamp(root.sat + (e.text == Key.RightArrow ? 0.02 : -0.02), 0, 1);
                        root.pick();
                        return accept;
                    }
                    if (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                        root.val = clamp(root.val + (e.text == Key.UpArrow ? 0.02 : -0.02), 0, 1);
                        root.pick();
                        return accept;
                    }
                    reject
                }
            }
            sq-touch := TouchArea {
                function at() {
                    root.sat = clamp(self.mouse-x / self.width, 0, 1);
                    root.val = 1 - clamp(self.mouse-y / self.height, 0, 1);
                    root.pick();
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        sq-focus.focus();
                        self.at();
                    }
                }
                moved => { if (self.pressed) { self.at(); } }
            }
            if sq-focus.has-focus: Rectangle {
                border-radius: 3px;
                border-width: 2px;
                border-color: Theme.accent;
            }
        }
        strip := Rectangle {
            height: 14px;
            border-radius: 7px;
            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);
            accessible-role: slider;
            accessible-label: @tr("{}, hue", root.context);
            accessible-value: round(root.hue);
            accessible-value-minimum: 0;
            accessible-value-maximum: 360;
            Rectangle {
                x: root.hue / 360 * parent.width - self.width / 2;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: Theme.button;
                border-width: 1px;
                border-color: hue-focus.has-focus ? Theme.accent : Theme.line;
                drop-shadow-blur: 2px;
                drop-shadow-offset-y: 1px;
                drop-shadow-color: Theme.shadow;
            }
            hue-focus := FocusScope {
                key-pressed(e) => {
                    if (e.text == Key.LeftArrow || e.text == Key.RightArrow) {
                        root.hue = clamp(root.hue + (e.text == Key.RightArrow ? 2 : -2), 0, 360);
                        root.pick();
                        return accept;
                    }
                    reject
                }
            }
            hue-touch := TouchArea {
                function at() {
                    root.hue = clamp(self.mouse-x / self.width, 0, 1) * 360;
                    root.pick();
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        hue-focus.focus();
                        self.at();
                    }
                }
                moved => { if (self.pressed) { self.at(); } }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            for c[i] in [@tr("R"), @tr("G"), @tr("B")]: HorizontalLayout {
                spacing: 4px;
                Text {
                    text: c;
                    color: Theme.fg-muted;
                    vertical-alignment: center;
                }
                NumberEdit {
                    value: i == 0 ? root.red : i == 1 ? root.green : root.blue;
                    minimum: 0;
                    maximum: 255;
                    accessible-name: @tr("{}, {}", root.context, c);
                    committed(v) => {
                        root.picked(rgb(i == 0 ? v : root.red, i == 1 ? v : root.green, i == 2 ? v : root.blue));
                    }
                }
            }
        }
        // The before and now chip gives way first when a language's button words are long.
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                min-width: 28px;
                max-width: 56px;
                horizontal-stretch: 1;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.line;
                clip: true;
                accessible-role: none;
                HorizontalLayout {
                    padding: 1px;
                    Rectangle {
                        background: root.before;
                    }
                    Rectangle {
                        background: root.colour;
                    }
                }
            }
            Rectangle {
                width: 92px;
                hex-field := LineEdit {
                    width: 100%;
                    mono: true;
                    text: root.hex;
                    accessible-name: @tr("{}, hex code", root.context);
                    edited(t) => {
                        if (ColourCheck.valid(t)) {
                            root.typed(t);
                        }
                    }
                    changed has-focus => { if (!self.has-focus) { self.text = root.hex; } }
                }
                if root.bad: Rectangle {
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.negative;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Cancel");
                clicked => { root.cancelled(); }
            }
            Button {
                text: @tr("OK");
                primary: true;
                clicked => { root.accepted(); }
            }
        }
    }
    changed hex => { if (!hex-field.has-focus) { hex-field.text = self.hex; } }
}

// A colour's swatch, with a chevron: a click, Space or Enter opens the picker under it.
component ColourButton {
    in property <color> swatch;
    // The selected ring segments hold different colours: the chip is split.
    in property <bool> mixed;
    in property <string> hex;
    in property <int> red;
    in property <int> green;
    in property <int> blue;
    // Says what the colour belongs to, such as "Fire Ring, Colour".
    in property <string> context;
    callback picked(color);
    callback typed(string);
    callback opened();
    // Cancel closed the picker.
    callback cancelled();
    // OK or a click outside closed the picker, and the picked colour stays.
    callback dismissed();
    property <bool> showing: popup.is-open;
    property <bool> cancelling;
    property <float> hue;
    property <float> sat;
    property <float> val;
    property <color> before;
    width: 52px;
    height: Theme.control-height;
    accessible-role: button;
    accessible-label: @tr("{}, pick a colour", root.context);
    accessible-action-default => { root.open(); }
    forward-focus: fs;

    // Takes the hue, saturation and brightness from the swatch, then shows the picker.
    public function open() {
        let c = root.swatch.to-hsv();
        // A grey or black has no hue of its own: keep the last one.
        if (c.saturation > 0 && c.value > 0) {
            root.hue = c.hue;
        }
        root.sat = c.saturation;
        root.val = c.value;
        root.before = root.swatch;
        root.opened();
        popup.show();
    }

    changed showing => {
        if (!self.showing) {
            if (!root.cancelling) {
                root.dismissed();
            }
            root.cancelling = false;
        }
    }

    Rectangle {
        border-radius: Theme.radius;
        border-width: 1px;
        background: ta.has-hover ? Theme.hover : Theme.button;
        border-color: ta.has-hover || fs.has-focus ? Theme.accent : Theme.line;
        // A mix shows the first colour beside an empty half.
        Rectangle {
            x: 6px;
            width: 22px;
            height: 18px;
            border-radius: 3px;
            border-width: 1px;
            border-color: #00000033;
            clip: true;
            background: root.mixed ? Theme.window : root.swatch;
            if root.mixed: Rectangle {
                x: 0;
                width: parent.width / 2;
                background: root.swatch;
            }
        }
        Image {
            x: parent.width - 20px;
            width: 14px;
            height: 14px;
            source: @image-url("icons/chevron.svg");
            colorize: Theme.fg-muted;
            accessible-role: none;
        }
    }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                root.open();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        clicked => {
            fs.focus();
            root.open();
        }
    }
    if fs.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: Theme.radius + 2px;
        border-width: 2px;
        border-color: Theme.accent;
    }
    popup := PopupWindow {
        x: root.width - self.width;
        y: root.height + 2px;
        width: picker.preferred-width;
        height: picker.preferred-height;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.view;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.shadow;
        }
        picker := ColourPicker {
            colour: root.swatch;
            before: root.before;
            hex: root.hex;
            red: root.red;
            green: root.green;
            blue: root.blue;
            context: root.context;
            hue <=> root.hue;
            sat <=> root.sat;
            val <=> root.val;
            picked(c) => { root.picked(c); }
            typed(t) => { root.typed(t); }
            // Closes before it tells the parent, which may drop this button in answer.
            cancelled => {
                root.cancelling = true;
                popup.close();
                fs.focus();
                root.cancelled();
            }
            accepted => {
                popup.close();
                fs.focus();
            }
        }
    }
}

// A colour on one line: its name, what the controller holds when it differs, the swatch
// button and the hex code. The hex field hands Rust each colour as it is typed, and
// shows the stored one again when it loses focus.
component ColourEditor inherits HorizontalLayout {
    in property <string> label;
    in property <string> hex;
    in property <color> swatch;
    in property <string> was;
    in property <int> red;
    in property <int> green;
    in property <int> blue;
    in property <bool> mixed;
    // Shown in the empty hex field, such as "Mixed".
    in property <string> placeholder;
    // Says what the colour belongs to, such as "Fire Ring".
    in property <string> context;
    callback typed(string);
    callback picked(color);
    callback opened();
    callback cancelled();
    callback dismissed();
    property <bool> bad: hex-field.has-focus && hex-field.text != "" && !ColourCheck.valid(hex-field.text);
    spacing: 8px;

    Text {
        horizontal-stretch: 1;
        text: root.label;
        color: Theme.fg;
        vertical-alignment: center;
    }
    if root.was != "": Text {
        text: @tr("was {}", root.was);
        color: Theme.fg-muted;
        vertical-alignment: center;
    }
    ColourButton {
        swatch: root.swatch;
        mixed: root.mixed;
        hex: root.hex;
        red: root.red;
        green: root.green;
        blue: root.blue;
        context: root.context + ", " + root.label;
        picked(c) => { root.picked(c); }
        typed(t) => { root.typed(t); }
        opened => { root.opened(); }
        cancelled => { root.cancelled(); }
        dismissed => { root.dismissed(); }
    }
    Rectangle {
        width: 92px;
        hex-field := LineEdit {
            width: 100%;
            mono: true;
            text: root.hex;
            placeholder-text: root.placeholder;
            accessible-name: @tr("{}, {}, hex code", root.context, root.label);
            edited(t) => {
                if (ColourCheck.valid(t)) {
                    root.typed(t);
                }
            }
            changed has-focus => { if (!self.has-focus) { self.text = root.hex; } }
        }
        if root.bad: Rectangle {
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.negative;
        }
    }
    changed hex => { if (!hex-field.has-focus) { hex-field.text = self.hex; } }
}

// A ring of segments, clockwise from the top. A click hands Rust the point in a 100 by
// 100 box; Rust finds the segment. The arrow keys move a focus mark around the ring, and
// Space selects or unselects the marked segment.
component RingView {
    in property <RingRow> ring;
    // What the ring belongs to, such as "Custom".
    in property <string> context;
    // The point, and Shift.
    callback pointed(float, float, bool);
    // The marked segment, and Shift.
    callback keyed(string, bool);
    callback all();
    // Escape: no segment stays selected.
    callback cleared();
    property <int> mark: 0;
    // The arrow keys moved the mark since the ring took focus. Until then no mark shows,
    // so a click does not leave an outline that reads as a second selection.
    property <bool> marked;
    property <int> count: root.ring.segments.length;
    width: 152px;
    height: 152px;
    accessible-role: list;
    accessible-label: @tr("{}, {}", root.context, root.ring.label);
    forward-focus: fs;

    for s in root.ring.segments: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: s.path;
        fill: s.fill;
        stroke: s.selected ? Theme.accent : Theme.line;
        stroke-width: s.selected ? 2.5px : 1px;
        accessible-role: list-item;
        accessible-label: s.spoken;
        accessible-item-selected: s.selected;
    }
    if fs.has-focus && root.marked && root.count > 0: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: root.ring.segments[root.mark].path;
        stroke: Theme.fg;
        stroke-width: 1.5px;
        accessible-role: none;
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.ring.label;
            color: Theme.fg;
            horizontal-alignment: center;
            accessible-role: none;
        }
        if root.ring.changed > 0: HorizontalLayout {
            alignment: center;
            spacing: 4px;
            Dot {
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: @tr("{n} changed" | "{n} changed" % root.ring.changed);
                font-size: Theme.text-small;
                color: Theme.fg-muted;
                accessible-role: none;
            }
        }
    }
    fs := FocusScope {
        changed has-focus => { if (!self.has-focus) { root.marked = false; } }
        key-pressed(e) => {
            if (root.count == 0) {
                return reject;
            }
            if (e.text == Key.RightArrow || e.text == Key.DownArrow) {
                root.mark = mod(root.mark + 1, root.count);
                root.marked = true;
                return accept;
            }
            if (e.text == Key.LeftArrow || e.text == Key.UpArrow) {
                root.mark = mod(root.mark - 1 + root.count, root.count);
                root.marked = true;
                return accept;
            }
            if (e.text == " ") {
                root.marked = true;
                root.keyed(root.ring.segments[root.mark].field, e.modifiers.shift);
                return accept;
            }
            if (e.modifiers.control && (e.text == "a" || e.text == "A")) {
                root.all();
                return accept;
            }
            if (e.text == Key.Escape) {
                root.cleared();
                return accept;
            }
            reject
        }
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                fs.focus();
                root.pointed(self.mouse-x / self.width * 100, self.mouse-y / self.height * 100, e.modifiers.shift);
            }
        }
    }
    if fs.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// One frame: its title, then its drop-down lists, colours, sliders, rings and check boxes.
component FrameBody inherits Frame {
    in property <SettingFrame> f;
    callback number-changed(string, float);
    callback flag-changed(string, bool);
    callback choice-changed(string, int);
    callback colour-typed(string, string);
    callback colour-picked(string, color);
    callback selection-typed(string);
    callback selection-picked(color);
    callback ring-pointed(string, float, float, bool);
    callback segment-keyed(string, bool);
    callback select-all(string);
    callback clear-segments();
    callback picker-opened();
    callback picker-cancelled();
    // One width for every drop-down list of the frame: the one that shows the longest
    // entry of any of them, as the ComboBox's own `fit-width` does.
    property <length> choice-width: max(ceil((options.preferred-width + 34px) / 1phx) * 1phx, 180px);

    // Measures `choice-width`, never drawn. No height, so the frame keeps its own.
    options := VerticalLayout {
        visible: false;
        for c in root.f.choices: VerticalLayout {
            for m in c.options: Text {
                height: 0;
                text: m;
                accessible-role: none;
            }
        }
    }

    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        alignment: start;
        SmallHead {
            text: root.f.title;
        }
        for c in root.f.choices: HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: c.label;
                color: Theme.fg;
                vertical-alignment: center;
            }
            if c.was != "": Text {
                text: @tr("was {}", c.was);
                color: Theme.fg-muted;
                vertical-alignment: center;
            }
            box := ComboBox {
                width: root.choice-width;
                model: c.options;
                current-index <=> c.current;
                accessible-name: @tr("{}, {}", root.f.title, c.label);
                selected => { root.choice-changed(c.field, self.current-index); }
            }
        }
        for c in root.f.colours: ColourEditor {
            label: c.label;
            hex: c.hex;
            swatch: c.swatch;
            was: c.was;
            red: c.red;
            green: c.green;
            blue: c.blue;
            context: root.f.title;
            typed(t) => { root.colour-typed(c.field, t); }
            picked(colour) => { root.colour-picked(c.field, colour); }
            opened => { root.picker-opened(); }
            cancelled => { root.picker-cancelled(); }
        }
        for st in root.f.settings: VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: st.label;
                    color: Theme.fg;
                }
                if st.was != "": Text {
                    text: @tr("was {}", st.was);
                    color: Theme.fg-muted;
                }
                Text {
                    text: st.text;
                    color: st.was != "" ? Theme.fg : Theme.fg-muted;
                    font-weight: st.was != "" ? 600 : 400;
                }
            }
            if st.high-field == "": Slider {
                value <=> st.low;
                minimum: st.minimum;
                maximum: st.maximum;
                accessible-name: @tr("{}, {}", root.f.title, st.label);
                changed(v) => { root.number-changed(st.low-field, v); }
            }
            if st.high-field != "": RangeSlider {
                low <=> st.low;
                high <=> st.high;
                minimum: st.minimum;
                maximum: st.maximum;
                accessible-name: @tr("{}, {}", root.f.title, st.label);
                low-changed(v) => { root.number-changed(st.low-field, v); }
                high-changed(v) => { root.number-changed(st.high-field, v); }
            }
        }
        if root.f.rings.length > 0: HorizontalLayout {
            spacing: 32px;
            alignment: start;
            HorizontalLayout {
                spacing: 24px;
                for r in root.f.rings: RingView {
                    ring: r;
                    context: root.f.title;
                    pointed(x, y, range) => { root.ring-pointed(r.segments[0].field, x, y, range); }
                    keyed(field, range) => { root.segment-keyed(field, range); }
                    all => { root.select-all(r.segments[0].field); }
                    cleared => { root.clear-segments(); }
                }
            }
            for e in root.f.editors: VerticalLayout {
                width: 320px;
                spacing: 12px;
                alignment: center;
                // No swatch or hex code until a segment is selected.
                if e.count == 0: Text {
                    height: Theme.control-height;
                    text: @tr("Select segments to colour them");
                    color: Theme.fg;
                    vertical-alignment: center;
                }
                if e.count > 0: ColourEditor {
                    label: @tr("{n} segment selected" | "{n} segments selected" % e.count);
                    hex: e.colour.hex;
                    swatch: e.colour.swatch;
                    red: e.colour.red;
                    green: e.colour.green;
                    blue: e.colour.blue;
                    mixed: e.count > 1 && e.colour.hex == "";
                    placeholder: e.count > 1 ? @tr("Mixed") : "";
                    context: root.f.title;
                    typed(t) => { root.selection-typed(t); }
                    picked(colour) => { root.selection-picked(colour); }
                    opened => { root.picker-opened(); }
                    // Either way the segments are done: Cancel puts their colours back first.
                    cancelled => {
                        root.picker-cancelled();
                        root.clear-segments();
                    }
                    dismissed => { root.clear-segments(); }
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: @tr("Select all");
                        clicked => { root.select-all(root.f.rings[0].segments[0].field); }
                    }
                }
            }
        }
        for t in root.f.toggles: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            CheckBox {
                text: t.label;
                checked <=> t.on;
                toggled => { root.flag-changed(t.field, self.checked); }
            }
            if t.changed: Dot {
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

export component SettingsTab {
    in property <SettingsPage> page;
    // A value moved: its JSON pointer into the profile, and the new value.
    callback number-changed(string, float);
    callback flag-changed(string, bool);
    // A drop-down list picked the option at this index.
    callback choice-changed(string, int);
    // A colour's hex field holds a colour, or its picker picked one.
    callback colour-typed(string, string);
    callback colour-picked(string, color);
    // The same, for the selected ring segments.
    callback selection-typed(string);
    callback selection-picked(color);
    // A click on the ring whose first segment is this pointer, at a point of its 100 by
    // 100 box, with Shift.
    callback ring-pointed(string, float, float, bool);
    // Space on a ring segment, with Shift.
    callback segment-keyed(string, bool);
    callback select-all(string);
    // A click off the rings, Escape on one, or their picker closing: no segment stays
    // selected.
    callback clear-segments();
    // A colour picker opened, or its Cancel put the colours back.
    callback picker-opened();
    callback picker-cancelled();

    VerticalLayout {
        spacing: 12px;
        alignment: start;
        Text {
            text: root.page.lead;
            color: Theme.fg-muted;
            wrap: word-wrap;
        }
        // One column, as wide as the row of frames: a frame of rings below it ends where
        // the row ends.
        HorizontalLayout {
            alignment: start;
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    for f in root.page.frames: FrameBody {
                        preferred-width: 360px;
                        max-width: 442px;
                        horizontal-stretch: 1;
                        f: f;
                        number-changed(field, v) => { root.number-changed(field, v); }
                        flag-changed(field, on) => { root.flag-changed(field, on); }
                        choice-changed(field, i) => { root.choice-changed(field, i); }
                        colour-typed(field, t) => { root.colour-typed(field, t); }
                        colour-picked(field, c) => { root.colour-picked(field, c); }
                        picker-opened => { root.picker-opened(); }
                        picker-cancelled => { root.picker-cancelled(); }
                    }
                }
                for f in root.page.ring-frames: FrameBody {
                    max-width: 900px;
                    f: f;
                    number-changed(field, v) => { root.number-changed(field, v); }
                    flag-changed(field, on) => { root.flag-changed(field, on); }
                    colour-typed(field, t) => { root.colour-typed(field, t); }
                    colour-picked(field, c) => { root.colour-picked(field, c); }
                    selection-typed(t) => { root.selection-typed(t); }
                    selection-picked(c) => { root.selection-picked(c); }
                    ring-pointed(first, x, y, range) => { root.ring-pointed(first, x, y, range); }
                    segment-keyed(field, range) => { root.segment-keyed(field, range); }
                    select-all(field) => { root.select-all(field); }
                    clear-segments => { root.clear-segments(); }
                    picker-opened => { root.picker-opened(); }
                    picker-cancelled => { root.picker-cancelled(); }
                }
            }
        }
        if root.page.note != "": HorizontalLayout {
            spacing: 6px;
            alignment: start;
            VerticalLayout {
                alignment: start;
                padding-top: 2px;
                Image {
                    width: 14px;
                    height: 14px;
                    source: Icons.info;
                    colorize: Theme.fg-muted;
                    accessible-role: none;
                }
            }
            Text {
                text: root.page.note;
                font-size: Theme.text-small;
                color: Theme.fg-muted;
                wrap: word-wrap;
            }
        }
    }
}
