// The step panel of the Macros tab, under the step table: the sticks and the trigger
// pressure the selected step holds. The controller views beside the tab set its buttons,
// and the table's row its duration.
import { Theme, Button, CheckBox, ComboBox, LinkButton } from "look/breeze/widgets.slint";
import { Frame, Icons, NumberEdit, SmallHead } from "parts.slint";
import { PadStick, PadTrigger } from "types.slint";
import { PadSize, TriggerPad } from "trigger_pad.slint";

// A stick on its round gate: drag the knob, or type X and Y. The square of values maps
// to the gate as the step table's glyph maps it, so Rust turns a point into values.
component StickPad {
    in property <PadStick> stick;
    in property <bool> enabled;
    // The values, and whether the edit is its own undo; a point on the gate in gate
    // radii from its centre; the glide.
    callback set(int, int, bool);
    callback dragged(float, float);
    callback glided(bool);
    // The note on an arriving step was clicked: select the step that glides in (0-based).
    callback step-picked(int);
    // A drag near a marked rim point lands on it; the points show only then. The box under
    // the gate turns it on or off for this stick.
    in property <bool> snap;
    callback snap-toggled(bool);
    // The gate's size, and the reach of a full deflection from its centre.
    property <length> size: PadSize.gate;
    property <length> r: 52px;
    property <length> c: root.size / 2;
    // The X and Y labels' column, which `TriggerPad` leaves free, so the fields line up.
    property <length> label-width: PadSize.label;
    property <bool> at-rest: root.stick.value-x == 127 && root.stick.value-y == 127;
    // A click sets the box's own `checked`, which ends its binding: follow the data.
    changed stick => { glide.checked = root.stick.at.glide; }
    changed snap => { snap-box.checked = root.snap; }

    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            SmallHead {
                text: root.stick.label;
                vertical-alignment: center;
            }
            Button {
                text: @tr("Centre");
                icon: Icons.centre;
                flat: true;
                enabled: root.enabled && !root.at-rest;
                accessible-label: @tr("Centre {}", root.stick.label);
                clicked => { root.set(127, 127, true); }
            }
            // Centre stays beside its stick's label.
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        // On its own line, so a longer language fits beside a second pad.
        glide-row := HorizontalLayout {
            alignment: start;
            // What a glide does, or why it cannot, on hover. A tooltip cannot sit in a
            // layout, so the box gets a frame.
            glide-frame := Rectangle {
                HorizontalLayout {
                    glide := CheckBox {
                        text: root.stick.glide-label;
                        checked: root.stick.at.glide;
                        enabled: root.enabled && root.stick.can-glide;
                        accessible-label: @tr("{}, {}", root.stick.label, root.stick.glide-label);
                        accessible-description: root.stick.glide-tip;
                        toggled => { root.glided(self.checked); }
                    }
                }
                Tooltip {
                    text: @markdown("\{root.stick.glide-tip}");
                }
            }
        }
        HorizontalLayout {
            spacing: PadSize.before-label;
            alignment: start;
            gate := Rectangle {
                width: root.size;
                height: root.size;
                accessible-role: image;
                accessible-label: @tr("{}: {}", root.stick.label, root.stick.at.text);
                opacity: root.enabled ? 1 : 0.45;
                Rectangle {
                    border-width: 1px;
                    border-color: Theme.fg-muted;
                    border-radius: self.width / 2;
                    background: Theme.view;
                }
                Rectangle {
                    x: root.c;
                    y: root.c - root.r;
                    width: 1px;
                    height: root.r * 2;
                    background: Theme.line-soft;
                }
                Rectangle {
                    x: root.c - root.r;
                    y: root.c;
                    width: root.r * 2;
                    height: 1px;
                    background: Theme.line-soft;
                }
                // The 8 snap points on the rim, while a drag snaps to them.
                for k in root.snap ? 8 : 0: Rectangle {
                    x: root.c + root.r * cos(k * 45deg) - 2px;
                    y: root.c + root.r * sin(k * 45deg) - 2px;
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.fg-muted;
                }
                if root.stick.at.glide: Path {
                    width: root.size;
                    height: root.size;
                    viewbox-width: root.size / 1px;
                    viewbox-height: root.size / 1px;
                    // Unlocalized: a pt-BR decimal comma would split each number in two.
                    commands: "M " + ((root.c + root.stick.at.x * root.r) / 1px).to-string-unlocalized() + " " + ((root.c + root.stick.at.y * root.r) / 1px).to-string-unlocalized()
                        + " L " + ((root.c + root.stick.at.to-x * root.r) / 1px).to-string-unlocalized() + " " + ((root.c + root.stick.at.to-y * root.r) / 1px).to-string-unlocalized();
                    stroke: Theme.accent-ink;
                    stroke-width: 2px;
                }
                // Where the glide ends, hollow, under the knob.
                if root.stick.at.glide: Rectangle {
                    x: root.c + root.stick.at.to-x * root.r - 6px;
                    y: root.c + root.stick.at.to-y * root.r - 6px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: Theme.view;
                    border-width: 2px;
                    border-color: Theme.accent-ink;
                }
                Rectangle {
                    x: root.c + root.stick.at.x * root.r - 8px;
                    y: root.c + root.stick.at.y * root.r - 8px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: Theme.accent-strong;
                    border-width: 2px;
                    border-color: Theme.view;
                }
                TouchArea {
                    enabled: root.enabled;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            root.dragged((self.mouse-x - root.c) / root.r, (self.mouse-y - root.c) / root.r);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.dragged((self.mouse-x - root.c) / root.r, (self.mouse-y - root.c) / root.r);
                        }
                    }
                }
            }
            // Centred on the gate on a whole physical pixel, so the field text stays sharp.
            VerticalLayout {
                alignment: start;
                padding-top: max(0px, round((root.size - 2 * Theme.control-height - 8px) / 2 / 1phx) * 1phx);
                spacing: 4px;
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: PadSize.after-label;
                        Text {
                            width: root.label-width;
                            text: "X";
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                        NumberEdit {
                            value: root.stick.value-x;
                            minimum: 0;
                            maximum: 255;
                            step: 1;
                            enabled: root.enabled;
                            accessible-name: @tr("{} X, 0 to 255, rest 127", root.stick.label);
                            committed(v) => { root.set(v, root.stick.value-y, false); }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: PadSize.after-label;
                        Text {
                            width: root.label-width;
                            text: "Y";
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                        NumberEdit {
                            value: root.stick.value-y;
                            minimum: 0;
                            maximum: 255;
                            step: 1;
                            enabled: root.enabled;
                            accessible-name: @tr("{} Y, 0 to 255, rest 127", root.stick.label);
                            committed(v) => { root.set(root.stick.value-x, v, false); }
                        }
                    }
                }
                // The glide that arrives here belongs to the step before: a way back to
                // it. It fits under Y, so the pad keeps its height from step to step.
                if root.stick.glides-in-from > 0: HorizontalLayout {
                    alignment: start;
                    LinkButton {
                        text: @tr("Glides in from step {}", root.stick.glides-in-from);
                        accessible-label: @tr("{} glides in from step {}. Select that step.", root.stick.label, root.stick.glides-in-from);
                        clicked => { root.step-picked(root.stick.glides-in-from - 1); }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            snap-box := CheckBox {
                text: @tr("Snap to edges and corners");
                checked: root.snap;
                accessible-label: @tr("{}, snap to edges and corners", root.stick.label);
                toggled => { root.snap-toggled(self.checked); }
            }
        }
    }

    // The Glide tip while the box has focus from the keyboard, as the hover tooltip shows
    // only to the pointer. Drawn last, over the gate, and no wider than the pad.
    if glide.keyboard-focus: Rectangle {
        x: glide-row.x + glide-frame.x;
        y: glide-row.y + glide-frame.y + glide-frame.height + 4px;
        width: min(ceil((tip.preferred-width + 12px) / 1phx) * 1phx, root.width - self.x);
        height: ceil((tip.preferred-height + 6px) / 1phx) * 1phx;
        border-radius: 3px;
        background: Theme.view;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.shadow;
        tip := Text {
            x: 6px;
            y: 3px;
            width: parent.width - 12px;
            text: root.stick.glide-tip;
            font-size: Theme.text-small;
            color: Theme.fg;
            wrap: word-wrap;
        }
    }
}

export component StepPanel inherits Frame {
    // The step the panel edits, counted from 1, and how many steps the macro has.
    in property <int> step;
    in property <int> steps;
    in property <[PadStick]> sticks;
    in property <[PadTrigger]> triggers;
    in property <bool> enabled;
    // A narrow window, set by Rust: the panel's own width would form a layout loop.
    in property <bool> narrow;
    // A trigger edit names the trigger (its place in the panel) first.
    callback trigger-set(int, int, bool);
    callback trigger-glided(int, bool);
    // Each edit names the stick (0 left, 1 right) first.
    callback stick-set(int, int, int, bool);
    callback stick-dragged(int, float, float, bool);
    callback stick-glided(int, bool);
    // The controller stores stick directions only: each stick gets a direction picker in
    // place of its pad. An edit names the stick, then the direction (`PadStick.direction`).
    in property <bool> directions;
    callback stick-aimed(int, int);
    // A pad asks to select step n (0-based).
    callback step-picked(int);

    // A drag of each stick snaps to the edges and corners marked on its rim. For the
    // session.
    in-out property <bool> snap-left: true;
    in-out property <bool> snap-right: true;

    // A field in the panel reads out this group's name, so the step is spoken on entry.
    accessible-role: groupbox;
    accessible-label: root.heading;
    // One under the other: a narrow window, or a font so large that two pads side by side
    // overflow the panel, 568px wide at 1200px, the narrowest window that is not narrow.
    // A pad's width: its head and Centre fit one line at a larger desktop font, and its
    // Glide box the next.
    property <length> pad-w: max(260px, 19rem);
    property <bool> stacked: root.narrow || 2 * root.pad-w + 40px > 568px;
    property <string> heading: @tr("Step {} of {}", root.step, root.steps);

    VerticalLayout {
        padding: 12px;
        spacing: 16px;
        // The heading's own line never changes height or wraps, so a pick moves nothing.
        Text {
            text: root.heading;
            font-size: Theme.text-section;
            font-weight: 600;
            color: Theme.fg;
            overflow: elide;
            // The group above carries the name.
            accessible-role: none;
        }
        // The sticks side by side, then each trigger under its stick, in two equal
        // columns so each side's controls group apart. One under the other in a narrow
        // window, each pad at its own width. Every pad in a column starts from the same
        // width, so the trigger rows line up with the sticks.
        if root.directions: HorizontalLayout {
            spacing: 16px;
            alignment: start;
            for s[i] in root.sticks: VerticalLayout {
                spacing: 8px;
                SmallHead {
                    text: s.label;
                }
                ComboBox {
                    width: max(180px, self.fit-width);
                    // In the order of `DIRECTIONS` in `stick_pad.rs`.
                    model: [@tr("Centre"), @tr("Up"), @tr("Up right"), @tr("Right"), @tr("Down right"), @tr("Down"), @tr("Down left"), @tr("Left"), @tr("Up left")];
                    current-index: s.direction;
                    enabled: root.enabled;
                    accessible-name: s.label;
                    selected => {
                        root.stick-aimed(i, self.current-index);
                        self.current-index = s.direction;
                    }
                }
            }
        }
        if !root.directions && !root.stacked: HorizontalLayout {
            spacing: 16px;
            for s[i] in root.sticks: StickPad {
                horizontal-stretch: 1;
                stick: s;
                enabled: root.enabled;
                snap: i == 0 ? root.snap-left : root.snap-right;
                snap-toggled(on) => {
                    if (i == 0) {
                        root.snap-left = on;
                    } else {
                        root.snap-right = on;
                    }
                }
                min-width: root.pad-w;
                preferred-width: root.pad-w;
                set(x, y, apart) => { root.stick-set(i, x, y, apart); }
                dragged(x, y) => { root.stick-dragged(i, x, y, self.snap); }
                glided(on) => { root.stick-glided(i, on); }
                step-picked(n) => { root.step-picked(n); }
            }
        }
        if !root.directions && root.stacked: VerticalLayout {
            spacing: 16px;
            alignment: start;
            for s[i] in root.sticks: HorizontalLayout {
                alignment: start;
                StickPad {
                    stick: s;
                    enabled: root.enabled;
                    snap: i == 0 ? root.snap-left : root.snap-right;
                    snap-toggled(on) => {
                        if (i == 0) {
                            root.snap-left = on;
                        } else {
                            root.snap-right = on;
                        }
                    }
                    min-width: root.pad-w;
                    set(x, y, apart) => { root.stick-set(i, x, y, apart); }
                    dragged(x, y) => { root.stick-dragged(i, x, y, self.snap); }
                    glided(on) => { root.stick-glided(i, on); }
                    step-picked(n) => { root.step-picked(n); }
                }
            }
        }
        // None in a mode whose triggers are on or off.
        if !root.stacked && root.triggers.length > 0: HorizontalLayout {
            spacing: 16px;
            for t[k] in root.triggers: TriggerPad {
                horizontal-stretch: 1;
                min-width: root.pad-w;
                preferred-width: root.pad-w;
                trigger: t;
                enabled: root.enabled;
                set(v, apart) => { root.trigger-set(k, v, apart); }
                glided(on) => { root.trigger-glided(k, on); }
                step-picked(n) => { root.step-picked(n); }
            }
        }
        // Stacked, the panel scrolls with the page, so a trigger keeps no empty line for
        // its link.
        if root.stacked && root.triggers.length > 0: VerticalLayout {
            spacing: 16px;
            alignment: start;
            for t[k] in root.triggers: HorizontalLayout {
                alignment: start;
                TriggerPad {
                    width: root.pad-w;
                    trigger: t;
                    enabled: root.enabled;
                    keep-link-line: false;
                    set(v, apart) => { root.trigger-set(k, v, apart); }
                    glided(on) => { root.trigger-glided(k, on); }
                    step-picked(n) => { root.step-picked(n); }
                }
            }
        }
    }
}
