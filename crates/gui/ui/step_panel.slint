// The step panel of the Macros tab: the selected step's duration. The controller views
// beside the tab set the buttons it holds. The body is kept for the sticks and the
// trigger pressure.
import { Theme } from "look/breeze/widgets.slint";
import { Frame, NumberEdit, SmallHead } from "parts.slint";

export component StepPanel inherits Frame {
    // Such as "Step 3 of 5".
    in property <string> title;
    in property <int> duration;
    in property <int> duration-min;
    in property <int> duration-max;
    in property <bool> editable;
    callback duration-changed(int);

    VerticalLayout {
        Rectangle {
            height: 40px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                SmallHead {
                    text: root.title;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: "Duration";
                    color: Theme.fg;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    NumberEdit {
                        value: root.duration;
                        minimum: root.duration-min;
                        maximum: root.duration-max;
                        enabled: root.editable;
                        step: 5;
                        accessible-name: "Step duration in milliseconds";
                        committed(v) => { root.duration-changed(v); }
                    }
                }
                Text {
                    text: "ms";
                    color: Theme.fg;
                    vertical-alignment: center;
                }
            }
        }
    }
}
