// The Macros tab: the macro slots of the selected slot and the controller views on the
// left, the selected macro's header on the right.
import { Theme, Button, ComboBox, LineEdit } from "look/breeze/widgets.slint";
import { Dot, Frame, Icons, MessageBar, NumberEdit, SmallHead, ViewTip } from "parts.slint";
import { ChipInfo, MacroRow, MacroSpot, PadStick, PadView, StepInfo } from "types.slint";
import { StepTable } from "steps.slint";
import { StepPanel } from "step_panel.slint";

// A button that starts a macro, as a filled pill.
component ButtonChip inherits Rectangle {
    in property <string> text;
    // "No button" or a "+n" count: an outline, muted.
    in property <bool> muted;
    height: 18px;
    width: round((label.preferred-width + 12px) / 1phx) * 1phx;
    border-radius: self.height / 2;
    background: root.muted ? transparent : Theme.accent-strong;
    border-width: root.muted ? 1px : 0;
    border-color: Theme.line;
    label := Text {
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        font-size: Theme.text-small;
        font-weight: root.muted ? 400 : 600;
        color: root.muted ? Theme.fg-muted : Theme.on-accent;
    }
}

// One macro slot in the list: number, name or "Empty", step count, buttons, unsaved dot.
component MacroSlotRow inherits Rectangle {
    in property <MacroRow> item;
    in property <bool> selected;
    in property <bool> last;
    // The list has keyboard focus: the selected row shows the focus frame.
    in property <bool> focused;
    callback picked;
    height: 40px;
    background: root.selected ? Theme.accent-wash : ta.has-hover ? Theme.hover : transparent;
    border-width: root.selected ? 1px : 0;
    border-color: Theme.accent;
    accessible-role: list-item;
    accessible-label: "Macro " + root.item.number + ", " + (!root.item.filled ? "empty" : root.item.name != "" ? root.item.name : "no name");
    accessible-item-selected: root.selected;
    accessible-action-default => { root.picked(); }
    ta := TouchArea {
        clicked => { root.picked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            y: round((parent.height - self.height) / 2 / 1phx) * 1phx;
            width: 22px;
            height: 22px;
            border-width: 1px;
            border-radius: Theme.radius;
            border-color: Theme.line;
            Text {
                width: 100%;
                height: 100%;
                text: root.item.number;
                font-size: Theme.text-small;
                color: Theme.fg-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: !root.item.filled ? "Empty" : root.item.name != "" ? root.item.name : "No name";
            color: root.item.filled && root.item.name != "" ? Theme.fg : Theme.fg-muted;
            font-italic: !root.item.filled || root.item.name == "";
            vertical-alignment: center;
            overflow: elide;
        }
        if root.item.filled: Text {
            text: root.item.steps;
            font-size: Theme.text-small;
            color: Theme.fg-muted;
            vertical-alignment: center;
        }
        for b in root.item.first-buttons: ButtonChip {
            y: round((parent.height - self.height) / 2 / 1phx) * 1phx;
            text: b;
        }
        if root.item.more > 0: ButtonChip {
            y: round((parent.height - self.height) / 2 / 1phx) * 1phx;
            text: "+" + root.item.more;
            muted: true;
        }
        if root.item.filled && root.item.buttons.length == 0: ButtonChip {
            y: round((parent.height - self.height) / 2 / 1phx) * 1phx;
            text: "No button";
            muted: true;
        }
        if root.item.unsaved: Dot {
            y: round((parent.height - self.height) / 2 / 1phx) * 1phx;
        }
    }
    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
    if root.selected && root.focused: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: Theme.radius;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// One controller view. The buttons the selected step holds are in the accent. Under the
// pointer, a button a click toggles lights up, and a tip says what the click does or
// that a step cannot hold the button.
component MacroViewArt {
    in property <PadView> view;
    in property <int> index;
    in property <[MacroSpot]> spots;
    // "Buttons held" of the selected step, and its number (1-based).
    in property <[ChipInfo]> chips;
    in property <int> step;
    // A step is shown and can be edited: clicks act and tips show.
    in property <bool> live;
    // The button row under (x, y) in viewBox units, or -1; and the chip a click there
    // toggles, or -1.
    pure callback hit(float, float) -> int;
    pure callback action-hit(float, float) -> int;
    callback clicked(int);
    // Ctrl+Z after a click.
    callback undone;
    property <float> scale: self.width / 1px / view.width;
    property <float> mx: ta.mouse-x / 1px / scale;
    property <float> my: ta.mouse-y / 1px / scale;
    property <int> hover: ta.has-hover ? root.hit(self.mx, self.my) : -1;
    property <int> action: ta.has-hover ? root.action-hit(self.mx, self.my) : -1;
    // Whole pixels, so the next view starts on one.
    height: round(self.width * view.height / view.width / 1phx) * 1phx;

    Image {
        width: 100%;
        height: 100%;
        source: root.view.image;
    }
    for s in root.spots: Path {
        property <bool> held: s.chip >= 0 && root.chips[s.chip].on;
        property <bool> lit: s.chip >= 0 && s.chip == root.action;
        visible: s.view == root.index && (self.held || self.lit);
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: root.view.width;
        viewbox-height: root.view.height;
        commands: s.commands;
        fill: self.held ? Theme.accent-wash : Theme.hover;
        stroke: Theme.accent;
        stroke-width: self.held ? 2.4px : 1.2px;
    }
    // Under the pointer only: a tip that stays covers the buttons beside it.
    for s in root.spots: ViewTip {
        visible: root.live && s.view == root.index && s.row == root.hover;
        text: s.chip < 0 ? "A step can't hold " + s.label : (root.chips[s.chip].on ? "Stop holding " : "Hold ") + s.label + " in step " + root.step;
        x0: s.x0 * root.scale * 1px;
        y0: s.y0 * root.scale * 1px;
        x1: s.x1 * root.scale * 1px;
        y1: s.y1 * root.scale * 1px;
        view-width: root.width;
        view-height: root.height;
    }
    ta := TouchArea {
        mouse-cursor: root.action >= 0 ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.action >= 0) {
                root.clicked(root.action);
                fs.focus();
            }
        }
    }
    // A click takes the keyboard, so Ctrl+Z undoes it. Tab skips the views: the chips of
    // the step panel are their keyboard path.
    fs := FocusScope {
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(e) => {
            if (e.modifiers.control && (e.text == "z" || e.text == "Z")) {
                root.undone();
                return accept;
            }
            reject
        }
    }
}

// A line of text in the header.
component FieldLabel inherits Text {
    color: Theme.fg;
    vertical-alignment: center;
}

// One header line: its label in a fixed column, then its fields.
component Field inherits HorizontalLayout {
    in property <string> label;
    // The fields take the whole width, not their own.
    in property <bool> fill;
    spacing: 16px;
    // At the top, level with the first line of a field that wraps.
    VerticalLayout {
        alignment: start;
        horizontal-stretch: 0;
        // At least the column's width, more when the desktop font is larger.
        FieldLabel {
            min-width: 120px;
            height: Theme.control-height;
            text: root.label;
        }
    }
    HorizontalLayout {
        horizontal-stretch: 1;
        spacing: 8px;
        alignment: root.fill ? LayoutAlignment.stretch : LayoutAlignment.start;
        @children
    }
}

// The selected macro: its name, the buttons that start it, how often it plays.
component MacroHeader inherits Frame {
    in property <MacroRow> item;
    in property <bool> editable;
    in property <int> name-max;
    in property <int> count-min;
    in property <int> count-max;
    in property <int> pause-max;
    // A narrow window: Import and Export show their icons only.
    in property <bool> narrow;
    callback imported;
    callback exported;
    callback reverted;
    callback deleted;
    callback renamed(string);
    callback plays-picked(int);
    callback count-changed(int);
    callback pause-changed(int);
    // An entry of `item.addable`, and a chip's index.
    callback button-added(int);
    callback button-removed(int);
    // The pickers and the name field follow another macro once one is picked.
    property <string> name: item.name;
    property <int> plays: item.plays;
    changed name => { if (name-field.text != self.name) { name-field.text = self.name; } }
    changed plays => { plays-box.current-index = self.plays; }

    VerticalLayout {
        Rectangle {
            height: 40px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                SmallHead {
                    text: "Macro " + root.item.number;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 4px;
                        Button {
                            text: "Import macro…";
                            icon: Icons.import;
                            icon-only: root.narrow;
                            flat: true;
                            enabled: root.editable;
                            clicked => { root.imported(); }
                        }
                        Button {
                            text: "Export macro…";
                            icon: Icons.export;
                            icon-only: root.narrow;
                            flat: true;
                            enabled: root.editable;
                            clicked => { root.exported(); }
                        }
                        Button {
                            text: "Revert";
                            icon: Icons.discard;
                            flat: true;
                            enabled: root.editable && root.item.unsaved;
                            clicked => { root.reverted(); }
                        }
                        Button {
                            text: "Delete";
                            icon: Icons.clear;
                            flat: true;
                            enabled: root.editable;
                            clicked => { root.deleted(); }
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line-soft;
            }
        }
        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            Field {
                label: "Name";
                HorizontalLayout {
                    spacing: 8px;
                    name-field := LineEdit {
                        width: 240px;
                        text: root.item.name;
                        enabled: root.editable;
                        accessible-name: "Macro name";
                        edited(t) => {
                            root.renamed(t);
                            // Rust cuts the name to the limit.
                            if (self.text != root.item.name) {
                                self.text = root.item.name;
                            }
                        }
                    }
                    Text {
                        text: name-field.text.character-count + "/" + root.name-max;
                        font-size: Theme.text-small;
                        color: Theme.fg-muted;
                        vertical-alignment: center;
                    }
                }
            }
            Field {
                label: "Starts with";
                fill: true;
                // Each chip as wide as its label, then the picker, as many to a line as fit.
                FlexboxLayout {
                    spacing: 6px;
                    cross-axis-alignment: center;
                    for b[i] in root.item.buttons: Rectangle {
                        height: 30px;
                        border-width: 1px;
                        border-radius: Theme.radius;
                        border-color: Theme.accent;
                        background: Theme.accent-wash;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 2px;
                            spacing: 2px;
                            Text {
                                text: b;
                                font-weight: 600;
                                color: Theme.fg;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: "Remove " + b;
                                    icon: Icons.close;
                                    icon-only: true;
                                    flat: true;
                                    enabled: root.editable;
                                    clicked => { root.button-removed(i); }
                                }
                            }
                        }
                    }
                    if root.item.buttons.length == 0: ButtonChip {
                        text: "No button";
                        muted: true;
                    }
                    ComboBox {
                        width: 180px;
                        menu: true;
                        model: root.item.addable;
                        current-index: 0;
                        enabled: root.editable && root.item.addable.length > 1;
                        accessible-name: "Add a button";
                        selected => {
                            root.button-added(self.current-index);
                            self.current-index = 0;
                        }
                    }
                }
            }
            Field {
                label: "Plays";
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    plays-box := ComboBox {
                        width: 180px;
                        model: ["Once", "A number of times", "Until pressed again"];
                        current-index: root.item.plays;
                        enabled: root.editable;
                        accessible-name: "Plays";
                        selected => {
                            root.plays-picked(self.current-index);
                            self.current-index = root.item.plays;
                        }
                    }
                    if root.item.plays == 1: NumberEdit {
                        value: root.item.count;
                        minimum: root.count-min;
                        maximum: root.count-max;
                        enabled: root.editable;
                        step: 1;
                        accessible-name: "Times";
                        committed(v) => { root.count-changed(v); }
                    }
                    if root.item.plays == 1: FieldLabel {
                        text: "times";
                    }
                }
            }
            if root.item.plays != 0: Field {
                label: "Interval";
                NumberEdit {
                    value: root.item.pause;
                    minimum: 0;
                    maximum: root.pause-max;
                    enabled: root.editable;
                    step: 5;
                    accessible-name: "Interval between plays in milliseconds";
                    committed(v) => { root.pause-changed(v); }
                }
                FieldLabel {
                    text: "ms";
                }
            }
        }
    }
}

export component MacrosTab {
    in property <[MacroRow]> rows;
    in property <[PadView]> views;
    in property <[MacroSpot]> spots;
    // The slot's macros can be edited now: their steps are read.
    in property <bool> editable;
    in property <int> name-max;
    in property <int> count-min;
    in property <int> count-max;
    in property <int> pause-max;
    // The selected macro slot (0-based).
    in-out property <int> selected: 0;
    // A narrow window: the left column gets narrower. Rust sets it, as the tab's own
    // width would form a layout loop.
    in property <bool> narrow;
    // The step table of the selected macro.
    in property <[StepInfo]> step-rows;
    in property <[string]> step-lanes;
    in property <string> step-count;
    in property <bool> steps-full;
    in property <bool> steps-ready;
    in-out property <int> selected-step: 0;
    in property <bool> can-undo-step;
    // A step edit: the macro slot, the step, and the edit (see `StepTable.edited`); and
    // Ctrl+Z on macro slot n.
    callback step-edited(int, int, int);
    callback step-undone(int);
    // The step panel of the selected step: its title, duration and held buttons.
    in property <int> step-ms-min;
    in property <int> step-ms-max;
    in property <[ChipInfo]> panel-chips;
    // A panel edit: the macro slot, the step, and the duration or the chip.
    callback step-duration-changed(int, int, int);
    callback step-chip-toggled(int, int, int);
    // The stick pads of the selected step, and their edits: the macro slot, the step and
    // the stick (0 left, 1 right) first.
    in property <[PadStick]> step-sticks;
    callback stick-set(int, int, int, int, int, bool);
    callback stick-dragged(int, int, int, float, float, bool);
    callback stick-glided(int, int, int, bool);
    // A stick the macro moves sits under the dead zone floor: the bar's words and its
    // action, which raises the low ends of macro slot n to the floor.
    in property <string> floor-title;
    in property <string> floor-body;
    in property <string> floor-action;
    callback floor-raised(int);
    // Asks the page to scroll the step panel into view (absolute y, height).
    callback reveal(length, length);
    // The button row under (x, y) in view `view`'s viewBox units, or -1; and the chip of
    // "Buttons held" there, when a click toggles it in step `step` of macro slot `macro`
    // (0-based), or -1.
    pure callback hit(int, float, float) -> int;
    pure callback action-hit(int, int, int, float, float) -> int;
    // Each takes the selected macro slot (0-based) first.
    callback created(int);
    callback imported(int);
    callback exported(int);
    callback reverted(int);
    callback deleted(int);
    callback renamed(int, string);
    callback plays-picked(int, int);
    callback count-changed(int, int);
    callback pause-changed(int, int);
    callback button-added(int, int);
    callback button-removed(int, int);
    property <MacroRow> current: root.rows[root.selected];
    // A step is shown, and can be edited: the views toggle its held buttons.
    property <bool> has-step: root.current.filled && root.panel-chips.length > 0;
    property <bool> live: root.has-step && root.editable;

    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            // A fixed width, so the views keep their size from macro to macro.
            width: root.narrow ? 224px : 320px;
            alignment: start;
            spacing: 6px;
            SmallHead {
                text: "Macro slots";
            }
            Frame {
                list-fs := FocusScope {
                    key-pressed(e) => {
                        if (e.text == Key.DownArrow && root.selected < root.rows.length - 1) {
                            root.selected += 1;
                            return accept;
                        }
                        if (e.text == Key.UpArrow && root.selected > 0) {
                            root.selected -= 1;
                            return accept;
                        }
                        reject
                    }
                    VerticalLayout {
                        accessible-role: list;
                        accessible-label: "Macro slots";
                        for r[i] in root.rows: MacroSlotRow {
                            item: r;
                            selected: i == root.selected;
                            last: i == root.rows.length - 1;
                            focused: list-fs.has-focus;
                            picked => {
                                root.selected = i;
                                list-fs.focus();
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 6px;
            }
            SmallHead {
                text: "Buttons held";
            }
            // Why a click does nothing.
            if !root.live: Text {
                text: !root.current.filled ? "Create a macro to choose the buttons its steps hold."
                    : !root.steps-ready || !root.editable ? "The buttons show once the steps are read."
                    : "Pick a step in the table to see the buttons it holds.";
                font-size: Theme.text-small;
                color: Theme.fg-muted;
                wrap: word-wrap;
            }
            Frame {
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    for v[i] in root.views: VerticalLayout {
                        spacing: 4px;
                        SmallHead {
                            text: v.label;
                        }
                        MacroViewArt {
                            view: v;
                            index: i;
                            spots: root.spots;
                            chips: root.panel-chips;
                            step: root.selected-step + 1;
                            live: root.live;
                            // Dimmed like the step panel's chips when clicks do nothing.
                            opacity: root.live ? 1 : 0.45;
                            hit(x, y) => { return root.hit(i, x, y); }
                            action-hit(x, y) => { return root.action-hit(i, root.selected, root.selected-step, x, y); }
                            clicked(c) => { root.step-chip-toggled(root.selected, root.selected-step, c); }
                            undone => { root.step-undone(root.selected); }
                        }
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 12px;
            if root.current.filled: MacroHeader {
                item: root.current;
                editable: root.editable;
                name-max: root.name-max;
                count-min: root.count-min;
                count-max: root.count-max;
                pause-max: root.pause-max;
                narrow: root.narrow;
                imported => { root.imported(root.selected); }
                exported => { root.exported(root.selected); }
                reverted => { root.reverted(root.selected); }
                deleted => { root.deleted(root.selected); }
                renamed(t) => { root.renamed(root.selected, t); }
                plays-picked(p) => { root.plays-picked(root.selected, p); }
                count-changed(v) => { root.count-changed(root.selected, v); }
                pause-changed(v) => { root.pause-changed(root.selected, v); }
                button-added(c) => { root.button-added(root.selected, c); }
                button-removed(c) => { root.button-removed(root.selected, c); }
            }
            if root.current.filled && root.floor-title != "": MessageBar {
                title: root.floor-title;
                body: root.floor-body;
                action: root.floor-action;
                action-enabled: root.editable;
                acted => { root.floor-raised(root.selected); }
            }
            if root.current.filled: StepTable {
                rows: root.step-rows;
                lanes: root.step-lanes;
                count: root.step-count;
                full: root.steps-full;
                ready: root.steps-ready;
                editable: root.editable;
                selected <=> root.selected-step;
                can-undo: root.can-undo-step;
                edited(e) => { root.step-edited(root.selected, root.selected-step, e); }
                undone => { root.step-undone(root.selected); }
                duration-min: root.step-ms-min;
                duration-max: root.step-ms-max;
                duration-changed(v) => { root.step-duration-changed(root.selected, root.selected-step, v); }
            }
            if root.current.filled && root.step-sticks.length > 0: StepPanel {
                sticks: root.step-sticks;
                enabled: root.live;
                step: root.selected-step;
                narrow: root.narrow;
                stick-set(k, x, y, apart) => { root.stick-set(root.selected, root.selected-step, k, x, y, apart); }
                stick-dragged(k, x, y, snap) => { root.stick-dragged(root.selected, root.selected-step, k, x, y, snap); }
                stick-glided(k, on) => { root.stick-glided(root.selected, root.selected-step, k, on); }
                step-picked(n) => { root.selected-step = n; }
                reveal(y, h) => { root.reveal(y, h); }
            }
            if !root.current.filled: Frame {
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: center;
                    Text {
                        // A staged delete: the controller still holds the macro.
                        text: root.current.unsaved
                            ? "Macro " + root.current.number + " will be deleted when you write"
                            : "Macro " + root.current.number + " is empty";
                        font-size: Theme.text-placeholder;
                        color: Theme.fg;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        if root.current.unsaved: Button {
                            text: "Undo";
                            icon: Icons.discard;
                            enabled: root.editable;
                            clicked => { root.reverted(root.selected); }
                        }
                        Button {
                            text: "Import macro…";
                            icon: Icons.import;
                            enabled: root.editable;
                            clicked => { root.imported(root.selected); }
                        }
                        Button {
                            text: "New macro";
                            primary: true;
                            enabled: root.editable;
                            clicked => { root.created(root.selected); }
                        }
                    }
                }
            }
        }
    }
}
