// Review, clear, cross-mode import, failed write and About.
import { AboutSlint } from "std-widgets.slint";
import { Theme, Button, ComboBox, LineEdit } from "look/breeze/widgets.slint";
import { Icons, DialogShell, ChangeTable, Frame } from "parts.slint";
import { Change, ImportWarning } from "types.slint";

component Bullet {
    in property <string> text;
    in property <string> aside;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: "•";
            color: Theme.fg-muted;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text + (root.aside != "" ? " " + root.aside : "");
            color: Theme.fg;
            wrap: word-wrap;
        }
    }
}

export component ReviewDialog inherits DialogShell {
    in property <string> slot-title;
    in property <string> profile-name;
    in property <[Change]> changes;
    in property <int> macro-count;
    in property <string> macro-note;
    title: "Write " + changes.length + " changes to " + slot-title + "?";
    subtitle: "This replaces the profile “" + profile-name + "” stored on the controller.";
    accept-text: "Write to controller";
    ChangeTable {
        model: root.changes;
    }
    Bullet {
        text: "The " + root.macro-count + " macros on this slot stay.";
        aside: root.macro-note;
    }
    Bullet {
        text: "A backup of the slot is saved first, and the slot is read back after the write.";
    }
    Bullet {
        text: "The controller applies the profile while its profile light is on.";
    }
}

export component ClearDialog inherits DialogShell {
    in property <string> slot-title;
    in property <string> profile-name;
    in property <int> macro-count;
    icon: Icons.warning;
    destructive: true;
    title: "Clear " + slot-title + "?";
    subtitle: "This removes the profile “" + profile-name + "” from the controller. Export it first if you may want it back.";
    accept-text: "Clear slot";
    extra-text: "Export…";
    extra-icon: Icons.export;
    Bullet {
        text: "The slot’s " + root.macro-count + " macros stay stored, but the next profile written to this slot removes them.";
    }
}

export component ImportDialog inherits DialogShell {
    in property <ImportWarning> warning;
    icon: Icons.info;
    title: "Import the " + warning.from-mode + " profile into " + warning.slot-title + "?";
    subtitle: "“" + warning.file-name + "” comes from " + warning.from-mode + " mode. Each button keeps its place on the controller.";
    accept-text: "Import";
    if root.warning.lost.length > 0: Text {
        text: root.warning.lost.length == 1
            ? "1 button has no " + root.warning.to-mode + " match and becomes Disabled:"
            : root.warning.lost.length + " buttons have no " + root.warning.to-mode + " match and become Disabled:";
        color: Theme.fg;
        wrap: word-wrap;
    }
    if root.warning.lost.length > 0: ChangeTable {
        model: root.warning.lost;
    }
    if root.warning.triggers-reset: Bullet {
        text: root.warning.to-mode + " sets the triggers another way, so they start from the " + root.warning.to-mode + " defaults.";
    }
    if root.warning.letters != "": Bullet {
        text: "Some printed letters name another button: " + root.warning.letters + ".";
    }
    if root.warning.skipped-macros > 0: Bullet {
        text: "The file’s macro references are skipped. The macros stored on the controller stay.";
    }
    Text {
        text: "Nothing reaches the controller until you write.";
        color: Theme.fg-muted;
    }
}

export component FailedDialog inherits DialogShell {
    in property <string> slot-title;
    in property <string> detail;
    in property <string> backup-path;
    icon: Icons.error;
    alarm: true;
    card-width: 560px;
    title: "Writing to " + slot-title + " failed";
    subtitle: detail;
    cancel-text: "Close";
    accept-text: "Write again";
    extra-text: "Open folder";
    extra-icon: Icons.folder;
    Text {
        text: "The old profile is saved in this file:";
        color: Theme.fg;
    }
    HorizontalLayout {
        spacing: 6px;
        path := LineEdit {
            text: root.backup-path;
            read-only: true;
            mono: true;
            wrap: true;
            accessible-name: "Backup file";
        }
        Button {
            text: "Copy";
            icon: Icons.copy;
            clicked => { path.copy-all(); }
        }
    }
    Text {
        text: "Your edits are still here, so you can write again.";
        color: Theme.fg-muted;
        wrap: word-wrap;
    }
}

export component MoveDialog inherits DialogShell {
    // The short controller name, and each unplugged controller that holds edits.
    in property <string> name;
    in property <[string]> from;
    callback picked(int);
    icon: Icons.pad;
    title: from.length == 1
        ? "Is this the " + name + " you unplugged?"
        : "Is this one of the " + name + "s you unplugged?";
    subtitle: from.length == 1
        ? "It is plugged into another USB port. Your edits that are not written yet can move to it."
        : "It is plugged into another USB port. Pick the one it is, and that one’s edits move to it.";
    cancel-text: from.length == 1 ? "No, keep both" : "None of them";
    accept-text: from.length == 1 ? "Yes, move the edits" : "";
    if root.from.length == 1: Text {
        text: root.from[0];
        color: Theme.fg-muted;
        wrap: word-wrap;
    }
    if root.from.length > 1: VerticalLayout {
        spacing: 6px;
        for f[i] in root.from: Button {
            text: f;
            clicked => { root.picked(i); }
        }
    }
}

export component ChangedDialog inherits DialogShell {
    // Each slot whose stored profile changed under its edits, and the answer
    // picked for it: true keeps the edits.
    in property <[string]> slots;
    in property <[bool]> keep;
    callback picked(int, bool);
    icon: Icons.warning;
    title: slots.length == 1 ? "A slot changed outside 8B" : slots.length + " slots changed outside 8B";
    subtitle: "Another program wrote to the controller after you started editing. Pick what each slot keeps. “Keep mine” keeps your whole copy of the slot, so writing it later replaces the controller’s version.";
    cancel-text: "";
    accept-text: "Apply";
    for s[i] in root.slots: HorizontalLayout {
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: s;
            color: Theme.fg;
            vertical-alignment: center;
            overflow: elide;
        }
        ComboBox {
            width: 200px;
            model: ["Keep mine", "Take the controller’s"];
            current-index: root.keep[i] ? 0 : 1;
            accessible-name: s;
            selected(v) => { root.picked(i, self.current-index == 0); }
        }
    }
}

export component AboutDialog inherits DialogShell {
    in property <string> version;
    icon: Icons.pad;
    title: "8B";
    subtitle: "Version " + version;
    cancel-text: "Close";
    Text {
        text: "Reads and edits the profiles stored on 8BitDo controllers over USB.";
        color: Theme.fg;
        wrap: word-wrap;
    }
    Text {
        text: "8B is an independent project, not made or endorsed by 8BitDo.";
        color: Theme.fg-muted;
        wrap: word-wrap;
    }
    Frame {
        background: Theme.view;
        height: 104px;
        AboutSlint { }
    }
}
