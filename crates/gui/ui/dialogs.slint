// Review, clear, cross-mode import, failed write, close with edits.
import { Theme, Button, ComboBox, LineEdit, Spinner, ScrollView } from "look/breeze/widgets.slint";
import { Icons, DialogShell, ChangeTable, ChangeRow, Disclosure, Frame, CopyButton, MessageBar, NoteRow } from "parts.slint";
import { Change, ImportWarning, MacroImportInfo, ReviewInfo, ClearInfo, FailedInfo, CloseInfo, CloseSlot } from "types.slint";

export component Bullet {
    in property <string> text;
    in property <string> aside;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: "•";
            color: Theme.fg-muted;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text + (root.aside != "" ? " " + root.aside : "");
            color: Theme.fg;
            wrap: word-wrap;
        }
    }
}

// The file a failed write saved the old profile in, with a Copy button.
export component BackupFile {
    in property <string> path;
    in property <string> text: @tr("The old profile is saved in this file:");
    VerticalLayout {
        spacing: 10px;
        Text {
            text: root.text;
            color: Theme.fg;
        }
        HorizontalLayout {
            spacing: 6px;
            LineEdit {
                text: root.path;
                read-only: true;
                mono: true;
                wrap: true;
                accessible-name: @tr("Backup file");
            }
            CopyButton { source => { root.path } }
        }
    }
}

export component ReviewDialog inherits DialogShell {
    in property <ReviewInfo> info;
    // Section 0 is the profile, 1 the macros.
    callback toggled(int);
    property <bool> has-profile: info.changes.length > 0;
    property <int> macro-lines: info.macro-changes.length + (info.leftover > 0 ? 1 : 0);
    title: info.is-new
        ? @tr("Write “{}” to {}?", info.name, info.slot-title)
        : @tr("Write {n} change to {}?" | "Write {n} changes to {}?" % info.total, info.slot-title);
    subtitle: info.is-new
        ? @tr("The slot is empty. It gets a new profile.")
        : info.keeps-profile
        ? @tr("The profile “{}” stays. Only its macros change.", info.replaces)
        : @tr("This replaces the profile “{}” stored on the controller.", info.replaces);
    accept-text: @tr("Write to controller");
    accept-enabled: root.info.problem == "";
    if root.info.problem != "": Text {
        text: root.info.problem;
        color: Theme.negative-ink;
        wrap: word-wrap;
    }
    if root.has-profile || root.macro-lines > 0: Frame {
        VerticalLayout {
            if root.has-profile: Disclosure {
                title: @tr("Profile");
                note: @tr("{n} change" | "{n} changes" % root.info.changes.length);
                open: root.info.profile-open;
                last: root.macro-lines == 0;
                toggled => { root.toggled(0); }
                for c[i] in root.info.changes: ChangeRow {
                    change: c;
                    rule: i < root.info.changes.length - 1;
                }
            }
            if root.macro-lines > 0: Disclosure {
                title: @tr("Macros");
                note: @tr("{n} change" | "{n} changes" % root.macro-lines);
                open: root.info.macros-open;
                last: true;
                toggled => { root.toggled(1); }
                for r[i] in root.info.macro-changes: NoteRow {
                    text: r;
                    rule: i < root.macro-lines - 1;
                }
                if root.info.leftover > 0: NoteRow {
                    text: @tr("The empty slot still holds {n} macro. Writing a profile removes it."
                        | "The empty slot still holds {n} macros. Writing a profile removes them." % root.info.leftover);
                }
            }
        }
    }
    if root.info.macros-stay > 0: Bullet {
        text: @tr("The macro on this slot stays." | "The {n} macros on this slot stay." % root.info.macros-stay);
    }
}

export component ClearDialog inherits DialogShell {
    in property <ClearInfo> info;
    icon: Icons.warning;
    destructive: true;
    title: @tr("Clear {}?", info.slot-title);
    subtitle: @tr("This removes the profile “{}” from the controller. Export it first if you may want it back.", info.name);
    accept-text: @tr("Clear slot");
    extra-text: @tr("Export…");
    extra-icon: Icons.export;
    if root.info.macros > 0: Bullet {
        text: @tr("The slot’s macro stays stored, but the next profile written to this slot removes it."
            | "The slot’s {n} macros stay stored, but the next profile written to this slot removes them." % root.info.macros);
    }
    if root.info.has-edits: Bullet {
        text: @tr("Your edits to this slot, not written yet, are discarded.");
    }
}

// A same-mode import opens it only when the slot loses something; the conversion
// lines stay empty then.
export component ImportDialog inherits DialogShell {
    in property <ImportWarning> warning;
    property <bool> cross-mode: warning.from-mode != warning.to-mode;
    icon: warning.edit-notes.length > 0 ? Icons.warning : Icons.info;
    title: cross-mode
        ? @tr("Import the {} profile into {}?", warning.from-mode, warning.slot-title)
        : @tr("Import “{}” into {}?", warning.file-name, warning.slot-title);
    subtitle: cross-mode ? @tr("“{}” comes from {} mode. Each button keeps its place on the controller.", warning.file-name, warning.from-mode) : "";
    accept-text: @tr("Import");
    // Keeps the slot's macros. Offered whenever the macro lead says what
    // Import replaces.
    extra-text: warning.macro-lead != "" ? @tr("Import without macros") : "";
    if root.warning.macro-lead != "": Text {
        text: root.warning.macro-lead;
        color: Theme.fg;
        wrap: word-wrap;
    }
    for note in root.warning.macro-notes: Bullet {
        text: note;
    }
    if root.warning.keep-note != "": Text {
        text: root.warning.keep-note;
        color: Theme.fg;
        wrap: word-wrap;
    }
    for note in root.warning.edit-notes: Bullet {
        text: note;
    }
    if root.warning.lost.length > 0: Text {
        text: @tr("{n} button has no {} match and becomes Disabled:"
            | "{n} buttons have no {} match and become Disabled:" % root.warning.lost.length, root.warning.to-mode);
        color: Theme.fg;
        wrap: word-wrap;
    }
    if root.warning.lost.length > 0: ChangeTable {
        model: root.warning.lost;
    }
    if root.warning.reset != "": Bullet {
        text: @tr("{0} sets these settings another way, so they start from the {0} defaults: {1}.", root.warning.to-mode, root.warning.reset);
    }
    if root.warning.letters != "": Bullet {
        text: @tr("Some printed letters name another button: {}.", root.warning.letters);
    }
    Text {
        text: @tr("Nothing reaches the controller until you write.");
        color: Theme.fg-muted;
    }
}

// A macro file picked for a macro slot: what it holds and what changes, or why it
// cannot be imported.
export component MacroImportDialog inherits DialogShell {
    in property <MacroImportInfo> info;
    property <bool> ok: info.errors.length == 0;
    icon: ok ? Icons.info : Icons.error;
    alarm: !ok;
    title: ok
        ? @tr("Import “{}” into Macro {}?", info.name, info.number)
        : @tr("Could not import “{}”", info.file-name);
    subtitle: ok
        ? @tr("“{}”, made in {} mode: {n} step, started by {}." | "“{}”, made in {} mode: {n} steps, started by {}." % info.steps, info.file-name, info.from-mode, info.buttons != "" ? info.buttons : @tr("no button"))
        : "";
    // One button closes a bad file's dialog, as in the other one-button dialogs.
    accept-text: ok ? @tr("Import") : @tr("Close");
    cancel-text: ok ? @tr("Cancel") : "";
    diagnostics: !ok;
    // Every reason, one per row, in a box that scrolls past a few rows.
    if !root.ok: Frame {
        height: min(errors.preferred-height, 200px);
        ScrollView {
            width: parent.width;
            height: parent.height;
            // As wide as the box, so each wrapped reason gets its full height.
            errors := VerticalLayout {
                width: parent.width;
                for e[i] in root.info.errors: NoteRow {
                    text: e;
                    rule: i < root.info.errors.length - 1;
                }
            }
        }
    }
    if root.ok && root.info.replaces != "": Bullet {
        text: root.info.replaces;
    }
    if root.ok && root.info.replaces-unsaved: Bullet {
        text: @tr("Your edits to Macro {}, not written yet, are discarded.", root.info.number);
    }
    if root.ok && root.info.from-mode != root.info.to-mode: Bullet {
        text: @tr("Each button keeps its place on the controller and takes its {} label.", root.info.to-mode);
    }
    if root.ok && root.info.letters != "": Bullet {
        text: @tr("Some printed letters name another button: {}.", root.info.letters);
    }
    if root.ok && root.info.full-presses > 0: Bullet {
        text: @tr("{} triggers are on or off, so {n} step presses its trigger fully."
            | "{} triggers are on or off, so {n} steps press their triggers fully." % root.info.full-presses, root.info.to-mode);
    }
    if root.ok && root.info.glides != "": Bullet {
        text: @tr("Trigger glides that {} cannot play are dropped: {}.", root.info.to-mode, root.info.glides);
    }
    for d in root.ok ? root.info.dropped : []: Bullet {
        text: d;
    }
    if root.ok: Text {
        text: @tr("Nothing reaches the controller until you write.");
        color: Theme.fg-muted;
    }
}

export component FailedDialog inherits DialogShell {
    in property <FailedInfo> info;
    icon: Icons.error;
    alarm: true;
    card-width: 560px;
    title: info.is-clear ? @tr("Clearing {} failed", info.slot-title) : @tr("Writing to {} failed", info.slot-title);
    subtitle: info.detail;
    cancel-text: @tr("Close");
    accept-text: info.is-clear ? @tr("Try again") : @tr("Write again");
    extra-text: info.backup-path != "" || info.macro-backups.length > 0 ? @tr("Open folder") : "";
    extra-icon: Icons.folder;
    diagnostics: true;
    if root.info.backup-path != "": BackupFile {
        path: root.info.backup-path;
    }
    for p in root.info.macro-backups: BackupFile {
        path: p;
        text: @tr("The old macro is saved in this file:");
    }
    if !root.info.is-clear: Text {
        text: @tr("Your edits are still here, so you can write again.");
        color: Theme.fg-muted;
        wrap: word-wrap;
    }
}

// The worker thread has ended, so no command reaches the controller. It is not
// restarted: the same packet could panic again.
export component StoppedDialog inherits DialogShell {
    icon: Icons.error;
    alarm: true;
    title: @tr("8B stopped talking to the controller");
    subtitle: @tr("Restart 8B.");
    cancel-text: "";
    accept-text: @tr("Close");
    diagnostics: true;
}

// Shown while a write runs. Blocks the window: nothing may change under the write.
export component WritingDialog inherits DialogShell {
    in property <string> text;
    icon: Icons.pad;
    title: text;
    subtitle: @tr("Keep the controller plugged in.");
    cancel-text: "";
    accept-text: "";
    HorizontalLayout {
        alignment: center;
        Spinner {
            width: 24px;
            height: 24px;
        }
    }
}

// Explains the keepalive fix before it is installed: what the reconnecting looks like,
// the two files, and the command. Outside the sandbox the accept button installs it.
export component FixDialog inherits DialogShell {
    in property <bool> sandboxed;
    in property <bool> installing;
    // Why the last install failed, empty when it did not.
    in property <string> error;
    in property <string> command;
    in property <string> rule-path;
    in property <string> unit-path;
    icon: Icons.info;
    card-width: 560px;
    title: @tr("Keep the controller connected");
    subtitle: @tr("When no app is using it, this controller disconnects and reconnects every second or two. An app that starts then may not see it.");
    cancel-text: @tr("Close");
    // The password prompt is open: leaving would hide how it ends.
    cancel-enabled: !root.installing;
    accept-text: root.sandboxed ? "" : @tr("Add files…");
    accept-enabled: !root.installing;
    Text {
        text: @tr("While 8B is open, the controller stays connected. These two files keep it connected whenever it is plugged in. They change nothing else, and deleting them undoes it.")
            + (root.sandboxed ? "" : " " + @tr("Adding them asks for your password once."));
        color: Theme.fg;
        wrap: word-wrap;
    }
    VerticalLayout {
        spacing: 2px;
        Text {
            text: root.rule-path;
            font-family: Theme.mono-family;
            color: Theme.fg;
            wrap: word-wrap;
        }
        Text {
            text: root.unit-path;
            font-family: Theme.mono-family;
            color: Theme.fg;
            wrap: word-wrap;
        }
    }
    // A slot as tall as a two-line bar, so the bar appearing moves nothing.
    VerticalLayout {
        min-height: 50px;
        if root.error != "": MessageBar {
            error: true;
            title: @tr("Could not add the files.");
            body: root.error + " " + @tr("Run the command instead.");
        }
    }
    VerticalLayout {
        spacing: 10px;
        Text {
            text: root.sandboxed ? @tr("Run this in a terminal on this computer:") : @tr("Or run this in a terminal:");
            color: Theme.fg;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 6px;
            command := LineEdit {
                text: root.command;
                read-only: true;
                mono: true;
                wrap: true;
                accessible-name: @tr("Command that adds the files");
            }
            CopyButton { source => { root.command } }
        }
    }
}

export component MoveDialog inherits DialogShell {
    // The short controller name, and each unplugged controller that holds edits.
    in property <string> name;
    in property <[string]> from;
    callback picked(int);
    icon: Icons.pad;
    title: from.length == 1
        ? @tr("Is this the {} controller you unplugged?", name)
        : @tr("Is this one of the {} controllers you unplugged?", name);
    subtitle: from.length == 1
        ? @tr("It is plugged into another USB port. Your edits that are not written yet can move to it.")
        : @tr("It is plugged into another USB port. Pick the one it is, and that one’s edits move to it.");
    cancel-text: from.length == 1 ? @tr("No, keep both") : @tr("None of them");
    accept-text: from.length == 1 ? @tr("Yes, move the edits") : "";
    if root.from.length == 1: Text {
        text: root.from[0];
        color: Theme.fg-muted;
        wrap: word-wrap;
    }
    if root.from.length > 1: VerticalLayout {
        spacing: 6px;
        for f[i] in root.from: Button {
            text: f;
            clicked => { root.picked(i); }
        }
    }
}

export component ChangedDialog inherits DialogShell {
    // Each slot whose stored profile changed under its edits, and the answer
    // picked for it: true keeps the edits.
    in property <[string]> slots;
    in property <[bool]> keep;
    callback picked(int, bool);
    icon: Icons.warning;
    title: @tr("A slot changed outside 8B" | "{n} slots changed outside 8B" % slots.length);
    subtitle: @tr("Another program wrote to the controller after you started editing. Pick what each slot keeps. “Keep mine” keeps your whole copy of the slot, so writing it later replaces the controller’s version.");
    cancel-text: "";
    accept-text: @tr("Apply");
    for s[i] in root.slots: HorizontalLayout {
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: s;
            color: Theme.fg;
            vertical-alignment: center;
            overflow: elide;
        }
        ComboBox {
            width: 200px;
            model: [@tr("Keep mine"), @tr("Take the controller’s")];
            current-index: root.keep[i] ? 0 : 1;
            accessible-name: s;
            selected(v) => { root.picked(i, self.current-index == 0); }
        }
    }
}

// A read-only row of the close question: the slot, then the name of its edits.
component CloseSlotRow inherits Rectangle {
    in property <CloseSlot> slot;
    // The last row has no rule under it.
    in property <bool> last;
    min-height: 32px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.slot.title;
            font-weight: 600;
            color: Theme.fg;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.slot.name != "" ? " · " + root.slot.name : "";
            color: Theme.fg-muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

// The window was asked to close while edits are not written. Discard and close is
// red in both forms: on the left beside "Write n slots…", or as the accept alone.
export component CloseDialog inherits DialogShell {
    in property <CloseInfo> info;
    callback write;
    callback discard;
    property <bool> many: info.groups.length > 1;
    icon: Icons.warning;
    alarm: true;
    destructive: info.write == 0;
    extra-destructive: true;
    title: @tr("Close 8B without writing?");
    subtitle: many
        ? @tr("{n} slot on {} controllers has unsaved edits. The edits are not on a controller yet, so closing 8B discards them."
            | "{n} slots on {} controllers have unsaved edits. The edits are not on a controller yet, so closing 8B discards them." % info.total, info.groups.length)
        : @tr("{n} slot has unsaved edits. The edits are not on the controller yet, so closing 8B discards them."
            | "{n} slots have unsaved edits. The edits are not on the controller yet, so closing 8B discards them." % info.total);
    extra-text: info.write > 0 ? @tr("Discard and close") : "";
    accept-text: info.write == 0 ? @tr("Discard and close")
        : @tr("Write {n} slot…" | "Write {n} slots…" % info.write);
    extra => { root.discard(); }
    accepted => {
        if (root.info.write > 0) {
            root.write();
        } else {
            root.discard();
        }
    }
    for g in root.info.groups: VerticalLayout {
        spacing: 4px;
        if root.many: Text {
            text: g.label;
            font-size: Theme.text-caption;
            font-weight: 600;
            color: Theme.fg-muted;
        }
        Frame {
            VerticalLayout {
                for s[i] in g.slots: CloseSlotRow {
                    slot: s;
                    last: i == g.slots.length - 1;
                }
            }
        }
    }
}
