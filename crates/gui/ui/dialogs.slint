// Review, clear, cross-mode import, failed write.
import { Theme, Button, ComboBox, LineEdit } from "look/breeze/widgets.slint";
import { Icons, DialogShell, ChangeTable, Frame } from "parts.slint";
import { Change, ImportWarning, ReviewInfo, ClearInfo, FailedInfo } from "types.slint";

export component Bullet {
    in property <string> text;
    in property <string> aside;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: "•";
            color: Theme.fg-muted;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text + (root.aside != "" ? " " + root.aside : "");
            color: Theme.fg;
            wrap: word-wrap;
        }
    }
}

// The file a failed write saved the old profile in, with a Copy button.
export component BackupFile {
    in property <string> path;
    VerticalLayout {
        spacing: 10px;
        Text {
            text: "The old profile is saved in this file:";
            color: Theme.fg;
        }
        HorizontalLayout {
            spacing: 6px;
            field := LineEdit {
                text: root.path;
                read-only: true;
                mono: true;
                wrap: true;
                accessible-name: "Backup file";
            }
            Button {
                text: "Copy";
                icon: Icons.copy;
                clicked => { field.copy-all(); }
            }
        }
    }
}

export component ReviewDialog inherits DialogShell {
    in property <ReviewInfo> info;
    title: info.is-new
        ? "Write “" + info.name + "” to " + info.slot-title + "?"
        : "Write " + info.changes.length + (info.changes.length == 1 ? " change" : " changes") + " to " + info.slot-title + "?";
    subtitle: info.is-new
        ? "The slot is empty. It gets a new profile."
        : "This replaces the profile “" + info.replaces + "” stored on the controller.";
    accept-text: "Write to controller";
    accept-enabled: root.info.problem == "";
    if root.info.problem != "": Text {
        text: root.info.problem;
        color: Theme.negative;
        wrap: word-wrap;
    }
    if !root.info.is-new: ChangeTable {
        model: root.info.changes;
    }
    if root.info.macros-stay > 0: Bullet {
        text: root.info.macros-stay == 1
            ? "The macro on this slot stays."
            : "The " + root.info.macros-stay + " macros on this slot stay.";
    }
    for r in root.info.removed: Bullet {
        text: r + ".";
    }
    if root.info.leftover > 0: Bullet {
        text: root.info.leftover == 1
            ? "The empty slot still holds 1 macro. Writing a profile removes it."
            : "The empty slot still holds " + root.info.leftover + " macros. Writing a profile removes them.";
    }
    Bullet {
        text: "If the write fails, 8B puts the old profile back. If it cannot, it saves the old profile to a file.";
    }
    Bullet {
        text: "8B reads the controller again after the write.";
    }
    Bullet {
        text: "The controller uses the profile while that slot’s light is on.";
    }
}

export component ClearDialog inherits DialogShell {
    in property <ClearInfo> info;
    icon: Icons.warning;
    destructive: true;
    title: "Clear " + info.slot-title + "?";
    subtitle: "This removes the profile “" + info.name + "” from the controller. Export it first if you may want it back.";
    accept-text: "Clear slot";
    extra-text: "Export…";
    extra-icon: Icons.export;
    if root.info.macros > 0: Bullet {
        text: root.info.macros == 1
            ? "The slot’s macro stays stored, but the next profile written to this slot removes it."
            : "The slot’s " + root.info.macros + " macros stay stored, but the next profile written to this slot removes them.";
    }
    if root.info.has-edits: Bullet {
        text: "Your edits to this slot, not written yet, are discarded.";
    }
}

export component ImportDialog inherits DialogShell {
    in property <ImportWarning> warning;
    icon: Icons.info;
    title: "Import the " + warning.from-mode + " profile into " + warning.slot-title + "?";
    subtitle: "“" + warning.file-name + "” comes from " + warning.from-mode + " mode. Each button keeps its place on the controller.";
    accept-text: "Import";
    if root.warning.lost.length > 0: Text {
        text: root.warning.lost.length == 1
            ? "1 button has no " + root.warning.to-mode + " match and becomes Disabled:"
            : root.warning.lost.length + " buttons have no " + root.warning.to-mode + " match and become Disabled:";
        color: Theme.fg;
        wrap: word-wrap;
    }
    if root.warning.lost.length > 0: ChangeTable {
        model: root.warning.lost;
    }
    if root.warning.triggers-reset: Bullet {
        text: root.warning.to-mode + " sets the triggers another way, so they start from the " + root.warning.to-mode + " defaults.";
    }
    if root.warning.letters != "": Bullet {
        text: "Some printed letters name another button: " + root.warning.letters + ".";
    }
    if root.warning.skipped-macros > 0: Bullet {
        text: "The file’s macro references are skipped. The macros stored on the controller stay.";
    }
    Text {
        text: "Nothing reaches the controller until you write.";
        color: Theme.fg-muted;
    }
}

export component FailedDialog inherits DialogShell {
    in property <FailedInfo> info;
    icon: Icons.error;
    alarm: true;
    card-width: 560px;
    title: (info.is-clear ? "Clearing " : "Writing to ") + info.slot-title + " failed";
    subtitle: info.detail;
    cancel-text: "Close";
    accept-text: info.is-clear ? "Try again" : "Write again";
    extra-text: info.backup-path != "" ? "Open folder" : "";
    extra-icon: Icons.folder;
    if root.info.backup-path != "": BackupFile {
        path: root.info.backup-path;
    }
    if !root.info.is-clear: Text {
        text: "Your edits are still here, so you can write again.";
        color: Theme.fg-muted;
        wrap: word-wrap;
    }
}

// Shown while a write runs. Blocks the window: nothing may change under the write.
export component WritingDialog inherits DialogShell {
    in property <string> text;
    icon: Icons.pad;
    title: text;
    subtitle: "Keep the controller plugged in. A write from the Switch position takes about 10 seconds.";
    cancel-text: "";
    accept-text: "";
}

export component MoveDialog inherits DialogShell {
    // The short controller name, and each unplugged controller that holds edits.
    in property <string> name;
    in property <[string]> from;
    callback picked(int);
    icon: Icons.pad;
    title: from.length == 1
        ? "Is this the " + name + " you unplugged?"
        : "Is this one of the " + name + "s you unplugged?";
    subtitle: from.length == 1
        ? "It is plugged into another USB port. Your edits that are not written yet can move to it."
        : "It is plugged into another USB port. Pick the one it is, and that one’s edits move to it.";
    cancel-text: from.length == 1 ? "No, keep both" : "None of them";
    accept-text: from.length == 1 ? "Yes, move the edits" : "";
    if root.from.length == 1: Text {
        text: root.from[0];
        color: Theme.fg-muted;
        wrap: word-wrap;
    }
    if root.from.length > 1: VerticalLayout {
        spacing: 6px;
        for f[i] in root.from: Button {
            text: f;
            clicked => { root.picked(i); }
        }
    }
}

export component ChangedDialog inherits DialogShell {
    // Each slot whose stored profile changed under its edits, and the answer
    // picked for it: true keeps the edits.
    in property <[string]> slots;
    in property <[bool]> keep;
    callback picked(int, bool);
    icon: Icons.warning;
    title: slots.length == 1 ? "A slot changed outside 8B" : slots.length + " slots changed outside 8B";
    subtitle: "Another program wrote to the controller after you started editing. Pick what each slot keeps. “Keep mine” keeps your whole copy of the slot, so writing it later replaces the controller’s version.";
    cancel-text: "";
    accept-text: "Apply";
    for s[i] in root.slots: HorizontalLayout {
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: s;
            color: Theme.fg;
            vertical-alignment: center;
            overflow: elide;
        }
        ComboBox {
            width: 200px;
            model: ["Keep mine", "Take the controller’s"];
            current-index: root.keep[i] ? 0 : 1;
            accessible-name: s;
            selected(v) => { root.picked(i, self.current-index == 0); }
        }
    }
}
