// Breeze colour sets (Plasma 6), type scale and spacing.
// Light and dark follow `Palette.color-scheme`, which Slint reads from the
// xdg desktop portal.
import { Palette } from "std-widgets.slint";

export global Theme {
    // Set from Rust. False: fixed Breeze blue. True: the desktop accent read
    // from the portal, and the same colour darkened until white text on it
    // reaches 4.5:1.
    in property <bool> desktop-accent: false;
    in property <color> desktop-accent-color;
    in property <color> desktop-accent-fill;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <string> look: "Breeze";

    // Colour sets: window, view, header, button.
    out property <brush> window: dark ? #202326 : #eff0f1;
    out property <brush> view: dark ? #141618 : #ffffff;
    out property <brush> header: dark ? #2b2e31 : #dee0e2;
    out property <brush> button: dark ? #292c30 : #fcfcfc;
    out property <brush> fg: dark ? #fcfcfc : #232629;
    out property <brush> fg-muted: dark ? #a1a9b1 : #5a636c;
    out property <brush> line: dark ? #464a4f : #c6c9cc;
    out property <brush> line-soft: dark ? #34373b : #dcdee0;
    out property <brush> hover: dark ? #1f3442 : #e3f1fa;

    out property <brush> accent: desktop-accent ? desktop-accent-color : #3daee9;
    // Filled buttons and chips: white text needs the darker colour for 4.5:1.
    out property <brush> accent-strong: desktop-accent ? desktop-accent-fill : #1b74a8;
    out property <brush> accent-ink: dark ? (desktop-accent ? desktop-accent-fill.brighter(70%) : #7cc8f0) : (desktop-accent ? desktop-accent-fill.darker(15%) : #176a99);
    out property <brush> accent-wash: dark ? accent-strong.with-alpha(0.35) : accent.with-alpha(0.2);
    out property <brush> on-accent: #ffffff;

    out property <brush> neutral: #f67400;
    out property <brush> neutral-wash: dark ? #3d2a17 : #fdeee0;
    out property <brush> negative: #da4453;
    out property <brush> negative-strong: #c0303f;
    out property <brush> negative-wash: dark ? #3f1d22 : #fbe3e6;
    out property <brush> positive: #27ae60;
    out property <brush> shadow: dark ? #00000099 : #00000047;
    out property <brush> scrim: dark ? #0000008c : #23262973;

    // Placeholder controller art.
    out property <brush> art-line: dark ? #5b6168 : #b9bec3;
    out property <brush> art-fill: dark ? #25282c : #f5f6f7;

    // Type: Noto Sans; sizes in rem follow the desktop font (10 pt is 1rem).
    out property <string> font-family: "Noto Sans";
    out property <string> mono-family: "Hack";
    out property <relative-font-size> text-small: 0.825rem;
    out property <relative-font-size> text-caption: 0.9rem;
    out property <relative-font-size> text-section: 1.09rem;
    out property <relative-font-size> text-title: 1.2rem;
    out property <relative-font-size> text-placeholder: 1.35rem;

    out property <length> radius: 4px;
    out property <length> radius-frame: 6px;
    out property <length> control-height: 30px;
    out property <length> row-height: 40px;
}
