// Breeze-drawn controls: Button, LineEdit, ComboBox, Slider, CheckBox, LinkButton,
// ScrollView, Spinner.
import { Theme } from "theme.slint";
export { Theme }

export component Button {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> destructive;
    // Toolbar button: no frame until hovered.
    in property <bool> flat;
    // Narrow toolbar: icon only, the text stays the accessible label.
    in property <bool> icon-only;
    in property <bool> enabled: true;
    callback clicked;

    property <bool> filled: (primary || destructive) && enabled;
    property <brush> ink: filled ? Theme.on-accent : Theme.fg;

    min-height: Theme.control-height;
    max-height: Theme.control-height;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { clicked(); }
    forward-focus: fs;

    fs := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    Rectangle {
        opacity: root.enabled ? 1 : 0.45;
        border-radius: Theme.radius;
        border-width: 1px;
        background: root.destructive && root.enabled ? Theme.negative-strong
            : root.filled ? Theme.accent-strong
            : root.flat && !ta.has-hover ? transparent
            : ta.has-hover && root.enabled ? Theme.hover : Theme.button;
        border-color: root.destructive && root.enabled ? Theme.negative-strong
            : root.filled ? Theme.accent-strong
            : root.flat && !ta.has-hover ? transparent
            : ta.has-hover && root.enabled ? Theme.accent : Theme.line;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 6px;
            alignment: center;
            if root.icon.width > 0: Image {
                source: root.icon;
                colorize: root.ink;
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
            }
            if root.text != "" && !root.icon-only: Text {
                text: root.text;
                color: root.ink;
                font-weight: root.filled ? 600 : 400;
                vertical-alignment: center;
            }
        }
    }

    // Keyboard focus, Breeze style: accent outline outside the control.
    if fs.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: Theme.radius + 2px;
        border-width: 2px;
        border-color: Theme.accent;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component LineEdit {
    in-out property <string> text;
    in property <bool> read-only;
    in property <bool> mono;
    // Several lines: a path or command the user must read in full.
    in property <bool> wrap;
    in property <string> accessible-name;
    in property <InputType> input-type: InputType.text;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    // Room kept free at the right edge, such as for the arrows of a number field.
    in property <length> inset-right;
    in property <bool> enabled: true;
    out property <bool> has-focus: ti.has-focus;
    callback edited(string);
    min-height: wrap ? ti.preferred-height + 12px : Theme.control-height;
    max-height: self.min-height;
    accessible-role: text-input;
    accessible-label: accessible-name;
    accessible-value: text;
    forward-focus: ti;

    Rectangle {
        background: root.read-only ? Theme.window : Theme.view;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: ti.has-focus ? Theme.accent : Theme.line;
        clip: true;
        ti := TextInput {
            x: 8px;
            y: root.wrap ? 6px : 0;
            width: parent.width - 16px - root.inset-right;
            height: root.wrap ? parent.height - 12px : parent.height;
            wrap: root.wrap ? char-wrap : no-wrap;
            text <=> root.text;
            read-only: root.read-only;
            input-type: root.input-type;
            horizontal-alignment: root.horizontal-alignment;
            enabled: root.enabled;
            color: root.enabled ? Theme.fg : Theme.fg-muted;
            font-family: root.mono ? Theme.mono-family : Theme.font-family;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            vertical-alignment: center;
            single-line: !root.wrap;
            edited => { root.edited(root.text); }
        }
    }

    public function copy-all() {
        ti.select-all();
        ti.copy();
        ti.clear-selection();
    }
}

export component ComboBox {
    in property <[string]> model;
    in-out property <int> current-index;
    out property <string> current-value: model[current-index];
    in property <bool> enabled: true;
    in property <string> accessible-name;
    // Small: the table rows, 26px.
    in property <bool> small;
    // A menu of commands, such as "Add a button…", whose first entry is the prompt: the
    // arrow keys only move through the entries, and Enter or a click picks one.
    in property <bool> menu;
    callback selected(string);
    callback focused;
    min-height: small ? 26px : Theme.control-height;
    max-height: self.min-height;
    min-width: 120px;
    accessible-role: combobox;
    accessible-label: accessible-name;
    accessible-value: current-value;
    forward-focus: fs;

    function pick(i: int) {
        if (i >= 0 && i < model.length && (i != current-index || menu)) {
            current-index = i;
            selected(current-value);
        }
    }
    // The arrow keys: a pick, or in a menu a move.
    function step(i: int) {
        if (!menu) {
            pick(i);
        } else if (i >= 0 && i < model.length) {
            current-index = i;
        }
    }

    fs := FocusScope {
        enabled: root.enabled;
        focus-gained => { root.focused(); }
        key-pressed(e) => {
            if (e.text == Key.UpArrow) {
                root.step(root.current-index - 1);
                return accept;
            }
            if (e.text == Key.DownArrow) {
                root.step(root.current-index + 1);
                return accept;
            }
            if (root.menu && e.text == Key.Return && root.current-index > 0) {
                root.pick(root.current-index);
                return accept;
            }
            if (e.text == " " || e.text == Key.Return) {
                popup.show();
                return accept;
            }
            reject
        }
    }

    Rectangle {
        border-radius: Theme.radius;
        border-width: 1px;
        background: ta.has-hover ? Theme.hover : Theme.button;
        border-color: ta.has-hover || fs.has-focus ? Theme.accent : Theme.line;
        Text {
            x: 8px;
            width: parent.width - 34px;
            height: parent.height;
            text: root.current-value;
            color: Theme.fg;
            vertical-alignment: center;
            overflow: elide;
        }
        Image {
            x: parent.width - 22px;
            width: 14px;
            height: 14px;
            source: @image-url("../../icons/chevron.svg");
            colorize: Theme.fg-muted;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            popup.show();
        }
    }

    if fs.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: Theme.radius + 2px;
        border-width: 2px;
        border-color: Theme.accent;
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: max(root.width, 160px);
        Rectangle {
            background: Theme.view;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.shadow;
        }
        VerticalLayout {
            padding: 4px;
            for item[i] in root.model: Rectangle {
                height: 26px;
                border-radius: 3px;
                background: i == root.current-index ? Theme.accent-wash : item-ta.has-hover ? Theme.hover : transparent;
                Text {
                    x: 8px;
                    text: item;
                    color: Theme.fg;
                    vertical-alignment: center;
                }
                item-ta := TouchArea {
                    clicked => { root.pick(i); }
                }
            }
        }
    }
}

export component Slider {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    // A value the slider moves to, such as a glide's end: a hollow ring on the groove and
    // a line to it from the knob. Shown while `marked`.
    in property <bool> marked;
    in property <float> mark;
    callback changed(float);
    min-height: 22px;
    max-height: 22px;
    min-width: 120px;
    accessible-role: slider;
    accessible-label: accessible-name;
    accessible-enabled: root.enabled;
    accessible-value: round(value);
    accessible-value-minimum: minimum;
    accessible-value-maximum: maximum;
    accessible-value-step: step;
    accessible-action-increment => { root.set(root.value + root.step); }
    accessible-action-decrement => { root.set(root.value - root.step); }
    accessible-action-set-value(v) => { root.set(v.to-float()); }
    forward-focus: fs;

    property <float> ratio: (value - minimum) / (maximum - minimum);
    property <length> knob: 18px;
    // PageUp and PageDown move a tenth of the range, in whole steps.
    property <float> page: max(step, round((maximum - minimum) / 10 / step) * step);
    // The centre of the knob at value `v`.
    pure function at(v: float) -> length {
        (v - root.minimum) / (root.maximum - root.minimum) * (root.width - root.knob) + root.knob / 2
    }

    // Moves to `v` in whole steps within the range. A move that keeps the value, such as a
    // drag past either end, sends nothing.
    function set(v: float) {
        let next = clamp(round(v / step) * step, minimum, maximum);
        if (next == value) {
            return;
        }
        value = next;
        changed(value);
    }

    opacity: root.enabled ? 1 : 0.45;

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.LeftArrow || e.text == Key.DownArrow) {
                root.set(root.value - root.step);
                return accept;
            }
            if (e.text == Key.RightArrow || e.text == Key.UpArrow) {
                root.set(root.value + root.step);
                return accept;
            }
            if (e.text == Key.PageDown) {
                root.set(root.value - root.page);
                return accept;
            }
            if (e.text == Key.PageUp) {
                root.set(root.value + root.page);
                return accept;
            }
            if (e.text == Key.Home) {
                root.set(root.minimum);
                return accept;
            }
            if (e.text == Key.End) {
                root.set(root.maximum);
                return accept;
            }
            reject
        }
    }

    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.line;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        width: root.ratio * (parent.width - root.knob) + root.knob / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    // The line from the knob to the mark, then the mark, under the knob.
    if root.marked: Rectangle {
        x: min(root.at(root.value), root.at(root.mark));
        y: (parent.height - 2px) / 2;
        width: abs(root.at(root.mark) - root.at(root.value));
        height: 2px;
        background: Theme.accent-ink;
    }
    if root.marked: Rectangle {
        x: root.at(root.mark) - 6px;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.view;
        border-width: 2px;
        border-color: Theme.accent-ink;
    }
    knob := Rectangle {
        x: root.ratio * (parent.width - root.knob);
        y: (parent.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: Theme.button;
        border-width: 1px;
        border-color: root.enabled && (fs.has-focus || ta.has-hover) ? Theme.accent : Theme.line;
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.shadow;
    }
    // The focus frame: 2px of accent, 2px outside the knob.
    if fs.has-focus && root.enabled: Rectangle {
        x: knob.x - 4px;
        y: knob.y - 4px;
        width: knob.width + 8px;
        height: knob.height + 8px;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.accent;
    }

    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                fs.focus();
                root.set(root.minimum + (self.mouse-x - root.knob / 2) / (self.width - root.knob) * (root.maximum - root.minimum));
            }
        }
        moved => {
            if (self.pressed) {
                root.set(root.minimum + (self.mouse-x - root.knob / 2) / (self.width - root.knob) * (root.maximum - root.minimum));
            }
        }
    }
}

// Breeze check box: a 16px box, filled with the accent and ticked when on.
export component CheckBox {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    // Focus came from the keyboard (Tab), not a click: for a tip only keyboard users need.
    out property <bool> keyboard-focus;
    callback toggled;
    min-height: 22px;
    opacity: root.enabled ? 1 : 0.45;
    accessible-enabled: root.enabled;
    accessible-role: checkbox;
    accessible-label: text;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { toggle(); }
    forward-focus: fs;

    function toggle() {
        if (!root.enabled) {
            return;
        }
        checked = !checked;
        toggled();
    }

    // Focusable while disabled too, so a keyboard user reaches its tip; `toggle` refuses.
    fs := FocusScope {
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost => { root.keyboard-focus = false; }
        key-pressed(e) => {
            if (e.text == " ") {
                root.toggle();
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        spacing: 8px;
        box := Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            border-width: 1px;
            background: root.checked ? Theme.accent-strong : Theme.button;
            border-color: root.checked ? Theme.accent-strong
                : root.enabled && (fs.has-focus || ta.has-hover) ? Theme.accent : Theme.line;
            if root.checked: Path {
                width: 100%;
                height: 100%;
                viewbox-width: 16;
                viewbox-height: 16;
                commands: "M 3.5 8.5 L 6.5 11.5 L 12.5 4.5";
                stroke: Theme.on-accent;
                stroke-width: 2px;
            }
        }
        Text {
            text: root.text;
            color: Theme.fg;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }

    // Keyboard focus, Breeze style: accent outline outside the box.
    if fs.has-focus: Rectangle {
        x: box.x - 2px;
        y: box.y - 2px;
        width: box.width + 4px;
        height: box.height + 4px;
        border-radius: 5px;
        border-width: 2px;
        border-color: Theme.accent;
    }

    ta := TouchArea {
        clicked => {
            fs.focus();
            root.toggle();
        }
    }
}

// Breeze scroll bar: a thin groove that widens on hover.
// Kirigami LinkButton: accent text that acts, underlined on hover and focus.
export component LinkButton {
    in property <string> text;
    callback clicked;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { clicked(); }
    forward-focus: fs;

    fs := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    label := Text {
        text: root.text;
        color: Theme.accent-ink;
        vertical-alignment: center;
    }
    if ta.has-hover || fs.has-focus: Rectangle {
        x: label.x;
        y: label.y + label.height - 2px;
        width: label.width;
        height: 1px;
        background: Theme.accent-ink;
    }

    // Keyboard focus, Breeze style: accent outline outside the text.
    if fs.has-focus: Rectangle {
        x: -3px;
        y: -2px;
        width: root.width + 6px;
        height: root.height + 4px;
        border-radius: Theme.radius;
        border-width: 2px;
        border-color: Theme.accent;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ScrollView {
    in-out property <length> content-y <=> f.content-y;
    in-out property <length> content-height <=> f.content-height;
    out property <length> visible-height: f.height;
    min-height: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    property <length> range: f.content-height - f.height;

    f := Flickable {
        width: parent.width;
        height: parent.height;
        // A mouse drag inside the page belongs to the control under it, such as a stick
        // gate; the wheel and the bar scroll, as on KDE.
        mouse-drag-pan-enabled: false;
        @children
    }

    if root.range > 0: Rectangle {
        property <length> track: root.height - 4px;
        property <length> thumb: max(28px, self.track * f.height / f.content-height);
        x: root.width - self.width - 2px;
        y: 2px;
        width: bar-ta.has-hover || bar-ta.pressed ? 8px : 4px;
        height: self.track;
        animate width { duration: 120ms; }
        Rectangle {
            y: -f.content-y / root.range * (parent.track - parent.thumb);
            height: parent.thumb;
            border-radius: parent.width / 2;
            background: bar-ta.pressed ? Theme.accent : Theme.fg-muted.with-alpha(bar-ta.has-hover ? 0.7 : 0.45);
        }
        bar-ta := TouchArea {
            x: -6px;
            width: parent.width + 8px;
            moved => {
                if (self.pressed) {
                    f.content-y = -clamp((self.mouse-y - parent.thumb / 2) / (parent.track - parent.thumb), 0, 1) * root.range;
                }
            }
        }
    }
}

export component Spinner {
    width: 18px;
    height: 18px;
    // A 270 degree arc that turns once every 900 ms.
    property <angle> a: 360deg * mod(animation-tick(), 900ms) / 900ms;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: Theme.accent;
        stroke-width: 2px;
        commands: "M " + (9 + 7 * cos(root.a)) + " " + (9 + 7 * sin(root.a))
            + " A 7 7 0 1 1 " + (9 + 7 * cos(root.a + 270deg)) + " " + (9 + 7 * sin(root.a + 270deg));
    }
}
