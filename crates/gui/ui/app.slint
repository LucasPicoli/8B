// The 8B window: the no-controller screen until a first read, then the sidebar
// with every slot of every mode and the selected slot beside it.
import { Theme, Button, LineEdit, ScrollView, Spinner } from "look/breeze/widgets.slint";
import { MessageBar, Placeholder, Icons, TabBar, Diagnostics } from "parts.slint";
import { ButtonsTab } from "buttons.slint";
import { MacrosTab } from "macros.slint";
import { SettingsTab } from "settings.slint";
import { Sidebar } from "sidebar.slint";
import { ChangedDialog, ClearDialog, CloseDialog, FailedDialog, FixDialog, ImportDialog, MoveDialog, ReviewDialog, StoppedDialog, WritingDialog } from "dialogs.slint";
import { BatchFailedDialog, BatchReviewDialog, BatchWritingDialog } from "batch.slint";
import { NoControllerScreen, PermissionScreen } from "screens.slint";
import { ModeGroup, Slot, Section, MapRow, PadView, Spot, Setting, Toggle, SettingFrame, SettingsPage, Change, ImportWarning, ReviewInfo, ClearInfo, FailedInfo, BatchSlot, BatchInfo, CloseInfo, CloseGroup, CloseSlot, MacroRow, MacroSpot, LaneInfo, StickInfo, StepInfo, ChipInfo } from "types.slint";
import { Palette } from "std-widgets.slint";

export { ModeGroup, Slot, Section, MapRow, PadView, Spot, Setting, Toggle, SettingFrame, SettingsPage, Change, ImportWarning, ReviewInfo, ClearInfo, FailedInfo, BatchSlot, BatchInfo, CloseInfo, CloseGroup, CloseSlot, MacroRow, MacroSpot, LaneInfo, StickInfo, StepInfo, ChipInfo, Theme, Palette, Diagnostics }

export component AppWindow inherits Window {
    title: (has-controller ? slot-title + " · " : "") + "8B";
    // Wayland ignores this and reads the icon from the .desktop file by app ID.
    icon: @image-url("../../../packaging/linux/io.github.LucasPicoli._8B.svg");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 640px;
    background: Theme.window;
    default-font-family: Theme.font-family;

    // False until the first read: the whole window is the no-controller screen.
    in property <bool> has-controller;
    in property <string> device-name;
    // Every listed controller for the header, and the one shown.
    in property <[string]> controllers;
    in property <int> current-controller;
    in property <string> device-status;
    in property <bool> connected;
    in property <[ModeGroup]> groups;
    // The slot beside the sidebar: a mode index and a 0-based slot.
    in property <int> selected-mode;
    in property <int> selected-slot;
    in property <string> slot-title;
    in property <bool> empty-slot;
    // The profile name field, cut to `name-max` characters by Rust.
    in-out property <string> profile-name;
    in property <int> name-max;
    in property <bool> unsaved;
    in property <[Section]> sections;
    in property <[PadView]> views;
    in property <[Spot]> spots;
    in property <[MapRow]> rows;
    // The settings tabs after Buttons, in the controller description's order.
    in property <[SettingsPage]> pages;
    in-out property <int> tab;
    in-out property <int> selected-row: -1;
    // The controller has macro slots: the Macros tab follows Buttons.
    in property <bool> has-macros;
    in property <[MacroRow]> macro-rows;
    in property <[MacroSpot]> macro-spots;
    in property <bool> macros-editable;
    in property <int> macro-name-max;
    in property <int> macro-count-min;
    in property <int> macro-count-max;
    in property <int> macro-pause-max;
    // The selected macro slot (0-based). Rust reads it to draw that macro's steps.
    in-out property <int> selected-macro: 0;
    changed selected-macro => {
        root.selected-step = 0;
        root.macro-shown();
    }
    // The step table of the selected macro, and its selected step.
    in property <[StepInfo]> step-rows;
    in property <[string]> step-lanes;
    in property <string> step-count;
    in property <bool> steps-full;
    in property <bool> steps-ready;
    in-out property <int> selected-step: 0;
    // Ctrl+Z can take back the last step edit of the shown macro.
    in property <bool> can-undo-step;
    // The step panel of the selected step. Rust reads `selected-step` to fill it.
    in property <string> panel-title;
    in property <int> panel-duration;
    in property <int> step-ms-min;
    in property <int> step-ms-max;
    in property <[ChipInfo]> panel-chips;
    changed selected-step => { root.macro-shown(); }
    // The first settings tab.
    property <int> first-page: root.has-macros ? 2 : 1;
    // Why the last read failed, empty when it did not.
    in property <string> read-error;
    in property <string> read-error-title;
    // The red bar is about a newly plugged controller, not the one shown.
    in property <bool> read-error-elsewhere;
    // The controller is still there and idle, so a failed read can be tried again.
    in property <bool> can-read-again;
    // The last read failed: the status dot shows it.
    in property <bool> read-failed;
    // Narrow window: toolbar buttons drop their text, like KDE toolbars.
    // Set from Rust: bound to the window width here, it forms a layout loop.
    in property <bool> compact;
    // The whole window asks for the udev rule: opening was denied, or the rule is
    // missing or outdated and not skipped.
    in property <bool> asks-for-rule;
    // Opening the controller is denied.
    in property <bool> rule-denied;
    // A read started by "Check again" is running.
    in property <bool> rule-checking;
    // The last "Check again" came back denied.
    in property <bool> rule-still-blocked;
    // The udev rule is in place and opening is still denied.
    in property <bool> rule-installed;
    // An older rule is installed and opening works: ask for an update.
    in property <bool> rule-outdated;
    // Opening works without the rule, so the screen offers a skip.
    in property <bool> rule-skippable;
    in property <bool> installing;
    // The app runs in the Flatpak sandbox: the rule is installed by a command only.
    in property <bool> sandboxed;
    // Why the last rule install failed, empty when it did not.
    in property <string> install-error;
    in property <string> udev-command;
    in property <string> udev-rule-path;
    in-out property <string> dialog;
    // A file for another mode waits for a yes.
    in property <ImportWarning> import-warning;
    // Unplugged controllers whose edits a newly plugged one may take.
    in property <[string]> move-from;
    // Slots whose stored profile changed under their edits.
    in property <[string]> changed-slots;
    // The answer picked for each changed slot: true keeps the edits.
    in property <[bool]> changed-keep;
    // The footer's write button ("Write XInput slot 2…") and Clear slot can be used
    // now.
    in property <bool> can-write;
    // The controller is read again before the review opens.
    in property <bool> checking-slot;
    // Slots of the shown controller with unsaved edits, whether the sidebar's Write
    // all can be used now, and whether the controller is read again for it.
    in property <int> edited-count;
    in property <bool> can-write-all;
    in property <bool> checking-all;
    in property <bool> can-clear;
    // The review before a write, the clear question, a failed write, and the title
    // of the write that runs now (empty when none does).
    in property <ReviewInfo> review;
    in property <ClearInfo> clear;
    in property <FailedInfo> write-failed;
    in property <string> writing-title;
    // The write of every edited slot: its review, progress or failure.
    in property <BatchInfo> batch;
    // The question before closing over unsaved edits.
    in property <CloseInfo> closing;
    // The worker thread has ended.
    in property <bool> worker-stopped;
    // The keepalive fix is offered for the shown controller, its dialog is open, the
    // `pkexec` install runs, and why the last one failed (empty when it did not).
    in property <bool> fix-offered;
    in property <bool> fix-open;
    in property <bool> fix-installing;
    in property <string> fix-error;
    in property <string> fix-command;
    in property <string> fix-rule-path;
    in property <string> fix-unit-path;
    callback fix-opened;
    callback fix-closed;
    callback fix-put-off;
    callback fix-install;
    // The footer button's text, and the sidebar bar's caption and button text.
    out property <string> write-label: "Write " + slot-title + "…";
    out property <string> edited-caption: edited-count == 1 ? "1 slot has unsaved edits" : edited-count + " slots have unsaved edits";
    out property <string> write-all-label: edited-count == 1 ? "Write 1 slot…" : "Write all " + edited-count + " slots…";
    // The message above the slot, such as an import result. Hidden when empty.
    in property <string> notice-title;
    in property <string> notice-body;
    in property <bool> notice-error;
    callback slot-picked(int, int);
    callback controller-picked(int);
    // A row of `move-from`, or -1 for none.
    callback move-answered(int);
    // A row of `changed-slots`, and whether to keep the edits; then Apply.
    callback changed-picked(int, bool);
    callback changed-applied;
    callback install-rule;
    callback check-again;
    callback rule-skipped;
    callback name-edited(string);
    // A row index and an index into that row's outputs.
    callback output-picked(int, int);
    // A JSON pointer into the profile, and its new value.
    callback number-changed(string, float);
    callback flag-changed(string, bool);
    callback discard;
    // Macros tab edits, each for a macro slot (0-based).
    callback macro-created(int);
    callback macro-reverted(int);
    callback macro-deleted(int);
    callback macro-renamed(int, string);
    callback macro-plays-picked(int, int);
    callback macro-count-changed(int, int);
    callback macro-pause-changed(int, int);
    // An entry of the "Add a button…" picker, and a chip.
    callback macro-button-added(int, int);
    callback macro-button-removed(int, int);
    // Another macro is shown: its steps need drawing.
    callback macro-shown;
    // A step edit: the macro slot, the step, and the edit (see `StepTable.edited`).
    callback step-edited(int, int, int);
    callback step-undone(int);
    // A step panel edit: the macro slot, the step, and the duration or the chip.
    callback step-duration-changed(int, int, int);
    callback step-chip-toggled(int, int, int);
    callback start-from-default;
    // Open and save dialogs for profile JSON, and the answer to the import warning.
    callback import-file;
    callback export-file;
    callback import-confirmed;
    callback import-cancelled;
    callback notice-closed;
    callback read-again;
    callback write-clicked;
    callback review-confirmed;
    callback review-cancelled;
    callback review-section-toggled(int);
    callback clear-clicked;
    callback clear-confirmed;
    callback clear-cancelled;
    callback write-retried;
    callback failure-closed;
    callback open-backup-folder;
    callback write-all-clicked;
    callback batch-confirmed;
    callback batch-cancelled;
    // A row of the batch review, opened or closed.
    callback batch-slot-toggled(int);
    callback batch-retried;
    callback batch-closed;
    // The close question: back to the window, write first, or close anyway.
    callback close-cancelled;
    callback stopped-closed;
    callback close-write;
    callback close-discard;
    // The row of the button under (x, y) in view `view`'s viewBox units, or -1.
    pure callback hit(int, float, float) -> int;
    // The chip of "Buttons held" under (x, y) in view `view`, when a click there toggles
    // it in step `step` of macro slot `macro` (0-based), or -1.
    pure callback macro-hit(int, int, int, float, float) -> int;
    // Rust only: the light or dark colours changed, so the views need recolouring.
    callback theme-changed;
    property <bool> dark: Theme.dark;
    changed dark => { root.theme-changed(); }
    // Rust only: the worker thread has events waiting.
    callback worker-event;
    // Rust only: an open or save dialog has answered.
    callback file-done;

    if root.asks-for-rule: PermissionScreen {
        command: root.udev-command;
        rule-path: root.udev-rule-path;
        denied: root.rule-denied;
        checking: root.rule-checking;
        still-blocked: root.rule-still-blocked;
        rule-installed: root.rule-installed;
        outdated: root.rule-outdated;
        skippable: root.rule-skippable;
        installing: root.installing;
        sandboxed: root.sandboxed;
        error: root.install-error;
        install => { root.install-rule(); }
        check => { root.check-again(); }
        skip => { root.rule-skipped(); }
    }

    if !root.asks-for-rule && !root.has-controller: NoControllerScreen {
        status: root.connected ? "Reading the controller" : "Looking for controllers";
        error: root.read-error;
        connected: root.connected;
        can-read-again: root.can-read-again;
        read-again => { root.read-again(); }
    }

    if !root.asks-for-rule && root.has-controller: HorizontalLayout {
        Sidebar {
            groups: root.groups;
            controllers: root.controllers;
            current-controller: root.current-controller;
            device-status: root.device-status;
            connected: root.connected;
            failed: root.read-failed;
            current-mode: root.selected-mode;
            current-slot: root.selected-slot;
            slot-picked(m, s) => {
                // A selected button belongs to the slot it was picked in.
                if (m != root.selected-mode || s != root.selected-slot) {
                    root.selected-row = -1;
                    root.selected-macro = 0;
                }
                root.slot-picked(m, s);
            }
            controller-picked(i) => {
                root.selected-row = -1;
                root.selected-macro = 0;
                root.controller-picked(i);
            }
            edited-count: root.edited-count;
            edited-caption: root.edited-caption;
            write-all-label: root.write-all-label;
            can-write-all: root.can-write-all;
            checking-all: root.checking-all;
            write-all-clicked => { root.write-all-clicked(); }
        }
        VerticalLayout {
            Rectangle {
                height: 52px;
                background: Theme.header;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: root.slot-title;
                        font-size: Theme.text-title;
                        color: Theme.fg;
                        vertical-alignment: center;
                    }
                    if !root.empty-slot: HorizontalLayout {
                        padding-left: 6px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            LineEdit {
                                width: 168px;
                                text <=> root.profile-name;
                                accessible-name: "Profile name";
                                edited(t) => { root.name-edited(t); }
                            }
                        }
                        Text {
                            text: root.profile-name.character-count + "/" + root.name-max;
                            font-size: Theme.text-small;
                            color: Theme.fg-muted;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 4px;
                            Button {
                                text: "Import…";
                                icon: Icons.import;
                                icon-only: root.compact;
                                flat: true;
                                clicked => { root.import-file(); }
                            }
                            if !root.empty-slot: Button {
                                text: "Export…";
                                icon: Icons.export;
                                icon-only: root.compact;
                                flat: true;
                                clicked => { root.export-file(); }
                            }
                            if !root.empty-slot: Button {
                                text: "Clear slot…";
                                icon: Icons.clear;
                                icon-only: root.compact;
                                flat: true;
                                enabled: root.can-clear;
                                clicked => { root.clear-clicked(); }
                            }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line-soft;
                }
            }

            if !root.connected: HorizontalLayout {
                MessageBar {
                    icon: Icons.unplug;
                    title: "The controller was unplugged.";
                    body: "Your edits are kept. Plug it in again to write them.";
                }
            }
            if root.read-error != "": HorizontalLayout {
                MessageBar {
                    error: true;
                    diagnostics: true;
                    title: root.read-error-title;
                    body: root.read-error;
                    action: root.connected || root.read-error-elsewhere ? "Try again" : "";
                    action-enabled: root.can-read-again;
                    acted => { root.read-again(); }
                }
            }

            if root.notice-title != "": HorizontalLayout {
                // Good news fades; an error stays until it is closed.
                Timer {
                    interval: 5s;
                    running: !root.notice-error;
                    triggered => { root.notice-closed(); }
                }
                MessageBar {
                    error: root.notice-error;
                    info: !root.notice-error;
                    closable: true;
                    title: root.notice-title;
                    body: root.notice-body;
                    closed => { root.notice-closed(); }
                }
            }

            if root.fix-offered: HorizontalLayout {
                MessageBar {
                    closable: true;
                    close-text: "Not now";
                    title: "This controller disconnects and reconnects by itself when no app is using it.";
                    body: "8B is using it now, so it stays connected. Two small files keep it connected after you close 8B.";
                    action: "Set up…";
                    acted => { root.fix-opened(); }
                    closed => { root.fix-put-off(); }
                }
            }

            if !root.empty-slot: TabBar {
                model: root.sections;
                current <=> root.tab;
            }

            if root.empty-slot: Rectangle {
                vertical-stretch: 1;
                // The placeholder's text caps the height otherwise.
                max-height: 100000px;
                Placeholder {
                    width: 100%;
                    height: 100%;
                    title: "Slot " + (root.selected-slot + 1) + " is empty";
                    body: "Start from the default profile or import a file, then change what you need. Nothing reaches the controller until you write.";
                    Button {
                        text: "Start from default";
                        primary: true;
                        clicked => { root.start-from-default(); }
                    }
                    Button {
                        text: "Import…";
                        icon: Icons.import;
                        clicked => { root.import-file(); }
                    }
                }
            }

            page := ScrollView {
                visible: !root.empty-slot;
                vertical-stretch: root.empty-slot ? 0 : 1;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 14px;
                    padding-bottom: 32px;
                    if root.tab == 0: ButtonsTab {
                        views: root.views;
                        spots: root.spots;
                        rows: root.rows;
                        selected <=> root.selected-row;
                        hit(v, x, y) => { return root.hit(v, x, y); }
                        output-picked(row, choice) => { root.output-picked(row, choice); }
                        reveal(abs-y, h) => {
                            let top = abs-y - page.absolute-position.y;
                            if (top < 0) {
                                page.content-y -= top;
                            } else if (top + h > page.visible-height) {
                                page.content-y -= top + h - page.visible-height;
                            }
                        }
                    }
                    if root.has-macros && root.tab == 1: MacrosTab {
                        rows: root.macro-rows;
                        views: root.views;
                        spots: root.macro-spots;
                        editable: root.macros-editable;
                        name-max: root.macro-name-max;
                        count-min: root.macro-count-min;
                        count-max: root.macro-count-max;
                        pause-max: root.macro-pause-max;
                        selected <=> root.selected-macro;
                        narrow: root.compact;
                        step-rows: root.step-rows;
                        step-lanes: root.step-lanes;
                        step-count: root.step-count;
                        steps-full: root.steps-full;
                        steps-ready: root.steps-ready;
                        selected-step <=> root.selected-step;
                        can-undo-step: root.can-undo-step;
                        step-edited(n, i, e) => { root.step-edited(n, i, e); }
                        step-undone(n) => { root.step-undone(n); }
                        panel-title: root.panel-title;
                        panel-duration: root.panel-duration;
                        step-ms-min: root.step-ms-min;
                        step-ms-max: root.step-ms-max;
                        panel-chips: root.panel-chips;
                        step-duration-changed(n, i, v) => { root.step-duration-changed(n, i, v); }
                        step-chip-toggled(n, i, c) => { root.step-chip-toggled(n, i, c); }
                        hit(v, x, y) => { return root.hit(v, x, y); }
                        action-hit(v, n, i, x, y) => { return root.macro-hit(v, n, i, x, y); }
                        created(n) => { root.macro-created(n); }
                        reverted(n) => { root.macro-reverted(n); }
                        deleted(n) => { root.macro-deleted(n); }
                        renamed(n, t) => { root.macro-renamed(n, t); }
                        plays-picked(n, p) => { root.macro-plays-picked(n, p); }
                        count-changed(n, v) => { root.macro-count-changed(n, v); }
                        pause-changed(n, v) => { root.macro-pause-changed(n, v); }
                        button-added(n, c) => { root.macro-button-added(n, c); }
                        button-removed(n, c) => { root.macro-button-removed(n, c); }
                    }
                    if root.tab >= root.first-page: SettingsTab {
                        page: root.pages[root.tab - root.first-page];
                        number-changed(field, v) => { root.number-changed(field, v); }
                        flag-changed(field, on) => { root.flag-changed(field, on); }
                    }
                }
            }

            if !root.empty-slot: Rectangle {
                height: 48px;
                background: Theme.header;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.line-soft;
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Discard";
                            icon: Icons.discard;
                            enabled: root.unsaved;
                            clicked => { root.discard(); }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    if root.checking-slot: HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Spinner { }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Checking the controller…";
                                color: Theme.fg-muted;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: root.write-label;
                            icon: Icons.write;
                            primary: true;
                            enabled: root.can-write;
                            clicked => { root.write-clicked(); }
                        }
                    }
                }
            }
        }
    }

    if root.import-warning.shown: ImportDialog {
        warning: root.import-warning;
        accepted => { root.import-confirmed(); }
        cancelled => { root.import-cancelled(); }
    }

    if root.changed-slots.length > 0: ChangedDialog {
        slots: root.changed-slots;
        keep: root.changed-keep;
        picked(i, keep) => { root.changed-picked(i, keep); }
        accepted => { root.changed-applied(); }
    }

    if root.move-from.length > 0: MoveDialog {
        name: root.device-name;
        from: root.move-from;
        accepted => { root.move-answered(0); }
        cancelled => { root.move-answered(-1); }
        picked(i) => { root.move-answered(i); }
    }

    if root.review.shown: ReviewDialog {
        info: root.review;
        accepted => { root.review-confirmed(); }
        cancelled => { root.review-cancelled(); }
        toggled(i) => { root.review-section-toggled(i); }
    }

    if root.clear.shown: ClearDialog {
        info: root.clear;
        accepted => { root.clear-confirmed(); }
        cancelled => { root.clear-cancelled(); }
        extra => { root.export-file(); }
    }

    if root.write-failed.shown: FailedDialog {
        info: root.write-failed;
        accepted => { root.write-retried(); }
        cancelled => { root.failure-closed(); }
        extra => { root.open-backup-folder(); }
    }

    if root.batch.stage == 1: BatchReviewDialog {
        info: root.batch;
        accepted => { root.batch-confirmed(); }
        cancelled => { root.batch-cancelled(); }
        toggled(i) => { root.batch-slot-toggled(i); }
    }

    if root.batch.stage == 3: BatchFailedDialog {
        info: root.batch;
        accepted => { root.batch-retried(); }
        cancelled => { root.batch-closed(); }
        extra => { root.open-backup-folder(); }
    }

    if root.batch.stage == 2: BatchWritingDialog {
        info: root.batch;
    }

    if root.writing-title != "": WritingDialog {
        text: root.writing-title;
    }

    if root.fix-open: FixDialog {
        sandboxed: root.sandboxed;
        installing: root.fix-installing;
        error: root.fix-error;
        command: root.fix-command;
        rule-path: root.fix-rule-path;
        unit-path: root.fix-unit-path;
        accepted => { root.fix-install(); }
        cancelled => { root.fix-closed(); }
    }

    if root.worker-stopped: StoppedDialog {
        accepted => { root.stopped-closed(); }
        cancelled => { root.stopped-closed(); }
    }

    // Last, so it sits over any dialog that was open.
    if root.closing.shown: CloseDialog {
        info: root.closing;
        cancelled => { root.close-cancelled(); }
        write => { root.close-write(); }
        discard => { root.close-discard(); }
    }
}
