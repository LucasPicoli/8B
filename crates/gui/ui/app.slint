// The 8B window: the no-controller screen until a first read, then the sidebar
// with every slot of every mode and the selected slot beside it.
import { Theme, Button, LineEdit, ScrollView } from "look/breeze/widgets.slint";
import { MessageBar, Placeholder, Icons, TabBar } from "parts.slint";
import { ButtonsTab } from "buttons.slint";
import { SettingsTab } from "settings.slint";
import { Sidebar } from "sidebar.slint";
import { AboutDialog, ChangedDialog, ClearDialog, FailedDialog, ImportDialog, MoveDialog, ReviewDialog, WritingDialog } from "dialogs.slint";
import { NoControllerScreen, PermissionScreen } from "screens.slint";
import { ModeGroup, Slot, Section, MapRow, PadView, Spot, Setting, Toggle, SettingFrame, SettingsPage, Change, ImportWarning, ReviewInfo, ClearInfo, FailedInfo } from "types.slint";
import { Palette } from "std-widgets.slint";

export { ModeGroup, Slot, Section, MapRow, PadView, Spot, Setting, Toggle, SettingFrame, SettingsPage, Change, ImportWarning, ReviewInfo, ClearInfo, FailedInfo, Theme, Palette }

export component AppWindow inherits Window {
    title: (has-controller ? slot-title + " · " : "") + "8B";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 640px;
    background: Theme.window;
    default-font-family: Theme.font-family;

    // False until the first read: the whole window is the no-controller screen.
    in property <bool> has-controller;
    in property <string> device-name;
    // Every listed controller for the header, and the one shown.
    in property <[string]> controllers;
    in property <int> current-controller;
    in property <string> device-status;
    in property <bool> connected;
    in property <[ModeGroup]> groups;
    // The slot beside the sidebar: a mode index and a 0-based slot.
    in property <int> selected-mode;
    in property <int> selected-slot;
    in property <string> slot-title;
    in property <bool> empty-slot;
    // The profile name field, cut to `name-max` characters by Rust.
    in-out property <string> profile-name;
    in property <int> name-max;
    in property <bool> unsaved;
    in property <[Section]> sections;
    in property <[PadView]> views;
    in property <[Spot]> spots;
    in property <[MapRow]> rows;
    in property <SettingsPage> sticks;
    in property <SettingsPage> triggers;
    in property <SettingsPage> vibration;
    in-out property <int> tab;
    in-out property <int> selected-row: -1;
    // Why the last read failed, empty when it did not.
    in property <string> read-error;
    in property <string> read-error-title;
    // The red bar is about a newly plugged controller, not the one shown.
    in property <bool> read-error-elsewhere;
    // The controller is still there and idle, so a failed read can be tried again.
    in property <bool> can-read-again;
    // The last read failed: the status dot shows it.
    in property <bool> read-failed;
    in property <string> version;
    // Narrow window: toolbar buttons drop their text, like KDE toolbars.
    // Set from Rust: bound to the window width here, it forms a layout loop.
    in property <bool> compact;
    // The whole window asks for the udev rule: opening was denied, or the rule is
    // missing or outdated and not skipped.
    in property <bool> asks-for-rule;
    // The udev rule is in place and opening is still denied.
    in property <bool> rule-installed;
    // An older rule is installed and opening works: ask for an update.
    in property <bool> rule-outdated;
    // Opening works without the rule, so the screen offers a skip.
    in property <bool> rule-skippable;
    in property <bool> installing;
    // Why the last rule install failed, empty when it did not.
    in property <string> install-error;
    in property <string> udev-command;
    in property <string> udev-rule-path;
    in property <string> keepalive-unit-path;
    in-out property <string> dialog;
    // A file for another mode waits for a yes.
    in property <ImportWarning> import-warning;
    // Unplugged controllers whose edits a newly plugged one may take.
    in property <[string]> move-from;
    // Slots whose stored profile changed under their edits.
    in property <[string]> changed-slots;
    // The answer picked for each changed slot: true keeps the edits.
    in property <[bool]> changed-keep;
    // Write to controller and Clear slot can be used now.
    in property <bool> can-write;
    in property <bool> can-clear;
    // The review before a write, the clear question, a failed write, and the title
    // of the write that runs now (empty when none does).
    in property <ReviewInfo> review;
    in property <ClearInfo> clear;
    in property <FailedInfo> write-failed;
    in property <string> writing-title;
    // The message above the slot, such as an import result. Hidden when empty.
    in property <string> notice-title;
    in property <string> notice-body;
    in property <bool> notice-error;
    callback slot-picked(int, int);
    callback controller-picked(int);
    // A row of `move-from`, or -1 for none.
    callback move-answered(int);
    // A row of `changed-slots`, and whether to keep the edits; then Apply.
    callback changed-picked(int, bool);
    callback changed-applied;
    callback install-rule;
    callback rule-skipped;
    callback name-edited(string);
    // A row index and an index into that row's outputs.
    callback output-picked(int, int);
    // A JSON pointer into the profile, and its new value.
    callback number-changed(string, float);
    callback flag-changed(string, bool);
    callback discard;
    callback start-from-default;
    // Open and save dialogs for profile JSON, and the answer to the import warning.
    callback import-file;
    callback export-file;
    callback import-confirmed;
    callback import-cancelled;
    callback notice-closed;
    callback read-again;
    callback write-clicked;
    callback review-confirmed;
    callback review-cancelled;
    callback clear-clicked;
    callback clear-confirmed;
    callback clear-cancelled;
    callback write-retried;
    callback failure-closed;
    callback open-backup-folder;
    // The row of the button under (x, y) in view `view`'s viewBox units, or -1.
    pure callback hit(int, float, float) -> int;
    // Rust only: the light or dark colours changed, so the views need recolouring.
    callback theme-changed;
    property <bool> dark: Theme.dark;
    changed dark => { root.theme-changed(); }
    // Rust only: the worker thread has events waiting.
    callback worker-event;
    // Rust only: an open or save dialog has answered.
    callback file-done;

    if root.asks-for-rule: PermissionScreen {
        command: root.udev-command;
        rule-path: root.udev-rule-path;
        unit-path: root.keepalive-unit-path;
        rule-installed: root.rule-installed;
        outdated: root.rule-outdated;
        skippable: root.rule-skippable;
        installing: root.installing;
        error: root.install-error;
        install => { root.install-rule(); }
        skip => { root.rule-skipped(); }
        about => { root.dialog = "about"; }
    }

    if !root.asks-for-rule && !root.has-controller: NoControllerScreen {
        status: root.connected ? "Reading the controller" : "Looking for controllers";
        error: root.read-error;
        connected: root.connected;
        can-read-again: root.can-read-again;
        about => { root.dialog = "about"; }
        read-again => { root.read-again(); }
    }

    if !root.asks-for-rule && root.has-controller: HorizontalLayout {
        Sidebar {
            groups: root.groups;
            controllers: root.controllers;
            current-controller: root.current-controller;
            device-status: root.device-status;
            connected: root.connected;
            failed: root.read-failed;
            current-mode: root.selected-mode;
            current-slot: root.selected-slot;
            slot-picked(m, s) => {
                // A selected button belongs to the slot it was picked in.
                if (m != root.selected-mode || s != root.selected-slot) {
                    root.selected-row = -1;
                }
                root.slot-picked(m, s);
            }
            controller-picked(i) => {
                root.selected-row = -1;
                root.controller-picked(i);
            }
            about => { root.dialog = "about"; }
        }
        VerticalLayout {
            Rectangle {
                height: 52px;
                background: Theme.header;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: root.slot-title;
                        font-size: Theme.text-title;
                        color: Theme.fg;
                        vertical-alignment: center;
                    }
                    if !root.empty-slot: HorizontalLayout {
                        padding-left: 6px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            LineEdit {
                                width: 168px;
                                text <=> root.profile-name;
                                accessible-name: "Profile name";
                                edited(t) => { root.name-edited(t); }
                            }
                        }
                        Text {
                            text: root.profile-name.character-count + "/" + root.name-max;
                            font-size: Theme.text-small;
                            color: Theme.fg-muted;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 4px;
                            Button {
                                text: "Import…";
                                icon: Icons.import;
                                icon-only: root.compact;
                                flat: true;
                                clicked => { root.import-file(); }
                            }
                            if !root.empty-slot: Button {
                                text: "Export…";
                                icon: Icons.export;
                                icon-only: root.compact;
                                flat: true;
                                clicked => { root.export-file(); }
                            }
                            if !root.empty-slot: Button {
                                text: "Clear slot…";
                                icon: Icons.clear;
                                icon-only: root.compact;
                                flat: true;
                                enabled: root.can-clear;
                                clicked => { root.clear-clicked(); }
                            }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line-soft;
                }
            }

            if !root.connected: HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                MessageBar {
                    icon: Icons.unplug;
                    title: "The controller was unplugged.";
                    body: "Your edits are kept. Plug it in again to write them.";
                }
            }
            if root.read-error != "": HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                MessageBar {
                    error: true;
                    title: root.read-error-title;
                    body: root.read-error;
                    action: root.connected || root.read-error-elsewhere ? "Try again" : "";
                    action-enabled: root.can-read-again;
                    acted => { root.read-again(); }
                }
            }

            if root.notice-title != "": HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                MessageBar {
                    error: root.notice-error;
                    info: !root.notice-error;
                    closable: true;
                    title: root.notice-title;
                    body: root.notice-body;
                    closed => { root.notice-closed(); }
                }
            }

            if !root.empty-slot: TabBar {
                model: root.sections;
                current <=> root.tab;
            }

            if root.empty-slot: Rectangle {
                vertical-stretch: 1;
                // The placeholder's text caps the height otherwise.
                max-height: 100000px;
                Placeholder {
                    width: 100%;
                    height: 100%;
                    title: "Slot " + (root.selected-slot + 1) + " is empty";
                    body: "Start from the default profile or import a file, then change what you need. Nothing reaches the controller until you write.";
                    Button {
                        text: "Start from default";
                        primary: true;
                        clicked => { root.start-from-default(); }
                    }
                    Button {
                        text: "Import…";
                        icon: Icons.import;
                        clicked => { root.import-file(); }
                    }
                }
            }

            page := ScrollView {
                visible: !root.empty-slot;
                vertical-stretch: root.empty-slot ? 0 : 1;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 14px;
                    padding-bottom: 32px;
                    if root.tab == 0: ButtonsTab {
                        views: root.views;
                        spots: root.spots;
                        rows: root.rows;
                        selected <=> root.selected-row;
                        hit(v, x, y) => { return root.hit(v, x, y); }
                        output-picked(row, choice) => { root.output-picked(row, choice); }
                        reveal(abs-y, h) => {
                            let top = abs-y - page.absolute-position.y;
                            if (top < 0) {
                                page.content-y -= top;
                            } else if (top + h > page.visible-height) {
                                page.content-y -= top + h - page.visible-height;
                            }
                        }
                    }
                    if root.tab > 0: SettingsTab {
                        page: root.tab == 1 ? root.sticks : root.tab == 2 ? root.triggers : root.vibration;
                        number-changed(field, v) => { root.number-changed(field, v); }
                        flag-changed(field, on) => { root.flag-changed(field, on); }
                    }
                }
            }

            if !root.empty-slot: Rectangle {
                height: 48px;
                background: Theme.header;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.line-soft;
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Discard";
                            icon: Icons.discard;
                            enabled: root.unsaved;
                            clicked => { root.discard(); }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Write to controller…";
                            primary: true;
                            enabled: root.can-write;
                            clicked => { root.write-clicked(); }
                        }
                    }
                }
            }
        }
    }

    if root.import-warning.shown: ImportDialog {
        warning: root.import-warning;
        accepted => { root.import-confirmed(); }
        cancelled => { root.import-cancelled(); }
    }

    if root.changed-slots.length > 0: ChangedDialog {
        slots: root.changed-slots;
        keep: root.changed-keep;
        picked(i, keep) => { root.changed-picked(i, keep); }
        accepted => { root.changed-applied(); }
    }

    if root.move-from.length > 0: MoveDialog {
        name: root.device-name;
        from: root.move-from;
        accepted => { root.move-answered(0); }
        cancelled => { root.move-answered(-1); }
        picked(i) => { root.move-answered(i); }
    }

    if root.review.shown: ReviewDialog {
        info: root.review;
        accepted => { root.review-confirmed(); }
        cancelled => { root.review-cancelled(); }
    }

    if root.clear.shown: ClearDialog {
        info: root.clear;
        accepted => { root.clear-confirmed(); }
        cancelled => { root.clear-cancelled(); }
        extra => { root.export-file(); }
    }

    if root.write-failed.shown: FailedDialog {
        info: root.write-failed;
        accepted => { root.write-retried(); }
        cancelled => { root.failure-closed(); }
        extra => { root.open-backup-folder(); }
    }

    if root.writing-title != "": WritingDialog {
        text: root.writing-title;
    }

    if root.dialog == "about": AboutDialog {
        version: root.version;
        cancelled => { root.dialog = ""; }
    }
}
