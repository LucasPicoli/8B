// The 8B window: the no-controller screen until a first read, then the sidebar
// with every slot of every mode and the selected slot beside it.
import { Theme, Button, LineEdit, ScrollView } from "look/breeze/widgets.slint";
import { MessageBar, Placeholder, Icons, TabBar } from "parts.slint";
import { ButtonsTab } from "buttons.slint";
import { SettingsTab } from "settings.slint";
import { Sidebar } from "sidebar.slint";
import { AboutDialog } from "dialogs.slint";
import { NoControllerScreen, PermissionScreen } from "screens.slint";
import { ModeGroup, Slot, Section, MapRow, PadView, Spot, Setting, Toggle, SettingFrame, SettingsPage } from "types.slint";
import { Palette } from "std-widgets.slint";

export { ModeGroup, Slot, Section, MapRow, PadView, Spot, Setting, Toggle, SettingFrame, SettingsPage, Theme, Palette }

export component AppWindow inherits Window {
    title: (has-controller ? slot-title + " · " : "") + "8B";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 640px;
    background: Theme.window;
    default-font-family: Theme.font-family;

    // False until the first read: the whole window is the no-controller screen.
    in property <bool> has-controller;
    in property <string> device-name;
    in property <string> device-status;
    in property <bool> connected;
    in property <[ModeGroup]> groups;
    // The slot beside the sidebar: a mode index and a 0-based slot.
    in property <int> selected-mode;
    in property <int> selected-slot;
    in property <string> slot-title;
    in property <bool> empty-slot;
    // The profile name field, cut to `name-max` characters by Rust.
    in-out property <string> profile-name;
    in property <int> name-max;
    in property <bool> unsaved;
    in property <[Section]> sections;
    in property <[PadView]> views;
    in property <[Spot]> spots;
    in property <[MapRow]> rows;
    in property <SettingsPage> sticks;
    in property <SettingsPage> triggers;
    in property <SettingsPage> vibration;
    in-out property <int> tab;
    in-out property <int> selected-row: -1;
    // Why the last read failed, empty when it did not.
    in property <string> read-error;
    in property <string> version;
    // Narrow window: toolbar buttons drop their text, like KDE toolbars.
    // Set from Rust: bound to the window width here, it forms a layout loop.
    in property <bool> compact;
    // Opening the controller was denied: the whole window asks for access.
    in property <bool> access-denied;
    // The udev rule is in place and opening is still denied.
    in property <bool> rule-installed;
    in property <bool> installing;
    // Why the last rule install failed, empty when it did not.
    in property <string> install-error;
    in property <string> udev-command;
    in property <string> udev-rule-path;
    in-out property <string> dialog;
    callback slot-picked(int, int);
    callback install-rule;
    callback name-edited(string);
    // A row index and an index into that row's outputs.
    callback output-picked(int, int);
    // A JSON pointer into the profile, and its new value.
    callback number-changed(string, float);
    callback flag-changed(string, bool);
    callback discard;
    callback start-from-default;
    // The row of the button under (x, y) in view `view`'s viewBox units, or -1.
    pure callback hit(int, float, float) -> int;
    // Rust only: the light or dark colours changed, so the views need recolouring.
    callback theme-changed;
    property <bool> dark: Theme.dark;
    changed dark => { root.theme-changed(); }
    // Rust only: the worker thread has events waiting.
    callback worker-event;

    if root.access-denied: PermissionScreen {
        command: root.udev-command;
        rule-path: root.udev-rule-path;
        rule-installed: root.rule-installed;
        installing: root.installing;
        error: root.install-error;
        install => { root.install-rule(); }
        about => { root.dialog = "about"; }
    }

    if !root.access-denied && !root.has-controller: NoControllerScreen {
        status: root.connected ? "Reading the controller" : "Looking for controllers";
        error: root.read-error;
        about => { root.dialog = "about"; }
    }

    if !root.access-denied && root.has-controller: HorizontalLayout {
        Sidebar {
            groups: root.groups;
            device-name: root.device-name;
            device-status: root.device-status;
            connected: root.connected;
            current-mode: root.selected-mode;
            current-slot: root.selected-slot;
            slot-picked(m, s) => {
                // A selected button belongs to the slot it was picked in.
                if (m != root.selected-mode || s != root.selected-slot) {
                    root.selected-row = -1;
                }
                root.slot-picked(m, s);
            }
            about => { root.dialog = "about"; }
        }
        VerticalLayout {
            Rectangle {
                height: 52px;
                background: Theme.header;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: root.slot-title;
                        font-size: Theme.text-title;
                        color: Theme.fg;
                        vertical-alignment: center;
                    }
                    if !root.empty-slot: HorizontalLayout {
                        padding-left: 6px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            LineEdit {
                                width: 168px;
                                text <=> root.profile-name;
                                accessible-name: "Profile name";
                                edited(t) => { root.name-edited(t); }
                            }
                        }
                        Text {
                            text: root.profile-name.character-count + "/" + root.name-max;
                            font-size: Theme.text-small;
                            color: Theme.fg-muted;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    // Not wired yet, so shown disabled.
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 4px;
                            Button {
                                text: "Import…";
                                icon: Icons.import;
                                icon-only: root.compact;
                                flat: true;
                                enabled: false;
                            }
                            if !root.empty-slot: Button {
                                text: "Export…";
                                icon: Icons.export;
                                icon-only: root.compact;
                                flat: true;
                                enabled: false;
                            }
                            if !root.empty-slot: Button {
                                text: "Clear slot…";
                                icon: Icons.clear;
                                icon-only: root.compact;
                                flat: true;
                                enabled: false;
                            }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line-soft;
                }
            }

            if !root.connected: HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                MessageBar {
                    icon: Icons.unplug;
                    title: "The controller was unplugged.";
                    body: "Your edits are kept. Plug it in again to write them.";
                }
            }
            if root.read-error != "": HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                MessageBar {
                    error: true;
                    title: "Could not read the controller.";
                    body: root.read-error;
                }
            }

            if !root.empty-slot: TabBar {
                model: root.sections;
                current <=> root.tab;
            }

            if root.empty-slot: Rectangle {
                vertical-stretch: 1;
                // The placeholder's text caps the height otherwise.
                max-height: 100000px;
                Placeholder {
                    width: 100%;
                    height: 100%;
                    title: "Slot " + (root.selected-slot + 1) + " is empty";
                    body: "Start from the default profile and change what you need. Nothing reaches the controller until you write.";
                    Button {
                        text: "Start from default";
                        primary: true;
                        clicked => { root.start-from-default(); }
                    }
                }
            }

            page := ScrollView {
                visible: !root.empty-slot;
                vertical-stretch: root.empty-slot ? 0 : 1;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 14px;
                    padding-bottom: 32px;
                    if root.tab == 0: ButtonsTab {
                        views: root.views;
                        spots: root.spots;
                        rows: root.rows;
                        selected <=> root.selected-row;
                        hit(v, x, y) => { return root.hit(v, x, y); }
                        output-picked(row, choice) => { root.output-picked(row, choice); }
                        reveal(abs-y, h) => {
                            let top = abs-y - page.absolute-position.y;
                            if (top < 0) {
                                page.content-y -= top;
                            } else if (top + h > page.visible-height) {
                                page.content-y -= top + h - page.visible-height;
                            }
                        }
                    }
                    if root.tab > 0: SettingsTab {
                        page: root.tab == 1 ? root.sticks : root.tab == 2 ? root.triggers : root.vibration;
                        number-changed(field, v) => { root.number-changed(field, v); }
                        flag-changed(field, on) => { root.flag-changed(field, on); }
                    }
                }
            }

            if !root.empty-slot: Rectangle {
                height: 48px;
                background: Theme.header;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.line-soft;
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Discard";
                            icon: Icons.discard;
                            enabled: root.unsaved;
                            clicked => { root.discard(); }
                        }
                    }
                }
            }
        }
    }

    if root.dialog == "about": AboutDialog {
        version: root.version;
        cancelled => { root.dialog = ""; }
    }
}
