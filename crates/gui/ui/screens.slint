// Whole-window states before the editor: no controller, no permission.
import { Theme, Button, LineEdit, Spinner } from "look/breeze/widgets.slint";
import { Icons, Placeholder, Frame, MessageBar, CopyButton } from "parts.slint";
import { LockedInfo } from "types.slint";

// Waits on its own, with no button: the app finds the controller by itself.
export component NoControllerScreen inherits Rectangle {
    in property <string> status: @tr("Looking for controllers");
    // Why the last read failed, empty when it did not.
    in property <string> error;
    // The controller is still there, so the error bar offers another read.
    in property <bool> connected;
    // No read runs, so "Try again" can be pressed.
    in property <bool> can-read-again;
    callback read-again;
    background: Theme.window;
    Placeholder {
        title: @tr("Connect your controller");
        body: @tr("Plug it in with a USB cable, in any mode.");
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                Spinner { }
            }
            Text {
                text: root.status;
                color: Theme.fg-muted;
                horizontal-alignment: center;
            }
        }
    }
    if root.error != "": HorizontalLayout {
        y: 0;
        height: self.preferred-height;
        padding: 16px;
        // Clear of the ☰ in the corner.
        padding-left: 54px;
        MessageBar {
            error: true;
            diagnostics: true;
            title: @tr("Could not read the controller.");
            body: root.error;
            action: root.connected ? @tr("Try again") : "";
            action-enabled: root.can-read-again;
            acted => { root.read-again(); }
        }
    }
}

// A locked controller: the window beside its sidebar. Unlock, the wait, the failure
// under a red bar, or a pad no description lists.
export component LockedScreen inherits Rectangle {
    in property <LockedInfo> info;
    // "Unlock", and "Try again" on the red bar.
    callback unlock;
    background: Theme.window;
    Placeholder {
        icon: root.info.view == 4 ? Icons.unplug : Icons.lock;
        title: root.info.title;
        body: root.info.body;
        if root.info.view == 1: Button {
            text: @tr("Unlock");
            primary: true;
            init => { self.focus(); }
            clicked => { root.unlock(); }
        }
        if root.info.view == 2: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Spinner { }
            }
            Text {
                text: @tr("Unlocking…");
                color: Theme.fg-muted;
                vertical-alignment: center;
            }
        }
    }
    if root.info.view == 3: HorizontalLayout {
        y: 0;
        height: self.preferred-height;
        padding: 16px;
        MessageBar {
            error: true;
            diagnostics: true;
            title: root.info.bar-title;
            body: root.info.bar-body;
            action: @tr("Try again");
            action-focus: true;
            acted => { root.unlock(); }
        }
    }
}

// The command that installs the rule, read-only, with Copy.
component CommandFrame inherits Frame {
    in property <string> command;
    in property <string> title;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Text {
            text: root.title;
            color: Theme.fg;
        }
        HorizontalLayout {
            spacing: 6px;
            command := LineEdit {
                text: root.command;
                read-only: true;
                mono: true;
                wrap: true;
                accessible-name: @tr("Command that installs the rule");
            }
            CopyButton { source => { root.command } }
        }
    }
}

export component PermissionScreen inherits Rectangle {
    in property <string> command;
    in property <string> rule-path;
    // Opening the controller is denied: "Check again" can help.
    in property <bool> denied;
    // The rule is in place and access is still denied: ask for a replug instead.
    in property <bool> rule-installed;
    // An older rule is installed and access works: ask for an update.
    in property <bool> outdated;
    // Access works without the rule: offer a skip.
    in property <bool> skippable;
    // The password prompt is open.
    in property <bool> installing;
    // In the Flatpak sandbox there is no password prompt: only the command installs
    // the rule, and "Check again" reads the controller once it has run.
    in property <bool> sandboxed;
    // A read started by "Check again" is running.
    in property <bool> checking;
    // The last "Check again" came back denied.
    in property <bool> still-blocked;
    // Why the last install failed, empty when it did not.
    in property <string> error;
    callback install;
    callback check;
    callback skip;
    background: Theme.window;
    VerticalLayout {
        // Anchored where a typical screen centres, so a bar appearing under the
        // buttons does not move them.
        alignment: start;
        padding-top: max(16px, (root.height - 460px) / 2);
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(560px, root.width - 64px);
                spacing: 6px;
                HorizontalLayout {
                    alignment: center;
                    padding-bottom: 8px;
                    Image {
                        source: Icons.lock;
                        colorize: Theme.fg-muted;
                        width: 64px;
                        height: 64px;
                        opacity: 0.6;
                    }
                }
                Text {
                    text: root.rule-installed ? @tr("The controller is still blocked")
                        : root.outdated ? @tr("Update the device rule")
                        : @tr("Allow 8B to open the controller");
                    font-size: Theme.text-placeholder;
                    color: Theme.fg;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.rule-installed
                        ? @tr("The device rule is installed, but Linux has not applied it to the controller yet. Unplug the controller and plug it in again. If it stays blocked, log out and back in.")
                        : root.outdated
                        ? @tr("The installed rule is from an older version of 8B. Updating replaces this file:")
                        : root.sandboxed
                        ? @tr("Linux blocks apps from changing a controller’s settings until a device rule allows it. The command adds this file:")
                        : @tr("Linux blocks apps from changing a controller’s settings until a device rule allows it. Installing adds this file:");
                    color: Theme.fg-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if !root.rule-installed: Text {
                    text: root.rule-path;
                    font-family: Theme.mono-family;
                    color: Theme.fg;
                    horizontal-alignment: center;
                }
                if !root.rule-installed: Text {
                    text: @tr("It lets the person signed in at this computer open game controllers. It changes nothing else.")
                        + " " + (root.sandboxed ? @tr("Run the command below in a terminal on this computer, then choose {}.", @tr("Check again"))
                            : @tr("It asks for your password once."));
                    color: Theme.fg-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    padding-top: 12px;
                    spacing: 8px;
                    if !root.sandboxed: Button {
                        text: root.installing ? @tr("Waiting for your password…")
                            : root.outdated ? @tr("Update rule…")
                            : root.rule-installed ? @tr("Install again…") : @tr("Install rule…");
                        primary: !root.rule-installed;
                        enabled: !root.installing && !root.checking;
                        clicked => { root.install(); }
                    }
                    if root.denied: Button {
                        text: root.checking ? @tr("Checking…") : @tr("Check again");
                        primary: root.sandboxed || root.rule-installed;
                        // Wide enough for "Checking…", so the label swap moves nothing.
                        min-width: 104px;
                        enabled: !root.installing && !root.checking;
                        clicked => { root.check(); }
                    }
                    if root.skippable: Button {
                        text: @tr("Not now");
                        flat: true;
                        enabled: !root.installing;
                        clicked => { root.skip(); }
                    }
                }
                // A slot as tall as a one-line bar, so a bar appearing moves nothing.
                VerticalLayout {
                    min-height: 33px;
                    if root.error != "": MessageBar {
                        error: true;
                        title: @tr("Could not install the rule.");
                        body: root.error + " " + @tr("Run the command instead.");
                    }
                    if root.error == "" && root.still-blocked: MessageBar {
                        title: root.rule-installed ? @tr("Still blocked.")
                            : root.sandboxed ? @tr("Still blocked. Run the command, then check again.")
                            : @tr("Still blocked. Install the rule or run the command, then check again.");
                    }
                }
                CommandFrame {
                    command: root.command;
                    title: root.rule-installed ? @tr("To install the rule again, run this in a terminal:")
                        : root.sandboxed ? @tr("Run this in a terminal:") : @tr("Or run this in a terminal:");
                }
            }
        }
    }
}
