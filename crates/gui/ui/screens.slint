// Whole-window states before the editor: no controller, no permission.
import { Theme, Button, LineEdit, Spinner } from "look/breeze/widgets.slint";
import { Icons, Placeholder, Frame, MessageBar } from "parts.slint";

// Waits on its own, with no button: the app finds the controller by itself.
export component NoControllerScreen inherits Rectangle {
    in property <string> status: "Looking for controllers";
    // Why the last read failed, empty when it did not.
    in property <string> error;
    // The controller is still there, so the error bar offers another read.
    in property <bool> connected;
    // No read runs, so "Try again" can be pressed.
    in property <bool> can-read-again;
    callback read-again;
    background: Theme.window;
    Placeholder {
        title: "Connect your controller";
        body: "Plug it in with a USB cable, in any mode. 8B finds it on its own.";
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                Spinner { }
            }
            Text {
                text: root.status;
                color: Theme.fg-muted;
                horizontal-alignment: center;
            }
        }
    }
    if root.error != "": HorizontalLayout {
        y: 0;
        height: self.preferred-height;
        padding: 16px;
        MessageBar {
            error: true;
            title: "Could not read the controller.";
            body: root.error;
            action: root.connected ? "Try again" : "";
            action-enabled: root.can-read-again;
            acted => { root.read-again(); }
        }
    }
}

export component PermissionScreen inherits Rectangle {
    in property <string> command;
    in property <string> rule-path;
    // The rule is in place and access is still denied: ask for a replug instead.
    in property <bool> rule-installed;
    // An older rule is installed and access works: ask for an update.
    in property <bool> outdated;
    // Access works without the rule: offer a skip.
    in property <bool> skippable;
    // The password prompt is open.
    in property <bool> installing;
    // In the Flatpak sandbox there is no password prompt: only the command installs
    // the rule, and "Check again" reads the controller once it has run.
    in property <bool> sandboxed;
    // Why the last install failed, empty when it did not.
    in property <string> error;
    callback install;
    callback check;
    callback skip;
    background: Theme.window;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(560px, root.width - 64px);
                spacing: 6px;
                HorizontalLayout {
                    alignment: center;
                    padding-bottom: 8px;
                    Image {
                        source: Icons.lock;
                        colorize: Theme.fg-muted;
                        width: 64px;
                        height: 64px;
                        opacity: 0.6;
                    }
                }
                Text {
                    text: root.rule-installed ? "The controller is still blocked"
                        : root.outdated ? "Update the device rule"
                        : "Allow 8B to open the controller";
                    font-size: Theme.text-placeholder;
                    color: Theme.fg;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.rule-installed
                        ? "The device rule is installed, but Linux has not applied it to the controller yet. Unplug the controller and plug it in again. If it stays blocked, log out and back in."
                        : root.outdated
                        ? "The installed rule is from an older version of 8B. The new rule also stops 8BitDo controllers in XInput mode from reconnecting every second while Steam is closed. Updating asks for your password once."
                        : root.sandboxed
                        ? "Linux blocks apps from changing a controller’s settings until a device rule allows it. Run the command below in a terminal on this computer, then choose Check again."
                        : "Linux blocks apps from changing a controller’s settings until a device rule allows it. Installing the rule asks for your password once.";
                    color: Theme.fg-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.error != "": HorizontalLayout {
                    padding-top: 12px;
                    MessageBar {
                        error: true;
                        title: "Could not install the rule.";
                        body: root.error + " Run the command below instead.";
                    }
                }
                if !root.rule-installed || root.sandboxed: HorizontalLayout {
                    alignment: center;
                    padding-top: 12px;
                    padding-bottom: 20px;
                    spacing: 8px;
                    if !root.sandboxed: Button {
                        text: root.installing ? "Waiting for your password…"
                            : root.outdated ? "Update rule…" : "Install rule…";
                        primary: true;
                        enabled: !root.installing;
                        clicked => { root.install(); }
                    }
                    if root.sandboxed: Button {
                        text: "Check again";
                        primary: true;
                        clicked => { root.check(); }
                    }
                    if root.skippable: Button {
                        text: "Not now";
                        flat: true;
                        enabled: !root.installing;
                        clicked => { root.skip(); }
                    }
                }
                if root.rule-installed && !root.sandboxed: Rectangle { height: 20px; }
                Frame {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            text: root.rule-installed ? "To install the rule again, run this in a terminal:"
                                : root.sandboxed ? "Run this in a terminal:" : "Or run this in a terminal:";
                            color: Theme.fg;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            cmd := LineEdit {
                                text: root.command;
                                read-only: true;
                                mono: true;
                                wrap: true;
                                accessible-name: "Command that installs the rule";
                            }
                            Button {
                                text: "Copy";
                                icon: Icons.copy;
                                clicked => { cmd.copy-all(); }
                            }
                        }
                        Text {
                            text: "It installs " + root.rule-path + ". It gives the person signed in at this computer access to 8BitDo controllers and Switch Pro controllers.";
                            font-size: Theme.text-caption;
                            color: Theme.fg-muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
