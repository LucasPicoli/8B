// Pieces shared by the screens, coloured from `Theme`.
import { Theme, Button, ScrollView } from "look/breeze/widgets.slint";
import { Section, Change } from "types.slint";

export global Icons {
    out property <image> import: @image-url("icons/import.svg");
    out property <image> export: @image-url("icons/export.svg");
    out property <image> clear: @image-url("icons/clear.svg");
    out property <image> discard: @image-url("icons/discard.svg");
    out property <image> warning: @image-url("icons/warning.svg");
    out property <image> error: @image-url("icons/error.svg");
    out property <image> info: @image-url("icons/info.svg");
    out property <image> lock: @image-url("icons/lock.svg");
    out property <image> copy: @image-url("icons/copy.svg");
    out property <image> folder: @image-url("icons/folder.svg");
    out property <image> unplug: @image-url("icons/unplug.svg");
    out property <image> pad: @image-url("icons/pad.svg");
    out property <image> close: @image-url("icons/close.svg");
    out property <image> write: @image-url("icons/write.svg");
    out property <image> stack: @image-url("icons/stack.svg");
    out property <image> check: @image-url("icons/check.svg");
}

// What "Copy diagnostics" puts on the clipboard: the run header and the tail of the log.
export global Diagnostics {
    pure callback text() -> string;
}

// A button that copies a text. For 2 seconds after a click a green check and "Copied"
// stand in its place, at the button's width, so nothing moves and no hover frame
// shows. The button stays under them, see-through, so it keeps focus and a second
// click copies again. Slint has no clipboard call, so a hidden text input holds the
// text and copies it. It is emptied at once: even hidden, a long text sizes the layout
// around it.
export component CopyButton inherits Rectangle {
    in property <string> label: "Copy";
    in property <bool> flat;
    // Where "Copied" sits in the button's width: under the copy icon in a footer, next
    // to the following button in a message bar.
    in property <LayoutAlignment> label-alignment: start;
    // The text to copy, asked for on each click.
    callback source() -> string;
    property <bool> copied;
    preferred-width: btn.preferred-width;
    // A button's height, even in a bar that grows for a wrapped message.
    min-height: Theme.control-height;
    max-height: Theme.control-height;
    horizontal-stretch: 0;
    btn := Button {
        width: parent.width;
        height: parent.height;
        opacity: root.copied ? 0 : 1;
        flat: root.flat;
        text: root.label;
        icon: Icons.copy;
        clicked => {
            field.text = root.source();
            field.select-all();
            field.copy();
            field.text = "";
            root.copied = true;
            timer.restart();
        }
    }
    // Inset 10px like the button's own content.
    if root.copied: HorizontalLayout {
        alignment: root.label-alignment;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        accessible-role: text;
        accessible-label: "Copied to the clipboard";
        Image {
            source: Icons.check;
            colorize: Theme.positive;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: "Copied";
            color: Theme.fg;
            vertical-alignment: center;
        }
    }
    field := TextInput {
        visible: false;
        read-only: true;
        width: 0;
        height: 0;
    }
    timer := Timer {
        interval: 2s;
        running: root.copied;
        triggered => { root.copied = false; }
    }
}

// What "Copy diagnostics" puts on the clipboard: the run header and the tail of the log.
export component CopyDiagnostics inherits CopyButton {
    label: "Copy diagnostics";
    flat: true;
    source => { Diagnostics.text() }
}

// A frame or column heading.
export component SmallHead inherits Text {
    font-weight: 600;
    font-size: Theme.text-caption;
    color: Theme.fg-muted;
}

// Unsaved edits marker.
export component Dot inherits Rectangle {
    width: 7px;
    height: 7px;
    border-radius: 3.5px;
    background: Theme.neutral;
    accessible-role: text;
    accessible-label: "Unsaved edits";
}

export component Frame inherits Rectangle {
    background: Theme.view;
    border-width: 1px;
    border-color: Theme.line-soft;
    border-radius: Theme.radius-frame;
    clip: true;
}

// KMessageWidget: tinted box with a 1px border in the message colour.
export component MessageBar inherits Rectangle {
    in property <bool> error;
    // Information, not a warning: the accent colour and the info icon.
    in property <bool> info;
    in property <bool> closable;
    // Words on the close button instead of the icon, such as "Not now".
    in property <string> close-text;
    in property <image> icon: error ? Icons.error : info ? Icons.info : Icons.warning;
    in property <string> title;
    in property <string> body;
    // A "Copy diagnostics" button before the action.
    in property <bool> diagnostics;
    // A button before Close, such as "Try again". Hidden when empty.
    in property <string> action;
    in property <bool> action-enabled: true;
    callback closed;
    callback acted;
    property <brush> tone: error ? Theme.negative : info ? Theme.accent : Theme.neutral;
    background: error ? Theme.negative-wash : info ? Theme.accent-wash : Theme.neutral-wash;
    border-width: 1px;
    border-color: tone;
    border-radius: Theme.radius;
    accessible-role: text;
    accessible-label: title + " " + body;
    HorizontalLayout {
        padding: 8px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        // Centred like the text, so a taller bar (one with a button) keeps them level.
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.tone;
                width: 16px;
                height: 16px;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.title + (root.body != "" ? " " + root.body : "");
            color: Theme.fg;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        if root.diagnostics: CopyDiagnostics {
            label-alignment: end;
        }
        if root.action != "": Button {
            text: root.action;
            enabled: root.action-enabled;
            clicked => { root.acted(); }
        }
        if root.closable && root.close-text == "": Button {
            text: "Close";
            icon: Icons.close;
            icon-only: true;
            flat: true;
            clicked => { root.closed(); }
        }
        if root.closable && root.close-text != "": Button {
            text: root.close-text;
            flat: true;
            clicked => { root.closed(); }
        }
    }
}

export component TabBar inherits Rectangle {
    in property <[Section]> model;
    in-out property <int> current;
    height: 36px;
    background: Theme.header;
    accessible-role: tab-list;
    forward-focus: fs;

    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.RightArrow) {
                root.current = mod(root.current + 1, root.model.length);
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                root.current = mod(root.current - 1 + root.model.length, root.model.length);
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        spacing: 2px;
        alignment: start;
        for section[i] in root.model: Rectangle {
            property <bool> on: i == root.current;
            accessible-role: tab;
            accessible-label: section.name;
            accessible-item-selected: self.on;
            accessible-action-default => { root.current = i; }
            background: !self.on && tab-ta.has-hover ? Theme.hover : transparent;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 6px;
                Text {
                    text: section.name;
                    color: on ? Theme.fg : Theme.fg-muted;
                    font-weight: on ? 600 : 400;
                    vertical-alignment: center;
                }
                if section.unsaved: Dot {
                    y: (parent.height - self.height) / 2;
                }
                if section.count > 0: Rectangle {
                    y: (parent.height - 16px) / 2;
                    height: 16px;
                    border-radius: 8px;
                    background: Theme.line-soft;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: section.count;
                            font-size: Theme.text-small;
                            color: Theme.fg-muted;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            // Selected tab: accent underline over the bar's bottom border.
            Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: on ? Theme.accent : transparent;
            }
            if on && fs.has-focus: Rectangle {
                x: 4px;
                y: 5px;
                width: parent.width - 8px;
                height: parent.height - 12px;
                border-width: 2px;
                border-radius: Theme.radius;
                border-color: Theme.accent;
            }
            tab-ta := TouchArea {
                clicked => {
                    root.current = i;
                    fs.focus();
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

// One change: the setting at 600 in the left 46%, then "from  →  to".
export component ChangeRow inherits Rectangle {
    in property <Change> change;
    // A 1px rule under the row.
    in property <bool> rule;
    min-height: 32px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Text {
            width: 46%;
            text: root.change.what;
            font-weight: 600;
            color: Theme.fg;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.change.from + "  →  " + root.change.to;
            color: Theme.fg;
            vertical-alignment: center;
        }
    }
    if root.rule: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

export component ChangeTable inherits Frame {
    in property <[Change]> model;
    VerticalLayout {
        for c[i] in root.model: ChangeRow {
            change: c;
            rule: i < root.model.length - 1;
        }
    }
}

// Kirigami PlaceholderMessage: large muted icon, title, explanation, actions.
export component Placeholder {
    in property <image> icon: Icons.pad;
    in property <string> title;
    in property <string> body;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                spacing: 6px;
                max-width: 460px;
                HorizontalLayout {
                    alignment: center;
                    padding-bottom: 8px;
                    Image {
                        source: root.icon;
                        colorize: Theme.fg-muted;
                        width: 64px;
                        height: 64px;
                        opacity: 0.6;
                    }
                }
                Text {
                    text: root.title;
                    font-size: Theme.text-placeholder;
                    color: Theme.fg;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.body;
                    color: Theme.fg-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    padding-top: 12px;
                    spacing: 8px;
                    @children
                }
            }
        }
    }
}

// Modal sheet over the window. Escape cancels.
export component DialogShell inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    in property <length> card-width: 520px;
    in property <string> accept-text;
    in property <bool> accept-enabled: true;
    in property <string> cancel-text: "Cancel";
    // False while the dialog cannot be left, such as during a password prompt: the
    // cancel button and Esc do nothing.
    in property <bool> cancel-enabled: true;
    in property <bool> destructive;
    // Icon in the error colour.
    in property <bool> alarm: destructive;
    // Optional left-aligned action, such as "Export…".
    in property <string> extra-text;
    in property <image> extra-icon;
    // "Copy diagnostics" beside the left action, for an error.
    in property <bool> diagnostics;
    // The left action loses data, such as "Discard and close": the red fill.
    in property <bool> extra-destructive;
    // Where the card sits, for the pixel-alignment test.
    out property <length> card-x: card.x;
    out property <length> card-y: card.y;
    callback accepted;
    callback cancelled;
    callback extra;
    property <bool> has-footer: diagnostics || extra-text != "" || cancel-text != "" || accept-text != "";
    background: Theme.scrim;
    accessible-role: groupbox;
    accessible-label: title;

    // Swallow clicks on the scrim.
    TouchArea { }

    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                if (root.cancel-enabled) {
                    root.cancelled();
                }
                return accept;
            }
            reject
        }
    }
    init => { fs.focus(); }

    card := Rectangle {
        width: root.card-width;
        // Centred on whole physical pixels: a fractional offset blurs the text.
        x: round((root.width - self.width) / 2 / 1phx) * 1phx;
        y: round((root.height - self.height) / 2 / 1phx) * 1phx;
        // The middle scrolls when the card would not fit, so the footer stays on screen.
        height: min(body.preferred-height, root.height - 48px);
        background: Theme.window;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: Theme.radius-frame;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: Theme.shadow;
        clip: true;

        body := VerticalLayout {
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 16px;
                padding-bottom: 6px;
                spacing: 12px;
                if root.icon.width > 0: Image {
                    source: root.icon;
                    colorize: root.alarm ? Theme.negative : Theme.fg-muted;
                    width: 32px;
                    height: 32px;
                    y: 0;
                }
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.title;
                        font-size: Theme.text-title;
                        font-weight: 600;
                        color: Theme.fg;
                        wrap: word-wrap;
                    }
                    if root.subtitle != "": Text {
                        text: root.subtitle;
                        color: Theme.fg-muted;
                        wrap: word-wrap;
                    }
                }
            }
            ScrollView {
                // The widget's 50px floor would leave a band when there are no body rows.
                min-height: 0px;
                preferred-height: middle.preferred-height;
                middle := VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 10px;
                    padding-bottom: 14px;
                    spacing: 10px;
                    @children
                }
            }
            if root.has-footer: Rectangle {
                height: 1px;
                background: Theme.line-soft;
            }
            if root.has-footer: Rectangle {
                background: Theme.header;
                HorizontalLayout {
                    padding: 12px;
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 8px;
                    if root.extra-text != "": Button {
                        text: root.extra-text;
                        icon: root.extra-icon;
                        destructive: root.extra-destructive;
                        clicked => { root.extra(); }
                    }
                    if root.diagnostics: CopyDiagnostics { }
                    Rectangle { horizontal-stretch: 1; }
                    if root.cancel-text != "": Button {
                        text: root.cancel-text;
                        enabled: root.cancel-enabled;
                        clicked => { root.cancelled(); }
                    }
                    if root.accept-text != "": Button {
                        text: root.accept-text;
                        enabled: root.accept-enabled;
                        primary: !root.destructive;
                        destructive: root.destructive;
                        clicked => { root.accepted(); }
                    }
                }
            }
        }
    }
}

// Two knobs on one groove: a low and a high end. Left and Right move the low end,
// with Shift the high end. Each callback names the knob that moved.
export component RangeSlider {
    in-out property <float> low;
    in-out property <float> high: 100;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <string> accessible-name;
    callback low-changed(float);
    callback high-changed(float);
    min-height: 22px;
    max-height: 22px;
    min-width: 120px;
    accessible-role: slider;
    accessible-label: accessible-name;
    accessible-value: round(low) + " to " + round(high);
    forward-focus: fs;
    property <length> knob: 18px;
    property <length> span: self.width - knob;

    function at(v: float) -> length {
        (v - minimum) / (maximum - minimum) * span
    }
    function set-low(v: float) {
        low = clamp(round(v), minimum, high);
        low-changed(low);
    }
    function set-high(v: float) {
        high = clamp(round(v), low, maximum);
        high-changed(high);
    }
    // Moves the knob nearer to the pointer.
    function drag(x: length) {
        let v = minimum + (x - knob / 2) / span * (maximum - minimum);
        if (abs(v - low) < abs(v - high)) {
            set-low(v);
        } else {
            set-high(v);
        }
    }

    fs := FocusScope {
        key-pressed(e) => {
            let d = e.text == Key.LeftArrow ? -1 : e.text == Key.RightArrow ? 1 : 0;
            if (d == 0) {
                return reject;
            }
            if (e.modifiers.shift) {
                root.set-high(root.high + d);
            } else {
                root.set-low(root.low + d);
            }
            accept
        }
    }
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.line;
    }
    Rectangle {
        x: root.knob / 2 + root.at(root.low);
        y: (parent.height - 4px) / 2;
        width: root.at(root.high) - root.at(root.low);
        height: 4px;
        background: Theme.accent;
    }
    for v[i] in [root.low, root.high]: Rectangle {
        x: root.at(v);
        y: (parent.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: Theme.button;
        border-width: 1px;
        border-color: fs.has-focus ? Theme.accent : Theme.line;
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.shadow;
    }
    TouchArea {
        // ponytail: drag moves the nearer knob, no hand-off when knobs meet.
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                fs.focus();
                root.drag(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.drag(self.mouse-x);
            }
        }
    }
}
