// The device header and every slot of every mode.
import { Theme, Button, ScrollView } from "look/breeze/widgets.slint";
import { Icons, Dot } from "parts.slint";
import { ModeGroup, Slot } from "types.slint";

component SlotRow inherits Rectangle {
    in property <Slot> slot;
    in property <bool> current;
    callback picked;
    height: 36px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: current ? Theme.accent : transparent;
    background: current ? Theme.accent-wash : ta.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: "Slot " + slot.number + ", " + (slot.empty ? "empty" : slot.name);
    accessible-item-selected: current;
    accessible-action-default => { picked(); }

    fs := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                root.picked();
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
            width: 22px;
            height: 22px;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.line;
            Text {
                width: 100%;
                height: 100%;
                text: root.slot.number;
                font-size: Theme.text-small;
                color: Theme.fg-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.slot.empty ? "Empty" : root.slot.name;
            color: root.slot.empty ? Theme.fg-muted : Theme.fg;
            font-italic: root.slot.empty;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.slot.macros > 0: Text {
            text: root.slot.macros == 1 ? "1 macro" : root.slot.macros + " macros";
            font-size: Theme.text-small;
            color: Theme.fg-muted;
            vertical-alignment: center;
        }
        if root.slot.unsaved: Dot {
            y: (parent.height - self.height) / 2;
        }
    }
    ta := TouchArea {
        clicked => { root.picked(); }
    }
    // Keyboard focus: the Breeze accent frame, also visible on the current row.
    if fs.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: Theme.radius + 2px;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// The controller name in the header. With two or more controllers it opens a list
// to pick one.
component ControllerPicker inherits Rectangle {
    in property <[string]> model;
    in property <int> current;
    callback picked(int);
    property <bool> many: model.length > 1;
    border-radius: Theme.radius;
    background: many && ta.has-hover ? Theme.hover : transparent;
    accessible-role: combobox;
    accessible-label: "Controller";
    accessible-value: model[current];
    forward-focus: fs;

    fs := FocusScope {
        enabled: root.many;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                popup.show();
                return accept;
            }
            reject
        }
    }
    HorizontalLayout {
        spacing: 4px;
        Text {
            text: root.model[root.current];
            font-weight: 600;
            color: Theme.fg;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.many: Image {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            source: @image-url("icons/chevron.svg");
            colorize: Theme.fg-muted;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        enabled: root.many;
        clicked => {
            fs.focus();
            popup.show();
        }
    }
    if fs.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: Theme.radius + 2px;
        border-width: 2px;
        border-color: Theme.accent;
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: max(root.width, 200px);
        Rectangle {
            background: Theme.view;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.shadow;
        }
        VerticalLayout {
            padding: 4px;
            for item[i] in root.model: Rectangle {
                height: 26px;
                border-radius: 3px;
                background: i == root.current ? Theme.accent-wash : item-ta.has-hover ? Theme.hover : transparent;
                Text {
                    x: 8px;
                    text: item;
                    color: Theme.fg;
                    vertical-alignment: center;
                }
                item-ta := TouchArea {
                    clicked => { root.picked(i); }
                }
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[ModeGroup]> groups;
    // Every listed controller, and the one shown.
    in property <[string]> controllers;
    in property <int> current-controller;
    in property <string> device-status;
    in property <bool> connected;
    // The last read failed: the dot turns red.
    in property <bool> failed;
    in-out property <int> current-mode;
    in-out property <int> current-slot;
    callback slot-picked(int, int);
    callback controller-picked(int);
    width: 264px;
    background: Theme.view;

    VerticalLayout {
        Rectangle {
            height: 52px;
            background: Theme.header;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                Image {
                    source: Icons.pad;
                    colorize: Theme.fg;
                    width: 28px;
                    height: 28px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    ControllerPicker {
                        model: root.controllers;
                        current: root.current-controller;
                        picked(i) => { root.controller-picked(i); }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            y: (parent.height - 7px) / 2;
                            border-radius: 3.5px;
                            background: root.failed ? Theme.negative : root.connected ? Theme.positive : Theme.fg-muted;
                        }
                        Text {
                            text: root.device-status;
                            font-size: Theme.text-caption;
                            color: Theme.fg-muted;
                            overflow: elide;
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line-soft;
            }
        }

        ScrollView {
            VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                alignment: start;
                for g[gi] in root.groups: VerticalLayout {
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 4px;
                        spacing: 8px;
                        Text {
                            text: g.name;
                            font-weight: 600;
                            font-size: Theme.text-caption;
                            color: Theme.fg-muted;
                        }
                        if g.current: Text {
                            text: "Current mode";
                            font-size: Theme.text-caption;
                            color: Theme.fg-muted;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    for s[si] in g.slots: HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-bottom: 2px;
                        SlotRow {
                            slot: s;
                            current: gi == root.current-mode && si == root.current-slot;
                            picked => { root.slot-picked(gi, si); }
                        }
                    }
                }
            }
        }
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.line-soft;
    }
}
