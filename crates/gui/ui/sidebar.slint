// The device header and every slot of every mode.
import { Theme, Button, ScrollView } from "look/breeze/widgets.slint";
import { Icons, Dot } from "parts.slint";
import { ModeGroup, Slot } from "types.slint";

component SlotRow inherits Rectangle {
    in property <Slot> slot;
    in property <bool> current;
    callback picked;
    height: 36px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: current ? Theme.accent : transparent;
    background: current ? Theme.accent-wash : ta.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: "Slot " + slot.number + ", " + (slot.empty ? "empty" : slot.name);
    accessible-item-selected: current;
    accessible-action-default => { picked(); }

    fs := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                root.picked();
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
            width: 22px;
            height: 22px;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.line;
            Text {
                width: 100%;
                height: 100%;
                text: root.slot.number;
                font-size: Theme.text-small;
                color: Theme.fg-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.slot.empty ? "Empty" : root.slot.name;
            color: root.slot.empty ? Theme.fg-muted : Theme.fg;
            font-italic: root.slot.empty;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.slot.macros > 0: Text {
            text: root.slot.macros == 1 ? "1 macro" : root.slot.macros + " macros";
            font-size: Theme.text-small;
            color: Theme.fg-muted;
            vertical-alignment: center;
        }
        if root.slot.unsaved: Dot {
            y: (parent.height - self.height) / 2;
        }
    }
    ta := TouchArea {
        clicked => { root.picked(); }
    }
    // Keyboard focus: the Breeze accent frame, also visible on the current row.
    if fs.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: Theme.radius + 2px;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

export component Sidebar inherits Rectangle {
    in property <[ModeGroup]> groups;
    in property <string> device-name;
    in property <string> device-status;
    in property <bool> connected;
    in-out property <int> current-mode;
    in-out property <int> current-slot;
    callback slot-picked(int, int);
    callback about;
    width: 264px;
    background: Theme.view;

    VerticalLayout {
        Rectangle {
            height: 52px;
            background: Theme.header;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                Image {
                    source: Icons.pad;
                    colorize: Theme.fg;
                    width: 28px;
                    height: 28px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: root.device-name;
                        font-weight: 600;
                        color: Theme.fg;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            y: (parent.height - 7px) / 2;
                            border-radius: 3.5px;
                            background: root.connected ? Theme.positive : Theme.fg-muted;
                        }
                        Text {
                            text: root.device-status;
                            font-size: Theme.text-caption;
                            color: Theme.fg-muted;
                            overflow: elide;
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line-soft;
            }
        }

        ScrollView {
            VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                alignment: start;
                for g[gi] in root.groups: VerticalLayout {
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 4px;
                        spacing: 8px;
                        Text {
                            text: g.name;
                            font-weight: 600;
                            font-size: Theme.text-caption;
                            color: Theme.fg-muted;
                        }
                        if g.current: Text {
                            text: "Current mode";
                            font-size: Theme.text-caption;
                            color: Theme.fg-muted;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    for s[si] in g.slots: HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-bottom: 2px;
                        SlotRow {
                            slot: s;
                            current: gi == root.current-mode && si == root.current-slot;
                            picked => { root.slot-picked(gi, si); }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line-soft;
        }
        HorizontalLayout {
            padding: 6px;
            alignment: start;
            Button {
                text: "About 8B";
                icon: Icons.info;
                flat: true;
                clicked => { root.about(); }
            }
        }
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.line-soft;
    }
}
