{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8bspec.local/schema/macro-v1.schema.json",
  "title": "8BitDo Pro 3 Macro v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "device",
    "mode",
    "repeat",
    "steps"
  ],
  "oneOf": [
    { "required": ["trigger_buttons"] },
    { "required": ["trigger"] }
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "device": {
      "type": "string",
      "const": "8bitdo-pro3"
    },
    "mode": {
      "type": "string",
      "enum": ["xinput", "switch", "dinput"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "trigger_buttons": {
      "description": "The buttons that start the macro. Empty when no button starts it.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/MacroTrigger"
      }
    },
    "trigger": {
      "description": "The single trigger button of a v0.1.1 file. Read as a one-button trigger_buttons; never written.",
      "$ref": "#/$defs/MacroTrigger"
    },
    "repeat": {
      "$ref": "#/$defs/Repeat"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Step"
      }
    }
  },
  "$defs": {
    "MacroTrigger": {
      "description": "A button id whose can_start_macro flag is set in the controller description. The app narrows this to those ids before it validates; the schema file alone accepts any name.",
      "type": "string",
      "minLength": 1
    },
    "StepButton": {
      "description": "A button id whose can_be_in_macro_step flag is set in the controller description. The app narrows this to those ids before it validates; the schema file alone accepts any name.",
      "type": "string",
      "minLength": 1
    },
    "Repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "interval_ms"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "actions"],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "actions": {
          "$ref": "#/$defs/Actions"
        },
        "glide": {
          "description": "The controls that move in a straight line from this step's value to the next step's value. Writing a macro turns the step into short steps.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["left_stick", "right_stick", "left_trigger", "right_trigger"]
          }
        }
      }
    },
    "Actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buttons": {
          "$ref": "#/$defs/Buttons"
        },
        "left_stick": {
          "$ref": "#/$defs/StickPosition"
        },
        "right_stick": {
          "$ref": "#/$defs/StickPosition"
        },
        "triggers": {
          "$ref": "#/$defs/TriggerValues"
        }
      }
    },
    "Buttons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "press": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepButton"
          },
          "uniqueItems": true
        },
        "release": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepButton"
          },
          "uniqueItems": true
        }
      }
    },
    "StickPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 127
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 127
        }
      }
    },
    "TriggerValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 0
        },
        "right": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 0
        }
      }
    }
  }
}
